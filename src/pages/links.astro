---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import CopyButton from "../components/CopyButton.astro";
import FilterTabs from "../components/control/FilterTabs.astro";
import PageHeader from "../components/control/PageHeader.astro";
---

<MainGridLayout
  title="${linksTitle + ' - ' + site.title}"
  description="#{page.links.description(${site.title})}"
>
  <Fragment slot="head">
    <!-- 页面标题由 Layout.astro 统一输出；此处仅保留页面特有 head 内容 -->
    <style is:global>
      /* 随机访问按钮：点击后图标匀速旋转 */
      .random-visit-btn.spinning .random-visit-icon {
        animation: random-visit-spin 1s linear infinite;
      }
      @keyframes random-visit-spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }
      .collapse-icon.is-expanded {
        transform: rotate(180deg);
      }
      .collapse-inner ul,
      .step-desc ul {
        list-style: disc;
        padding-left: 1.25rem;
      }
      .collapse-inner ol,
      .step-desc ol {
        list-style: decimal;
        padding-left: 1.25rem;
      }
      .collapse-inner a,
      .step-desc a {
        color: var(--primary);
        text-decoration: underline;
      }
    </style>
  </Fragment>

  <section class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
    <PageHeader
      containerClass="mb-6 flex flex-col items-start gap-3 md:flex-row md:items-end md:justify-between"
      titleExpr="${linksTitle}"
      title="友情链接"
      iconClass="icon-[material-symbols--diversity-3-rounded]"
      labelExpr="#{page.links.subtitle}"
      label="朋友们"
      subExpr="#{page.links.subtitleCount(${#aggregates.sum(groups.![links.size()])})}"
      subShowIfExpr="${groups != null and not #lists.isEmpty(groups)}"
      sub="0 个链接"
      filteredExpr="${not #lists.isEmpty(param.group)}"
    >
      <button
        th:if="${theme.config?.links?.features?.enable_random_visit != false && not #lists.isEmpty(groups)}"
        type="button"
        id="random-visit-btn"
        th:attr="data-random-groups=${theme.config?.links?.features?.random_visit_groups}"
        class="random-visit-btn btn-regular group h-11 w-fit rounded-xl px-4 text-sm font-bold active:scale-95"
        title="随机访问一个友链"
        th:title="#{page.links.randomVisitTitle}"
        slot="right"
      >
        <span
          class="random-visit-icon icon-[material-symbols--shuffle-rounded] mr-1.5 text-base transition-transform group-hover:scale-110"
        ></span>
        <span class="random-visit-label" th:text="#{page.links.randomVisit}"
          >随机访问</span
        >
      </button>
    </PageHeader>

    <FilterTabs
      showIfExpr="${not #lists.isEmpty(groups)}"
      allHrefExpr="@{/links}"
      allActiveExpr="#lists.isEmpty(param.group)"
      eachExpr="group : ${groups}"
      tabTemplate={{
        hrefExpr: "@{/links(group=${group.spec.displayName})}",
        activeExpr: "#lists.contains(param.group, group.spec.displayName)",
        labelExpr: "${group.spec.displayName}",
        countExpr: "${#lists.size(group.links)}",
        showIfExpr: "${not #lists.isEmpty(group.links)}",
      }}
    />

    <div th:if="${not #lists.isEmpty(groups)}" class="space-y-8">
      <section
        th:each="group, groupStat : ${groups}"
        th:if="${(#lists.isEmpty(param.group) or #lists.contains(param.group, group.spec.displayName)) and not #lists.isEmpty(group.links)}"
        th:style="|animation-delay: min(calc(var(--content-delay) + ${groupStat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
        class="onload-animation"
      >
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="text-xl font-bold text-90">
            <span th:text="${group.spec.displayName}">Group</span>
          </h2>
          <span
            class="rounded-lg bg-(--btn-regular-bg) px-2.5 py-1 text-xs font-bold text-(--btn-content)"
            th:text="${#lists.size(group.links)}">0</span
          >
        </div>
        <div
          class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(min(220px,100%),1fr))]"
        >
          <a
            th:each="link, linkStat : ${group.links}"
            th:href="${link.spec.url != null and (link.spec.url.startsWith('http') or link.spec.url.startsWith('//') or link.spec.url.startsWith('/')) ? link.spec.url : null}"
            th:title="${link.spec.displayName}"
            th:attr="data-link-group=${group.spec.displayName}"
            th:style="|animation-delay: min(calc(var(--content-delay) + ${groupStat.index * 4 + linkStat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-card btn-card-outline group min-h-28 items-start! justify-start! gap-4 rounded-xl p-4 text-left active:scale-95 onload-animation card-hover-lift"
          >
            <img
              alt=""
              th:if="${not #strings.isEmpty(link.spec.logo)}"
              th:src="${link.spec.logo != null and (link.spec.logo.startsWith('http') or link.spec.logo.startsWith('//') or link.spec.logo.startsWith('/')) ? link.spec.logo : null}"
              th:alt="${link.spec.displayName}"
              loading="lazy"
              class="h-12 w-12 shrink-0 rounded-xl bg-(--btn-regular-bg) object-cover transition group-hover:scale-105"
            />
            <div
              th:unless="${not #strings.isEmpty(link.spec.logo)}"
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-(--btn-regular-bg) text-(--primary)"
            >
              <span class="icon-[material-symbols--link-rounded] text-2xl"
              ></span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start gap-2">
                <div
                  class="min-w-0 flex-1 truncate text-base font-bold text-90 transition group-hover:text-(--primary)"
                  th:text="${link.spec.displayName}"
                >
                  Link
                </div><span
                  class="icon-[fa6-solid--arrow-up-right-from-square] mt-0.5 shrink-0 text-sm text-30 transition group-hover:text-(--primary)"
                ></span>
              </div>
              <div
                th:if="${not #strings.isEmpty(link.spec.description)}"
                class="mt-1 line-clamp-2 text-sm leading-6 text-50"
                th:text="${link.spec.description}"
              >
                Description
              </div>
              <div
                class="mt-2 truncate text-xs font-medium text-30"
                th:text="${link.spec.url}"
              >
                https://example.com
              </div>
            </div>
          </a>
        </div>
      </section>
    </div>

    <div th:if="${#lists.isEmpty(groups)}" class="py-12 text-center text-50">
      <span th:text="#{page.links.noLinks}">暂无友情链接</span>
    </div>
  </section>

  <!-- 我的博客信息 + 申请友链 + 折叠面板 -->
  <div class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
    <div class="mb-5 grid grid-cols-1 gap-4 lg:grid-cols-2">
      <!-- 左卡片：我的博客信息 -->
      <div
        class="rounded-xl border p-4"
        style="border-color: color-mix(in oklab, var(--primary) 18%, transparent)"
      >
        <div class="flex items-center gap-3">
          <img
            th:if="${not #strings.isEmpty(theme.config?.links?.ownerInfo.owner_avatar)}"
            th:src="${theme.config?.links?.ownerInfo.owner_avatar}"
            th:alt="${theme.config?.links?.ownerInfo.owner_name}"
            class="h-14 w-14 shrink-0 rounded-xl object-cover"
          />
          <div
            th:unless="${not #strings.isEmpty(theme.config?.links?.ownerInfo.owner_avatar)}"
            class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-(--btn-regular-bg) text-(--primary)"
          >
            <span class="icon-[material-symbols--link-rounded] text-2xl"></span>
          </div>
          <div class="min-w-0 flex-1">
            <h3
              class="text-base font-bold text-90"
              th:text="${theme.config?.links?.ownerInfo.owner_name}"
            >
              博客名称
            </h3>
            <p
              class="mt-0.5 line-clamp-2 text-[13px] text-50"
              th:text="${theme.config?.links?.ownerInfo.owner_description}"
            >
              博客描述
            </p>
          </div>
        </div>
        <div class="mt-4 space-y-1.5">
          <div
            class="flex items-center justify-between gap-2 rounded-lg bg-(--btn-regular-bg) p-2"
          >
            <div class="min-w-0 flex-1">
              <div class="text-[11px] text-50">
                <span th:text="#{page.links.ownerSiteName}">站点名称</span>
              </div><div
                class="truncate text-[13px] text-90"
                th:text="${theme.config?.links?.ownerInfo.owner_name}"
              >
                博客名称
              </div>
            </div><CopyButton
              copyText="${theme.config?.links?.ownerInfo.owner_name}"
            />
          </div>
          <div
            class="flex items-center justify-between gap-2 rounded-lg bg-(--btn-regular-bg) p-2"
          >
            <div class="min-w-0 flex-1">
              <div class="text-[11px] text-50">
                <span th:text="#{page.links.ownerSiteDescription}"
                  >站点描述</span
                >
              </div><div
                class="line-clamp-2 text-[13px] text-90"
                th:text="${theme.config?.links?.ownerInfo.owner_description}"
              >
                博客描述
              </div>
            </div><CopyButton
              copyText="${theme.config?.links?.ownerInfo.owner_description}"
            />
          </div>
          <div
            class="flex items-center justify-between gap-2 rounded-lg bg-(--btn-regular-bg) p-2"
          >
            <div class="min-w-0 flex-1">
              <div class="text-[11px] text-50">
                <span th:text="#{page.links.ownerSiteUrl}">站点链接</span>
              </div><div
                class="truncate text-[13px] text-90"
                th:text="${theme.config?.links?.ownerInfo.owner_url}"
              >
                https://example.com
              </div>
            </div><CopyButton
              copyText="${theme.config?.links?.ownerInfo.owner_url}"
            />
          </div>
          <div
            class="flex items-center justify-between gap-2 rounded-lg bg-(--btn-regular-bg) p-2"
          >
            <div class="min-w-0 flex-1">
              <div class="text-[11px] text-50">
                <span th:text="#{page.links.ownerAvatarUrl}">头像链接</span>
              </div><div
                class="truncate text-[13px] text-90"
                th:text="${theme.config?.links?.ownerInfo.owner_avatar}"
              >
                https://example.com/avatar.jpg
              </div>
            </div><CopyButton
              copyText="${theme.config?.links?.ownerInfo.owner_avatar}"
            />
          </div>
          <div
            class="flex items-center justify-between gap-2 rounded-lg bg-(--btn-regular-bg) p-2"
          >
            <div class="min-w-0 flex-1">
              <div class="text-[11px] text-50">
                <span th:text="#{page.links.ownerRss}">RSS 地址</span>
              </div><div
                class="truncate text-[13px] text-90"
                th:text="${theme.config?.links?.ownerInfo.owner_rss}"
              >
                /rss.xml
              </div>
            </div><CopyButton
              copyText="${theme.config?.links?.ownerInfo.owner_rss}"
            />
          </div>
        </div>
      </div>

      <!-- 右卡片：申请友链流程 -->
      <div
        th:remove="tag"
        th:with="applySteps=${theme.config?.links?.['applyFlow']?.applySteps}"
      >
        <div
          class="flex flex-col rounded-xl border p-4 pb-3"
          style="border-color: color-mix(in oklab, var(--primary) 18%, transparent)"
        >
          <h3
            class="mb-4 mt-1 flex items-center gap-2 text-base font-bold text-90"
          >
            <span class="meta-icon">
              <span
                class="icon-[material-symbols--fact-check-outline-rounded] text-xl"
              ></span>
            </span>
            <span th:text="#{page.links.applyTitle}">申请友链</span>
          </h3>
          <div
            th:if="${applySteps != null and not #lists.isEmpty(applySteps)}"
            class="space-y-5"
          >
            <div
              th:each="step, stepStat : ${applySteps}"
              class="relative flex items-start gap-3"
            >
              <div
                class="relative z-10 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-(--primary) text-xs font-bold text-white"
                th:text="${stepStat.index + 1}"
              >
                1
              </div>
              <div
                th:unless="${stepStat.last}"
                class="absolute left-[11px] top-7 bottom-[-1rem] w-0.5 bg-black/10 dark:bg-white/10"
              >
              </div>
              <div class="min-w-0 flex-1">
                <h4
                  class="text-[13px] font-medium text-90"
                  th:text="${step.title}"
                >
                  步骤标题
                </h4><div
                  class="step-desc mt-0.5 text-xs text-50"
                  th:utext="${step.desc}"
                >
                  步骤说明
                </div>
              </div>
            </div>
          </div>
          <!-- 默认申请流程（新安装未保存设置时显示） -->
          <div
            th:if="${applySteps == null or #lists.isEmpty(applySteps)}"
            class="space-y-5"
          >
            <div class="relative flex items-start gap-3">
              <div
                class="relative z-10 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-(--primary) text-xs font-bold text-white"
              >
                1
              </div>
              <div
                class="absolute left-[11px] top-7 bottom-[-1rem] w-0.5 bg-black/10 dark:bg-white/10"
              >
              </div>
              <div class="min-w-0 flex-1">
                <h4 class="text-[13px] font-medium text-90">添加本站友链</h4>
                <div class="step-desc mt-0.5 text-xs text-50">
                  请先在您的网站友链页面<strong>添加本站信息</strong
                  >，可直接复制左侧各字段
                </div>
              </div>
            </div>
            <div class="relative flex items-start gap-3">
              <div
                class="relative z-10 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-(--primary) text-xs font-bold text-white"
              >
                2
              </div>
              <div
                class="absolute left-[11px] top-7 bottom-[-1rem] w-0.5 bg-black/10 dark:bg-white/10"
              >
              </div>
              <div class="min-w-0 flex-1">
                <h4 class="text-[13px] font-medium text-90">评论留言</h4>
                <div class="step-desc mt-0.5 text-xs text-50">
                  在本页下方评论区留言提交申请
                </div>
              </div>
            </div>
            <div class="relative flex items-start gap-3">
              <div
                class="relative z-10 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-(--primary) text-xs font-bold text-white"
              >
                3
              </div>
              <div class="min-w-0 flex-1">
                <h4 class="text-[13px] font-medium text-90">等待审核</h4>
                <div class="step-desc mt-0.5 text-xs text-50">
                  确认信息无误后会尽快添加您的友链
                </div>
              </div>
            </div>
          </div>

          <!-- 申请友链按钮：步骤下方空白区域垂直居中，左右居中，上下间距一致。
               显示需同时满足：主题开关开启 且 插件申请功能可用（linkApplicationEnabled 为 true） -->
          <div
            th:if="${theme.config?.links?.features?.enable_apply_btn != false and linkApplicationEnabled == true}"
            class="mt-3 flex flex-1 items-center justify-center"
          >
            <button
              type="button"
              id="link-apply-btn"
              class="btn-regular group h-11 rounded-xl px-5 text-sm font-bold active:scale-95"
            >
              <span
                class="icon-[material-symbols--rocket-launch-rounded] mr-1.5 text-base transition-transform group-hover:scale-110"
              ></span>
              <span th:text="#{page.links.applyButton}">申请友链</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 折叠面板 -->
    <div
      th:remove="tag"
      th:with="accs=${theme.config?.links?.['accordionPanel']?.accordions}"
    >
      <div
        th:if="${accs != null and not #lists.isEmpty(accs)}"
        class="space-y-2"
        id="links-accordion"
      >
        <div
          th:each="item, itemStat : ${accs}"
          class="collapse-item rounded-xl bg-(--btn-regular-bg)"
        >
          <button
            type="button"
            class="collapse-header flex w-full items-center justify-between p-3 text-left transition"
            th:attr="data-collapse-target='accordion-'+${itemStat.index}"
          >
            <div class="flex items-center gap-2">
              <span
                class="text-lg text-(--primary)"
                th:if="${item.icon != null && item.icon.value != null}"
                th:utext="${item.icon.value}"></span><span
                class="text-sm font-medium text-90"
                th:text="${item.title}">面板标题</span
              >
            </div>
            <span
              class="collapse-icon icon-[material-symbols--expand-more-rounded] text-lg text-50 transition-transform duration-200"
            ></span>
          </button>
          <div
            th:attr="id='accordion-'+${itemStat.index}"
            class="collapse-content"
          >
            <div class="collapse-inner px-3 pb-3">
              <div
                class="text-sm text-50 leading-relaxed"
                th:utext="${item.content}"
              >
                正文
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- 默认折叠面板（新安装未保存设置时显示） -->
      <div
        th:if="${accs == null or #lists.isEmpty(accs)}"
        class="space-y-2"
        id="links-accordion"
      >
        <div class="collapse-item rounded-xl bg-(--btn-regular-bg)">
          <button
            type="button"
            class="collapse-header flex w-full items-center justify-between p-3 text-left transition"
            data-collapse-target="accordion-0"
          >
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-90">友链须知</span>
            </div>
            <span
              class="collapse-icon icon-[material-symbols--expand-more-rounded] text-lg text-50 transition-transform duration-200"
            ></span>
          </button>
          <div id="accordion-0" class="collapse-content">
            <div class="collapse-inner px-3 pb-3">
              <div class="text-sm text-50 leading-relaxed">
                <ul>
                  <li>请先在您的网站添加本站信息</li><li>
                    网站能够正常访问，使用HTTPS
                  </li><li>网站符合中国大陆法律法规</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <div class="collapse-item rounded-xl bg-(--btn-regular-bg)">
          <button
            type="button"
            class="collapse-header flex w-full items-center justify-between p-3 text-left transition"
            data-collapse-target="accordion-1"
          >
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-90">免责申明</span>
            </div>
            <span
              class="collapse-icon icon-[material-symbols--expand-more-rounded] text-lg text-50 transition-transform duration-200"
            ></span>
          </button>
          <div id="accordion-1" class="collapse-content">
            <div class="collapse-inner px-3 pb-3">
              <div class="text-sm text-50 leading-relaxed">
                <ul>
                  <li>
                    本博客严格遵守中华人民共和国法律法规，友情链接及其他外链，仅为了方便学习与交流而收集整理
                  </li><li>
                    本人能力有限，无法逐一甄别每篇文章的全部内容，也无法实时跟进并确认原作者后续是否对链接内容进行篡改，包括但不限于发布违法信息、植入恶意代码、诱导点击或破坏用户计算机等行为
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 友链页脚本（I27）：由 requirements/collapse/copy/link-apply/random-visit 五个脚本
       合并为单请求；link-apply 与 random-visit 的原 th:if 门控改由脚本内部守卫
       （按钮/模态框不存在即不绑定，行为等价，见 links.bundle.js 各 IIFE 注释） -->
  <script
    src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/links.bundle.js?v=${ASSET_VERSION}`}
    defer></script>

  <!-- 申请友链模态框 -->
  <div
    id="link-apply-modal"
    class="link-apply-modal"
    aria-hidden="true"
    th:if="${theme.config?.links?.features?.enable_apply_btn != false and linkApplicationEnabled == true}"
  >
    <div id="link-apply-backdrop" class="link-apply-backdrop"></div>
    <div
      id="link-apply-card"
      class="link-apply-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="link-apply-title"
    >
      <div class="link-apply-header">
        <h3
          id="link-apply-title"
          class="link-apply-title"
          th:text="#{page.links.applyTitle}"
        >
          申请友链
        </h3>
        <span class="link-apply-title-divider"></span>
        <button
          type="button"
          id="link-apply-close"
          class="link-apply-close"
          aria-label="关闭"
          title="关闭"
          th:aria-label="#{page.links.applyClose}"
          th:title="#{page.links.applyClose}"
        >
          <span
            class="icon-[material-symbols--close-rounded] text-xl leading-none"
          ></span>
        </button>
      </div>
      <form id="link-apply-form" class="link-apply-form" novalidate>
        <div class="link-apply-body">
          <!-- 第一行：网站地址 | 网站名称 -->
          <label class="link-apply-field">
            <span class="link-apply-label"
              ><span th:text="#{page.links.applyWebsite}">网站地址</span><em
                >*</em
              ></span
            >
            <input
              type="url"
              name="url"
              required
              autocomplete="off"
              spellcheck="false"
              placeholder="https://example.com"
            />
          </label>
          <label class="link-apply-field">
            <span class="link-apply-label"
              ><span th:text="#{page.links.applyName}">网站名称</span><em>*</em
              ></span
            >
            <input
              type="text"
              name="displayName"
              required
              autocomplete="off"
              spellcheck="false"
              placeholder="您的网站名称"
              th:placeholder="#{page.links.applyNamePlaceholder}"
            />
          </label>
          <!-- 第二行：网站 Logo | 反链地址 -->
          <label class="link-apply-field">
            <span class="link-apply-label"
              ><span th:text="#{page.links.applyLogo}">网站 Logo</span></span
            >
            <input
              type="url"
              name="logo"
              autocomplete="off"
              spellcheck="false"
              placeholder="https://example.com/avatar.png"
            />
          </label>
          <label class="link-apply-field">
            <span class="link-apply-label"
              ><span th:text="#{page.links.applyBacklink}">反链地址</span></span
            >
            <input
              type="url"
              name="backlink"
              autocomplete="off"
              spellcheck="false"
              placeholder="https://example.com/friends"
            />
          </label>
          <!-- 第三行：网站描述 | RSS 地址 -->
          <label class="link-apply-field">
            <span class="link-apply-label"
              ><span th:text="#{page.links.applyDescription}">网站描述</span
              ></span
            >
            <textarea
              name="description"
              rows="2"
              autocomplete="off"
              placeholder="一句话介绍您的网站"
              th:placeholder="#{page.links.applyDescriptionPlaceholder}"
            ></textarea>
          </label>
          <label class="link-apply-field">
            <span class="link-apply-label"
              ><span th:text="#{page.links.applyRss}">RSS 地址</span></span
            >
            <textarea
              name="feedUrls"
              rows="2"
              autocomplete="off"
              spellcheck="false"
              placeholder="每行一个 RSS/Atom 订阅地址"
              th:placeholder="#{page.links.applyRssPlaceholder}"></textarea>
          </label>
          <!-- 第四行：联系邮箱 | 验证码 -->
          <label class="link-apply-field">
            <span class="link-apply-label"
              ><span th:text="#{page.links.applyEmail}">联系邮箱</span></span
            >
            <input
              type="email"
              name="email"
              autocomplete="off"
              spellcheck="false"
              placeholder="you@example.com"
            />
          </label>
          <div class="link-apply-field">
            <span class="link-apply-label"
              ><span th:text="#{page.links.applyCaptcha}">验证码</span><em>*</em
              ></span
            >
            <div class="link-apply-captcha">
              <input
                type="text"
                name="captchaCode"
                id="link-apply-captcha-code"
                required
                maxlength="6"
                autocomplete="off"
                spellcheck="false"
                placeholder="输入图中字符"
                th:placeholder="#{page.links.applyCaptchaPlaceholder}"
              />
              <img
                id="link-apply-captcha-img"
                class="link-apply-captcha-img"
                alt="验证码"
                title="点击刷新验证码"
                th:alt="#{page.links.applyCaptcha}"
                th:title="#{page.links.applyRefreshCaptcha}"
              />
            </div>
          </div>
        </div>
        <div
          id="link-apply-message"
          class="link-apply-message"
          role="status"
          aria-live="polite"
        >
        </div>
        <div class="link-apply-footer">
          <button
            type="submit"
            id="link-apply-submit"
            class="link-apply-btn-submit"
          >
            <span class="icon-[material-symbols--send-rounded] text-base"
            ></span>
            <span
              class="link-apply-submit-text"
              th:text="#{page.links.applySubmit}">提交申请</span
            >
          </button>
        </div>
      </form>
    </div>
  </div>

  <div
    id="comment"
    th:if="${haloCommentEnabled && (theme.config?.links?.features.enable_comment == null || theme.config?.links?.features.enable_comment)}"
    class="card-base relative z-10 w-full px-6 pb-4 pt-6 md:px-9"
  >
    <h2
      class="mb-2 text-base font-medium text-gray-900 dark:text-slate-50"
      th:text="#{common.comment}"
    >
      评论
    </h2>
    <Fragment
      set:html={'<halo:comment group="plugin.halo.run" kind="Plugin" th:attr="name=${pluginName}" />'}
    />
  </div>
</MainGridLayout>
