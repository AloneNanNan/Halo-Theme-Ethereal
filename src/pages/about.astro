---
// 关于我页面模板（Halo 自定义页面，自定义模板选 about）。
// 数据来自主题设置「扩展页面 → 关于我页面」→ theme.config.extendPages.about。
//
// 布局：身份卡（横跨）→ 顶部导航（横跨）→ 两栏
//   主列：关于我 / 本人项目 / 更新摘要 / 最近的提交
//   侧列：技术轨迹 / 我的朋友 / 保持联系
//   （「我的朋友」位于技术轨迹下方，带头像卡片墙）
// 两栏按**容器宽度**分档（≥880px 才分栏），不跟视口走 —— 见 .about-cols-wrap。
// 多行字段（正文/标签/联系方式）由 extend-pages.js 在客户端渲染。
// 友链取自 Halo 友链插件的 groups（按需随机展示 N 个）。
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="${singlePage.spec.title + ' - ' + site.title}"
  description="#{page.about.description(${site.title})}"
>
  <Fragment slot="head">
    <style is:global>
      /* ==========================================================================
         「关于我」卡片体系 —— 逐条对齐参考站 rainzt.cn/about/
         参考站把卡级规则写在该页自己的样式表里（不在主题 .card-base）：
           · 外壳   1px 细边（主色 14% 混分隔线）+ 大范围极淡投影
           · 卡头   图标 1.08rem 主色 / 标题 1rem·780·-.015em / 尾标 .68rem
           · 内嵌项 1px 分隔线边 + 半径 .78rem + 底 = 95% card-bg 混 5% 主色
           · 可点内嵌项 hover：边 48% 主色 + 底 7% 主色 + 投影 + 上浮 2px
         本主题与参考站同名同值（--radius-large / --line-divider / --card-bg / --primary），
         数值可直接照搬；只补一个参考站有、本主题没有的 --content-meta。
         ========================================================================== */

      /* 卡片作用域内补齐参考站的「次要文字色」（rgba .7 / .6 的等价物） */
      .about-hero-card,
      .about-subnav,
      .about-col-main > section,
      .about-col-side > section,
      .about-footer-card {
        --content-meta: color-mix(in srgb, var(--deep-text) 68%, transparent);
      }

      /* ================= ① 卡级外壳 =================
         ⚠️ 这里刻意**不加边框、不加阴影**（2026-09-12 LQ 明确要求）：
         早前一度照参考站给这几张卡加了 1px 主色描边 + `box-shadow: 0 .7rem 1.8rem`，
         但 LQ 认为「外面包一圈」不符合本主题的设计语言 —— 卡片应当直接融进页面背景，
         只靠间距分隔，不加壳。改动前勿擅自补回（参考站有 ≠ 本主题要跟）。 */
      .about-hero-card,
      .about-col-main > section,
      .about-col-side > section,
      .about-footer-card {
        border: none;
        box-shadow: none;
      }

      /* ================= ② 页头：身份卡 =================
         卡面保持纯净：不加顶部柔光（早前的 ::after 渐隐高光已于 2026-09-12 移除）。 */
      .about-hero-card {
        position: relative;
        overflow: hidden;
        padding: clamp(1.1rem, 2.5vw, 1.65rem);
      }
      /* 头像 = 主色描边相框 + 内层留白 + 圆角图（对齐参考站 .profile-avatar） */
      .about-avatar {
        display: block;
        flex: none;
        width: 6.25rem;
        height: 6.25rem;
        padding: 0.22rem;
        border: 1px solid
          color-mix(in srgb, var(--primary) 32%, var(--line-divider));
        border-radius: 1.2rem;
        background: color-mix(in srgb, var(--primary) 8%, var(--card-bg));
        box-shadow: 0 0.55rem 1.2rem
          color-mix(in srgb, var(--primary) 12%, transparent);
      }
      .about-avatar__image {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: 0.95rem;
        background: var(--card-bg);
        object-fit: cover;
      }
      /* 姓名 / 身份 / 简介 / 状态：字号阶梯对齐参考站 */
      .about-name {
        margin: 0;
        font-size: clamp(1.7rem, 3.2vw, 2.35rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.1;
      }
      .about-roles {
        margin: 0.3rem 0 0;
        color: var(--content-meta);
        font-size: 0.9rem;
      }
      .about-tagline {
        max-width: 42rem;
        margin: 0.75rem 0 0;
        font-size: 0.97rem;
        line-height: 1.7;
      }
      .about-status {
        display: inline-flex;
        align-items: center;
        gap: 0.48rem;
        margin-top: 0.85rem;
        color: var(--content-meta);
        font-size: 0.76rem;
        font-family: inherit;
        line-height: 1.2;
      }
      .about-status .about-ico {
        width: 0.95rem;
        height: 0.95rem;
        color: var(--primary);
      }
      /* 绑定主题「在线状态」statusSettings 的胶囊形态（1.4.90）：
         与侧栏头像卡的状态徽章同源，点击同样弹出切换模态框（profile-status.ts）。
         胶囊描边/底色走 var(--primary) ⇒ 跟随主题色相与访客色相面板。 */
      .about-status-pill {
        gap: 0.5rem;
        padding: 0.34rem 0.85rem;
        appearance: none;
        border: 1px solid
          color-mix(in srgb, var(--primary) 22%, var(--line-divider));
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary) 7%, transparent);
        cursor: pointer;
        transition:
          color 0.18s,
          border-color 0.18s,
          background-color 0.18s,
          box-shadow 0.18s;
      }
      .about-status-pill:hover {
        border-color: color-mix(
          in srgb,
          var(--primary) 55%,
          var(--line-divider)
        );
        background: color-mix(in srgb, var(--primary) 11%, transparent);
        box-shadow: 0 0 0.6rem
          color-mix(in srgb, var(--primary) 16%, transparent);
      }
      .about-status-pill:active {
        transform: scale(0.97);
      }
      .about-status-item {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
      }
      .about-status-ico {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        flex: none;
      }
      .about-status-text {
        color: var(--content-meta);
        white-space: nowrap;
      }

      /* ================= ③ 页头按钮 =================
         刻意保持与「心愿墙」页 .wish-bar-btn 逐属性一致（早前明确要求），
         不跟参考站的 .profile-action 走。 */
      /* 2026-09-13：移动端改为**并排等宽两个**（原先纵向堆叠，LQ 要求对齐参考站）；
         ≥640px 仍回到纵向堆叠、与身份卡并排。
         只动容器布局 —— .about-btn 自身与「心愿墙」页 .wish-bar-btn 的逐属性一致保持不变。 */
      .about-hero-actions {
        display: flex;
        flex-direction: row;
        gap: 8px;
        width: 100%;
      }
      .about-hero-actions > .about-btn {
        flex: 1 1 0;
        min-width: 0;
      }
      @media (min-width: 640px) {
        .about-hero-actions {
          flex-direction: column;
          width: auto;
          min-width: 9.2rem;
          align-items: stretch;
        }
        .about-hero-actions > .about-btn {
          flex: 0 0 auto;
        }
      }
      .about-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        text-decoration: none;
        transition: all 0.25s ease;
      }
      .about-ico {
        width: 1.05em;
        height: 1.05em;
        flex-shrink: 0;
      }
      .about-ico--xs {
        width: 0.85em;
        height: 0.85em;
        opacity: 0.75;
      }
      .about-btn--primary {
        background: var(--primary);
        color: #fff;
        border: none;
        box-shadow: 0 2px 8px
          color-mix(in oklab, var(--primary) 40%, transparent);
      }
      :root.dark .about-btn--primary {
        color: rgb(0 0 0 / 0.7);
      }
      .about-btn--primary:hover {
        background: color-mix(in oklab, var(--primary) 85%, #000);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px
          color-mix(in oklab, var(--primary) 50%, transparent);
      }
      :root.dark .about-btn--primary:hover {
        background: color-mix(in oklab, var(--primary) 85%, #fff);
      }
      .about-btn--ghost {
        background: var(--btn-regular-bg);
        color: var(--btn-content);
        border: 1px solid var(--line-color);
      }
      .about-btn--ghost:hover {
        background: var(--btn-regular-bg-hover);
        color: var(--primary);
        border-color: color-mix(in oklab, var(--primary) 45%, transparent);
        transform: translateY(-1px);
      }

      /* ================= ④ 顶部导航（长条菜单）= 参考站 .profile-tabs ================= */
      .about-subnav {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        gap: 0.25rem;
        min-height: 3rem;
        overflow-x: auto;
        /* 与卡片一致：不加边框 / 阴影，只靠底色与下方 2px 主色下划线区分（2026-09-12 去壳） */
        border: none;
        border-radius: var(--radius-large);
        background: color-mix(in srgb, var(--card-bg) 94%, transparent);
        box-shadow: none;
        scrollbar-width: none;
      }
      .about-subnav::-webkit-scrollbar {
        display: none;
      }
      .about-subnav-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.42rem;
        min-width: max-content;
        padding: 0.78rem 0.9rem 0.68rem;
        border-bottom: 2px solid transparent;
        border-radius: 0.72rem 0.72rem 0 0;
        color: var(--content-meta);
        font-size: 0.8rem;
        font-weight: 680;
        line-height: 1.5;
        white-space: nowrap;
        text-decoration: none;
        transition:
          color 0.18s,
          border-color 0.18s,
          background-color 0.18s;
      }
      .about-subnav-item .about-ico {
        width: 1.12em;
        height: 1.12em;
        opacity: 0.9;
      }
      .about-subnav-item em {
        font-style: normal;
        min-width: 1.25rem;
        padding: 0.1rem 0.32rem;
        border-radius: 999px;
        background: var(--btn-regular-bg);
        color: var(--btn-content);
        font-size: 0.65rem;
        font-weight: 700;
        line-height: 1.25;
        text-align: center;
      }
      .about-subnav-item:hover,
      .about-subnav-item:focus-visible,
      .about-subnav-item.is-active {
        border-bottom-color: var(--primary);
        color: var(--primary);
        outline: none;
      }
      .about-subnav-item.is-active .about-ico {
        opacity: 1;
      }

      /* ================= ⑤ 两栏布局（按容器宽度分档） ================= */
      .about-cols-wrap {
        container-type: inline-size;
      }
      .about-cols {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
      }
      /* 内容列自身够宽（≥880px）才分两栏 */
      @container (min-width: 880px) {
        .about-cols {
          grid-template-columns: minmax(0, 1fr) 288px;
        }
      }
      /* 卡片内边距 = 参考站：主列 clamp(1rem,2.5vw,1.45rem) / 侧列 1rem */
      .about-col-main > section {
        padding: clamp(1rem, 2.5vw, 1.45rem);
      }
      .about-col-side > section {
        padding: 1rem;
      }
      .about-col-main,
      .about-col-side {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 0;
      }
      /* 主列卡头下的分隔线（等价于参考站 .profile-readme__body 的 border-top） */
      .about-col-main > section > .mb-5:first-child {
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--line-divider);
      }

      /* ================= ⑥ 小区块标签 kicker = 参考站 .profile-section-kicker ================= */
      .about-section-label {
        display: inline-flex;
        align-items: center;
        gap: 0.42rem;
        margin: 0;
        color: var(--primary);
        font-size: 0.6rem;
        font-weight: 780;
        letter-spacing: 0.12em;
        line-height: 1.3;
        text-transform: uppercase;
      }
      /* 卡头右侧的「更多 →」= 参考站 .profile-section-link */
      .about-section-link {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--content-meta);
        font-size: 0.72rem;
        text-decoration: none;
        transition: color 0.18s;
      }
      .about-section-link:hover,
      .about-section-link:focus-visible {
        color: var(--primary);
        outline: none;
      }
      /* 卡头右侧的次要说明 = 参考站 .profile-panel__meta */
      .about-card-meta {
        color: var(--content-meta);
        font-size: 0.68rem;
        font-weight: 400;
        white-space: nowrap;
      }

      /* ================= ⑦ 引语 = 参考站 .profile-readme__quote ================= */
      .about-quote {
        margin: 0 0 1.15rem;
        padding: 0.8rem 1rem;
        border: 1px solid
          color-mix(in srgb, var(--primary) 18%, var(--line-divider));
        border-radius: 0 0.7rem 0.7rem 0;
        background: color-mix(in srgb, var(--primary) 7%, var(--card-bg));
        font-size: clamp(1rem, 1.8vw, 1.18rem);
        font-weight: 700;
        line-height: 1.7;
        font-style: normal;
      }

      /* ================= ⑧ 正文段落 = 参考站 .profile-markdown p ================= */
      .about-paragraphs > p {
        max-width: 72ch;
        margin: 0.85rem 0 0;
        color: var(--content-meta);
        font-size: 0.92rem;
        line-height: 1.9;
      }
      .about-paragraphs > p:first-child {
        margin-top: 0;
      }

      /* ================= ⑨ 内嵌卡片：项目 / 更新摘要 = 参考站 .project-card ================= */
      .about-proj-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem;
      }
      .about-tile-list {
        display: grid;
        gap: 0.55rem;
      }
      /* 横向网格：图标方块 | 正文 | 箭头（参考站无封面图） */
      .about-proj,
      .about-tile {
        display: grid;
        grid-template-columns: 2rem minmax(0, 1fr) auto;
        align-items: start;
        gap: 0.7rem;
        min-width: 0;
        padding: 0.82rem;
        border: 1px solid var(--line-divider);
        border-radius: 0.78rem;
        background: color-mix(in srgb, var(--card-bg) 95%, var(--primary) 5%);
        color: inherit;
        text-decoration: none;
        transition:
          transform 0.18s,
          border-color 0.18s,
          background-color 0.18s,
          box-shadow 0.18s;
      }
      .about-proj:hover,
      .about-proj:focus-visible,
      .about-tile:hover,
      .about-tile:focus-visible {
        border-color: color-mix(
          in srgb,
          var(--primary) 48%,
          var(--line-divider)
        );
        background: color-mix(in srgb, var(--primary) 7%, var(--card-bg));
        box-shadow: 0 0.55rem 1.25rem
          color-mix(in srgb, var(--primary) 10%, transparent);
        transform: translateY(-2px);
        outline: none;
      }
      .about-proj__icon,
      .about-tile__icon {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 0.6rem;
        background: color-mix(in srgb, var(--primary) 12%, transparent);
        color: var(--primary);
        font-size: 1.1rem;
      }
      /* 参考站的三色图标变体（.project-card--gold / --mint / --violet） */
      .is-gold .about-proj__icon,
      .is-gold .about-tile__icon {
        background: #f0b93333;
        color: #c48a08;
      }
      .is-mint .about-proj__icon,
      .is-mint .about-tile__icon {
        background: #42c7b02e;
        color: #159b8b;
      }
      .is-violet .about-proj__icon,
      .is-violet .about-tile__icon {
        background: #8b78db2b;
        color: #7361c8;
      }
      .about-proj__body,
      .about-tile__body {
        display: grid;
        gap: 0.35rem;
        min-width: 0;
      }
      .about-proj__title,
      .about-tile__title {
        overflow: hidden;
        color: var(--deep-text);
        font-size: 0.88rem;
        font-weight: 760;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .about-proj__desc,
      .about-tile__desc {
        display: -webkit-box;
        overflow: hidden;
        color: var(--content-meta);
        font-size: 0.74rem;
        line-height: 1.55;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }
      .about-proj__tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
      }
      /* 项目卡底部技术标签 = 参考站 .project-card__tags em */
      .about-proj__tech i {
        font-style: normal;
        padding: 0.18rem 0.34rem;
        border-radius: 0.35rem;
        background: var(--btn-regular-bg);
        color: var(--btn-content);
        font-size: 0.6rem;
        line-height: 1.2;
      }
      /* 外链箭头 = 参考站 .project-card__arrow / .activity-arrow */
      .about-proj__arrow,
      .about-tile__arrow,
      .about-activity-arrow {
        color: var(--content-meta);
        font-size: 0.95rem;
        transition:
          color 0.18s,
          transform 0.18s;
      }
      .about-proj:hover .about-proj__arrow,
      .about-proj:focus-visible .about-proj__arrow,
      .about-tile:hover .about-tile__arrow,
      .about-tile:focus-visible .about-tile__arrow,
      .about-activity:hover .about-activity-arrow {
        color: var(--primary);
        transform: translate(0.1rem, -0.1rem);
      }

      /* ================= ⑩ 更新摘要里的动作标签 = 参考站 .project-card__tags em ================= */
      .about-chip-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
      }
      .about-chip {
        display: inline-block;
        padding: 0.18rem 0.34rem;
        border-radius: 0.35rem;
        background: var(--btn-regular-bg);
        color: var(--btn-content);
        font-size: 0.6rem;
        font-weight: 400;
        line-height: 1.2;
        white-space: nowrap;
      }

      /* ================= ⑪ 卡头 = 参考站 .profile-panel__header / .profile-side-heading ================= */
      .about-card-head {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.8rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--line-divider);
      }
      .about-head-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        color: var(--primary);
        font-size: 1.08rem;
        line-height: 1;
      }
      .about-card-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 780;
        letter-spacing: -0.015em;
        line-height: 1.3;
      }

      /* ================= ⑫ 我的朋友（带头像卡片墙）/ 技术轨迹（标签胶囊） =================
         2026-09-13 改版：两个卡片原本共用 .about-friend / .about-tag-chip 一套胶囊样式，
         现在「我的朋友」升级为带头像卡片墙 ⇒ **必须解耦**，否则技术轨迹会被一起改掉。
         · .about-friends / .about-friend*  → 卡片墙（圆形 logo + 名称 + 描述，2 列）
         · .about-tag-list / .about-tag-chip → 仍是胶囊（保持参考站 .stack-list 青色系） */
      .about-friends {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.4rem;
        margin-top: 0.8rem;
      }
      .about-tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: 0.8rem;
      }

      /* ---- 友链卡片：圆形头像 + 名称 / 描述两行 ----
         视觉目标：像「一排名片」而不是「一排按钮」。
         · 圆形 logo 弱化轮廓，让名称成为主角
         · 描述行降一级颜色、单行省略，避免长短不一撑破网格
         · 悬停：描边提亮 + 淡主色底 + 上浮 1px（与卡片体系其它可点项一致） */
      .about-friend {
        display: grid;
        grid-template-columns: 1.5rem minmax(0, 1fr);
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        padding: 0.45rem 0.55rem;
        border: 1px solid
          color-mix(in srgb, var(--primary) 16%, var(--line-divider));
        border-radius: 0.55rem;
        background: color-mix(in srgb, var(--primary) 5%, var(--card-bg));
        color: var(--btn-content);
        text-decoration: none;
        transition:
          color 0.18s,
