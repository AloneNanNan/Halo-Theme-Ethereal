        .about-subnav-item {
          padding: 0.7rem 0.65rem 0.58rem;
          font-size: 0.72rem;
        }
        .about-card-meta,
        .about-section-link {
          font-size: 0.62rem;
        }
        .about-proj-grid {
          grid-template-columns: minmax(0, 1fr);
        }
        /* 友链卡片墙：窄屏两列会挤成「名称只剩两个字」⇒ 降为单列 */
        .about-friends {
          grid-template-columns: minmax(0, 1fr);
        }
        /* 参考站 ≤640px：内嵌卡与活动行整体缩一档 */
        .about-proj,
        .about-tile {
          grid-template-columns: 1.85rem minmax(0, 1fr) auto;
          gap: 0.58rem;
          padding: 0.72rem;
        }
        .about-proj__icon,
        .about-tile__icon {
          width: 1.85rem;
          height: 1.85rem;
          font-size: 1rem;
        }
        .about-proj__title,
        .about-tile__title {
          font-size: 0.83rem;
        }
        .about-proj__desc,
        .about-tile__desc {
          font-size: 0.7rem;
        }
        .about-activity {
          grid-template-columns: 0.45rem 2rem minmax(0, 1fr) auto;
          gap: 0.45rem;
        }
        .about-activity-link {
          font-size: 0.74rem;
        }
        section.about-footer-card {
          align-items: flex-start;
          flex-direction: column;
          padding: 0.9rem;
        }
        .about-footer-links {
          justify-content: flex-start;
        }
