---
// 关于我页面模板（Halo 自定义页面，自定义模板选 about）。
// 数据来自主题设置「扩展页面 → 关于我页面」→ theme.config.extendPages.about。
//
// 布局：身份卡（横跨）→ 顶部导航（横跨）→ 两栏
//   主列：关于我 / 本人项目 / 最近的提交
//   侧列：我的技能 / 我的朋友 / 保持联系
//   （「我的朋友」位于我的技能下方，带头像卡片墙）
// 两栏按**容器宽度**分档（≥880px 才分栏），不跟视口走 —— 见 .about-cols-wrap。
// 「关于我正文」由 extend-pages.js 在客户端按段落渲染；其余字段都已服务端直出。
// 「本人项目」取自「项目集」插件的项目、「我的技能」取自技能页面配置。
// 友链取自 Halo 友链插件的 linkFinder.random(N)（每次请求随机取 N 条，N 可在主题设置里调）。
import MainGridLayout from "../layouts/MainGridLayout.astro";
import "../styles/about.css";
---

<MainGridLayout
  title="${singlePage.spec.title + ' - ' + site.title}"
  description="#{page.about.description(${site.title})}"
>
  <!-- 数据通道：
       · cfg          = 本页配置（主题设置 → 关于我）
       · aboutPosts   = 最新已发布文章（Finder 变量，用 ?. 空安全）
       · aboutMoments = 最新瞬间（瞬间插件注入 momentFinder；未装插件时短路为 null）
       两组一起供「最近的提交」卡片用，客户端按 data-time 归并成一条时间线。
       · friendLinks  = 「我的朋友」的友链（linkFinder.random(friendCount)，服务端随机取 N 条；
       url / logo 的合法性在卡片里逐条判断）。
       · friendCount  = 「我的朋友」显示条数（已转 Integer 并夹到 [1, 12]）。

       🔴🔴 1.4.84 修正（推翻 1.4.83 的错误结论）：这条 th:with 的变量
       **能被下方所有卡片正常读到**（cfg / aboutPosts 一直在被「关于我」
       「最近的提交」等卡片使用且渲染正常）。1.4.83 曾误判「顶层 th:with
       跨 slot 失效」，于是把变量下放到卡片自身 section 的 th:with，却又把
       th:if 放在了**同一个元素上**——Thymeleaf 里 th:if(优先级3) 先于
       th:with(优先级4) 执行 ⇒ th:if 求值时变量还是 null ⇒ 恒假。所以
       1.4.83 依然没修好。正确做法：变量就在这条顶层 th:with 里补 groups，
       卡片/subnav 直接用，勿再在消费点上叠 th:with + th:if。 -->
  <div
    th:with="cfg=${theme.config?.extendPages?.about},
      rawActivityCount=${cfg?.activity?.count != null ? #conversions.convert(cfg?.activity?.count, 'java.lang.Integer') : 5},
      activityCount=${rawActivityCount > 20 ? 20 : (rawActivityCount < 2 ? 2 : rawActivityCount)},
      aboutPosts=${postFinder?.list({page: 1, size: activityCount})?.items},
      aboutMoments=${momentFinder?.list({size: activityCount})?.items},
      aboutPostCount=${aboutPosts != null ? #lists.size(aboutPosts) : 0},
      aboutMomentCount=${aboutMoments != null ? #lists.size(aboutMoments) : 0},
      rawFriendCount=${cfg?.friends?.count != null ? #conversions.convert(cfg?.friends?.count, 'java.lang.Integer') : 6},
      friendCount=${rawFriendCount > 12 ? 12 : (rawFriendCount < 1 ? 1 : rawFriendCount)},
      friendLinks=${(pluginFinder == null or !pluginFinder.available('PluginLinks') or linkFinder == null) ? null : linkFinder.random(friendCount)},
      skillsUrl=${cfg?.skills?.url},
      skillsShowMore=${cfg?.skills?.showMore != false},
      skillItems=${theme.config?.extendPages?.skills?.entries?.items},
      skillFrontend=${skillItems == null ? null : skillItems.?[#this.name != null and #this.name != '' and #this.category == 'frontend']},
      skillBackend=${skillItems == null ? null : skillItems.?[#this.name != null and #this.name != '' and #this.category == 'backend']},
      skillDatabase=${skillItems == null ? null : skillItems.?[#this.name != null and #this.name != '' and #this.category == 'database']},
      skillTools=${skillItems == null ? null : skillItems.?[#this.name != null and #this.name != '' and #this.category == 'tools']},
      skillOther=${skillItems == null ? null : skillItems.?[#this.name != null and #this.name != '' and #this.category == 'other']},
      projectCount=${cfg?.projects?.count != null ? #conversions.convert(cfg?.projects?.count, 'java.lang.Integer') : 4},
      projects=${pluginFinder != null and pluginFinder.available('portfolio') ? projectFinder?.list(1, projectCount) : null},
      socials=${theme.config?.sidebar?.profile?.social_media}"
    th:remove="tag"
  >
    <!-- ================= ① 身份卡 =================
         ⚠️ 本页 cfg = theme.config?.extendPages?.about（页面级作用域），
         所以「在线状态」等侧栏配置项**不能**写 cfg?.sidebar?.…（永远为 null，
         1.4.90 正是踩了这条 ⇒ 状态胶囊恒不渲染），必须走完整路径
         theme.config?.sidebar?.profile?.statusSettings（同 socials 的写法）。 -->
    <section
      class="card-base about-hero-card onload-animation mb-4"
      th:if="${cfg?.identity?.enable != false}"
      th:with="ident=${cfg?.identity},
        sts=${theme.config?.sidebar?.profile?.statusSettings},
        avatarSrc=${!#strings.isEmpty(ident?.avatar)
          ? ident?.avatar
          : (#strings.isEmpty(theme.config?.sidebar?.profile?.avatar)
            ? '/themes/Ethereal/assets/images/demo-avatar.png'
            : theme.config?.sidebar?.profile?.avatar)},
        actions=${ident?.actions == null
          ? null
          : ident?.actions.?[#this.label != null and #this.label != '' and #this.url != null and #this.url != '']}"
    >
      <div class="relative z-1 flex flex-col gap-5 sm:flex-row sm:items-center">
        <!-- 头像：本卡单独设置优先；留空回落到侧栏「个人简介小组件」的头像
             （该字段默认值就是主题内置头像，两者都空时也用它兜底，不留破图） -->
        <span class="about-avatar">
          <img
            class="about-avatar__image"
            th:src="${avatarSrc}"
            th:alt="${ident?.name ?: site.title}"
            src=""
            alt="avatar"
          />
        </span>
        <div class="min-w-0 flex-1">
          <h1
            class="about-name text-90"
            th:text="${#strings.defaultString(ident?.name, site.title)}"
          >
            关于我
          </h1>
          <p
            class="about-roles"
            th:if="${!#strings.isEmpty(ident?.roles)}"
            th:text="${ident?.roles}"
          >
            身份
          </p>
          <p
            class="about-tagline text-75"
            th:if="${!#strings.isEmpty(ident?.tagline)}"
            th:text="${ident?.tagline}"
          >
            一句话简介
          </p>
          <!-- 状态：1.4.90 起优先绑定主题「在线状态」statusSettings（与侧栏头像卡
               同源，点击同样弹出切换模态框，由 profile-status.ts 委托处理）；
               未启用 / 未配置时回退 ident.status 静态文案（闪电图标行）。
               图标/动效/配色类与 Profile.astro 的 th:case 分支逐字面量一致
               （Tailwind 只认完整字面量 + 空白分隔，别运行时拼类名）。 -->
          <!-- 无障碍名 = 可见状态文案 + 视觉隐藏的「切换当前状态」提示。
               ⚠️ 不写死 aria-label="切换当前状态"：本胶囊**有可见文案**，
               可访问名不含可见文本会违反 WCAG 2.5.3（Label in Name）；
               而同主题的 Categories.astro 里也因为这条 2.5.3 删过同类 aria-label。 -->
          <button
            type="button"
            class="about-status about-status-pill"
            th:if="${sts != null and sts?.enable != false}"
            th:attr="data-status=${sts?.status ?: 'online'}"
            th:switch="${sts?.status ?: 'online'}"
          >
            <span th:case="energetic" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--sun-fill] text-amber-500 status-spin"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.energetic) ? sts?.energetic : '元气满满'}"
                >元气满满</span
              >
            </span>
            <span th:case="emo" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--sad-fill] text-violet-400 status-float"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.emo) ? sts?.emo : 'emo中'}"
                >emo中</span
              >
            </span>
            <span th:case="study" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--book-2-fill] text-sky-500 status-drift"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.study) ? sts?.study : '学习中'}"
                >学习中</span
              >
            </span>
            <span th:case="busy" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--fire-fill] text-orange-500 status-wiggle"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.busy) ? sts?.busy : '忙碌中'}"
                >忙碌中</span
              >
            </span>
            <span th:case="dnd" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--moon-fill] text-indigo-400 status-float"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.dnd) ? sts?.dnd : '请勿打扰'}"
                >请勿打扰</span
              >
            </span>
            <span th:case="sleep" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--moon-stars-fill] text-blue-500 status-pulse"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.sleep) ? sts?.sleep : '睡觉中'}"
                >睡觉中</span
              >
            </span>
            <span th:case="away" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--cloud-fill] text-neutral-400 status-drift"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.away) ? sts?.away : '暂时离开'}"
                >暂时离开</span
              >
            </span>
            <!-- 在线（默认分支） -->
            <span th:case="*" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--leaf-fill] text-green-500 status-pulse"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.online) ? sts?.online : '在线中'}"
                >在线中</span
              >
            </span>
            <span class="sr-only" th:text="#{profile.switchStatus}"
              >切换当前状态</span
            >
          </button>
          <p
            class="about-status"
            th:if="${(sts == null or sts?.enable == false) and !#strings.isEmpty(ident?.status)}"
          >
            <span
              class="icon-[material-symbols--bolt-rounded] about-ico"
              aria-hidden="true"></span>
            <span th:text="${ident?.status}">状态</span>
          </p>
        </div>

        <!-- 卡片按钮：条目完全自定义（文字 / 图标 / 链接，字段结构同顶部导航），
             数量上限由设置项自身的 max: 3 限制（后台加不了第 4 条），模板不再重复截断。
             第 1 个为主按钮（主题色高亮），其余为次按钮。
             「名称 + 链接」都填了才算有效条目（只填其一视为未配置），一条都没有时整块不渲染。
             图标：$formkit: iconify + format: svg ⇒ 值是一整段内联 SVG（fill 为 currentColor），
             必须 th:utext 注入、留空则完全不渲染图标元素 —— 同顶部导航的写法。 -->
        <div
          class="about-hero-actions"
          th:if="${actions != null and not #lists.isEmpty(actions)}"
        >
          <a
            th:each="act, ast : ${actions}"
            class="about-btn"
            th:classappend="${ast.index == 0
              ? 'about-btn--primary'
              : 'about-btn--ghost'}"
            th:href="${act?.url}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span
              th:if="${act?.icon != null and !#strings.isEmpty(act?.icon?.value)}"
              class="about-ico about-ico--svg"
              aria-hidden="true"
              th:utext="${act?.icon?.value}"></span>
            <span th:text="${act?.label}">查看 GitHub</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= ② 顶部导航（长条菜单） =================
         条目完全自定义（主题设置 → 关于我 → 顶部导航 → 导航条目：图标 / 文字 / 链接），
         一条都没配时整块导航不渲染。
         th:if 引用的是页面顶层 th:with 定义的 cfg（**外层变量**），不是同元素 th:with，
         所以不存在「th:if(300) 先于 th:with(400) 求值」的坑。
         链接留空 = 指向当前页面（用于「个人资料」这类表示当前所在页的条目），
         这类条目自动带 is-active + aria-current="page"，与改动前的行为一致。 -->
    <nav
      class="card-base about-subnav onload-animation mb-4"
      th:if="${cfg?.nav?.enable != false and cfg?.nav?.items != null and not #lists.isEmpty(cfg?.nav?.items)}"
      th:aria-label="#{page.about.navLabel}"
    >
      <a
        th:each="navItem : ${cfg?.nav?.items}"
        class="about-subnav-item"
        th:classappend="${#strings.isEmpty(navItem?.url) ? ' is-active' : ''}"
        th:href="${#strings.isEmpty(navItem?.url) ? singlePage.status.permalink : navItem?.url}"
        th:aria-current="${#strings.isEmpty(navItem?.url) ? 'page' : null}"
      >
        <!-- 图标：$formkit: iconify + format: svg ⇒ 值是一整段内联 SVG（fill 为
             currentColor，跟随条目文字色）。必须用 th:utext 注入、不能走 th:class
             —— 同 links.astro 折叠面板、Profile.astro 社交图标。
             图标由用户自选（后台不预置默认值）：留空时不渲染任何图标元素，只显示文字。 -->
        <span
          th:if="${navItem?.icon != null and !#strings.isEmpty(navItem?.icon?.value)}"
          class="about-ico about-ico--svg"
          aria-hidden="true"
          th:utext="${navItem?.icon?.value}"></span>
        <span th:text="${navItem?.label}">个人资料</span>
      </a>
    </nav>

    <!-- ================= ③ 两栏正文 ================= -->
    <div class="about-cols-wrap">
      <div class="about-cols">
        <!-- ---------- 主列 ---------- -->
        <div class="about-col-main">
          <!-- 关于我（个人简介卡片） -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.intro?.enable != false}"
          >
            <div class="about-card-head-row mb-5">
              <h2
                class="about-card-title text-90"
                th:text="#{page.about.introTitle}"
              >
                关于我
              </h2>
            </div>
            <blockquote
              class="about-quote"
              th:if="${!#strings.isEmpty(cfg?.intro?.quote)}"
              th:text="${cfg?.intro?.quote}"
            >
              引语
            </blockquote>
            <div
              class="about-paragraphs"
              th:if="${!#strings.isEmpty(cfg?.intro?.intro)}"
              th:data-lines="${cfg?.intro?.intro}"
              data-lines-render="paragraphs"
            >
            </div>
          </section>

          <!-- 本人项目：数据 = 「项目集」插件的项目（plugin metadata.name = portfolio）。
               取前 4 个（插件默认排序：priority desc → 创建时间 desc），点击进项目详情页。
               ⚠️ 插件未安装时整卡隐藏：直接调 Finder 会抛异常、容器被跳过（同「瞬间预览条」的处理）。
               项目模型里没有图标字段，左侧小图标按序号轮换内置图标（纯装饰，不代表项目语义）；
               techStacks 是插件给的字符串数组，直接服务端 th:each 渲染为标签。 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.projects?.enable != false and projects != null and projects.items != null and not #lists.isEmpty(projects.items)}"
          >
            <div
              class="about-card-head-row mb-5 flex flex-wrap items-center justify-between gap-3"
            >
              <h2
                class="about-card-title text-90"
                th:text="#{page.about.projectsTitle}"
              >
                本人项目
              </h2>
              <!-- 链接文字与地址都固定，只留「显示 / 隐藏」开关：
                   文字走 i18n；地址是「项目集」插件的列表路由 /portfolio（不支持自定义），
                   用 @{} 包一层以兼容部署上下文路径。 -->
              <a
                class="about-section-link"
                th:if="${cfg?.projects?.showMore != false}"
                th:href="@{/portfolio}"
              >
                <span th:text="#{page.about.projectsMore}">全部项目 →</span>
              </a>
            </div>
            <div class="about-proj-grid">
              <!-- 卡片不放图标：项目集插件的项目模型里没有图标字段，按下标编一套图标
                   属于「假信息」（同一个项目换个排序就换图标），不如不要，版式也更干净。
                   正文列直接铺满首列，右上角保留外链箭头。 -->
              <a
                class="about-proj"
                th:each="project : ${projects.items}"
                th:href="@{/portfolio/{slug}(slug=${project?.slug})}"
              >
                <span class="about-proj__body">
                  <strong class="about-proj__title" th:text="${project?.title}"
                    >项目名</strong
                  >
                  <span
                    class="about-proj__desc"
                    th:if="${!#strings.isEmpty(project?.summary)}"
                    th:text="${project?.summary}">说明</span
                  >
                  <span
                    class="about-proj__tech"
                    th:if="${project?.techStacks != null and not #lists.isEmpty(project?.techStacks)}"
                  >
                    <i th:each="tech : ${project?.techStacks}" th:text="${tech}"
                    ></i>
                  </span>
                </span>
                <span
                  class="about-proj__arrow icon-[material-symbols--arrow-outward-rounded]"
                  aria-hidden="true"></span>
              </a>
            </div>
          </section>

          <!-- 最近的提交：数据 = 最新文章 + 最新瞬间（服务端直出，无 JS 也完整可见）。
               样式 = 时间轴：竖虚线 + 节点圆点 + 「日期 / 类型 / 标题」三段式行，
               取主题已有三套时间轴的组合写法 —— 时间轴页 .timeline-node 的节点缩放光环、
               朋友圈 .friends-timeline 的虚线列 + 日期在前、归档页 .dash-line 的虚线基调。
               瞬间的 spec.content.raw 是富文本 HTML，先剥标签再当纯文本用；
               超长交给 .about-activity-title 的单行省略号收尾，不做裁剪。
               行上的 data-time（ISO-8601）供客户端把两组归并成一条时间线，
               归并后按 data-count（= 设置里的「显示数量」）截断到总共 N 条。
               无 JS 时不做归并与截断，两组按服务端顺序完整展示（渐进增强）。 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.activity?.enable != false and (aboutPostCount + aboutMomentCount) > 0}"
          >
            <div class="about-card-head-row mb-5">
              <h2
                class="about-card-title text-90"
                th:text="#{page.about.activityTitle}"
              >
                最近提交
              </h2>
            </div>
            <ul
              class="about-activity-list"
              data-activity-timeline
              th:data-count="${activityCount}"
            >
              <li
                class="about-activity"
                th:each="p : ${aboutPosts}"
                th:data-time="${p?.spec?.publishTime}"
              >
                <span class="about-activity-dot" aria-hidden="true"></span>
                <a
                  class="about-activity-body"
                  th:href="@{${p?.status?.permalink}}"
                >
                  <span class="about-activity-main">
                    <span class="about-activity-head">
                      <span
                        class="about-activity-date"
                        th:text="${p?.spec?.publishTime != null
                          ? #dates.format(p?.spec?.publishTime, 'MM-dd')
                          : ''}"
                        >09-18</span
                      >
                      <span
                        class="about-activity-kind"
                        th:text="#{page.about.activityPost}">文章</span
                      >
                    </span>
                    <span
                      class="about-activity-title"
                      th:text="${p?.spec?.title}">标题</span
                    >
                  </span>
                  <!-- 箭头放进 <a> 内部：悬停高亮（胶囊底）要把它一起包住 -->
                  <span
                    class="about-activity-arrow icon-[material-symbols--arrow-outward-rounded]"
                    aria-hidden="true"></span>
                </a>
              </li>
              <li
                class="about-activity"
                th:each="m : ${aboutMoments}"
                th:with="momentText=${m?.spec?.content?.raw != null
                    ? m?.spec?.content?.raw.replaceAll('<[^>]*>', ' ').trim()
                    : ''},
                  momentLabel=${#strings.defaultString(momentText, '分享了一条瞬间')}"
                th:data-time="${m?.spec?.releaseTime}"
              >
                <span class="about-activity-dot" aria-hidden="true"></span>
                <a
                  class="about-activity-body"
                  th:href="@{/moments/{name}(name=${m?.metadata?.name})}"
                >
                  <span class="about-activity-main">
                    <span class="about-activity-head">
                      <span
                        class="about-activity-date"
                        th:text="${m?.spec?.releaseTime != null
                          ? #dates.format(m?.spec?.releaseTime, 'MM-dd')
                          : ''}"
                        >09-18</span
                      >
                      <span
                        class="about-activity-kind"
                        th:text="#{page.about.activityMoment}">瞬间</span
                      >
                    </span>
                    <span class="about-activity-title" th:text="${momentLabel}"
                      >内容</span
                    >
                  </span>
                  <!-- 箭头放进 <a> 内部：悬停高亮（胶囊底）要把它一起包住 -->
                  <span
                    class="about-activity-arrow icon-[material-symbols--arrow-outward-rounded]"
                    aria-hidden="true"></span>
                </a>
              </li>
            </ul>
          </section>
        </div>

        <!-- ---------- 侧列 ---------- -->
        <div class="about-col-side">
          <!-- 我的技能：数据 = 「技能页面」设置里的技能（theme.config.extendPages.skills.entries.items）。
               按设置的 category（前端 / 后端 / 数据库 / 工具 / 其他）分组展示，每组「组名 + 胶囊行」；
               分组写死 5 块而不是按 category 动态归并：分类本身是固定枚举，写死才能直接对上 i18n key、
               分组顺序也稳定（与技能页筛选条同序）；分组为空则整组不渲染，全空则整卡隐藏。
               胶囊 = 技能自己的 iconify 图标（可选，留空只显示文字）+ 技能名，纯展示、不可点。
               右上角「全部技能 →」走「技能页面 → 技能页面地址 / 显示」两个设置项（同本人项目的开关思路）。
               每组过滤「名称非空」的条目（skillXxx 在页面顶层 th:with 里已过滤，避免出现空壳分组）。 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.skills?.enable != false and skillItems != null and not #lists.isEmpty(skillItems)}"
          >
            <div class="about-card-head flex-wrap">
              <h2
                class="about-card-title text-90"
                th:text="#{page.about.skillsTitle}"
              >
                我的技能
              </h2>
              <!-- 右上角「全部技能 →」：与「本人项目」同一套写法（文字走 i18n、地址来自设置）。
                   ml-auto 把它推到行尾；本卡用 .about-card-head（flex 卡头）而非
                   .about-card-head-row，因为要留出 ml-auto 推到行尾的空间。 -->
              <a
                class="about-section-link ml-auto"
                th:if="${skillsShowMore and !#strings.isEmpty(skillsUrl)}"
                th:href="${skillsUrl}"
              >
                <span th:text="#{page.about.skillsMore}">全部技能 →</span>
              </a>
            </div>
            <div class="about-skill-groups">
              <div
                class="about-skill-group"
                th:if="${skillFrontend != null and not #lists.isEmpty(skillFrontend)}"
              >
                <p
                  class="about-skill-group-title"
                  th:text="#{page.skills.frontend}"
                >
                  前端开发
                </p>
                <div class="about-tag-list">
                  <span
                    th:each="skill : ${skillFrontend}"
                    class="about-tag-chip"
                  >
                    <span
                      th:if="${skill?.icon != null and !#strings.isEmpty(skill?.icon?.value)}"
                      class="about-ico about-ico--svg"
                      aria-hidden="true"
                      th:utext="${skill?.icon?.value}"></span>
                    <span th:text="${skill?.name}">技能</span>
                  </span>
                </div>
              </div>
              <div
                class="about-skill-group"
                th:if="${skillBackend != null and not #lists.isEmpty(skillBackend)}"
              >
                <p
                  class="about-skill-group-title"
                  th:text="#{page.skills.backend}"
                >
                  后端开发
                </p>
                <div class="about-tag-list">
                  <span
                    th:each="skill : ${skillBackend}"
                    class="about-tag-chip"
                  >
                    <span
                      th:if="${skill?.icon != null and !#strings.isEmpty(skill?.icon?.value)}"
                      class="about-ico about-ico--svg"
                      aria-hidden="true"
                      th:utext="${skill?.icon?.value}"></span>
                    <span th:text="${skill?.name}">技能</span>
                  </span>
                </div>
              </div>
              <div
                class="about-skill-group"
                th:if="${skillDatabase != null and not #lists.isEmpty(skillDatabase)}"
              >
                <p
                  class="about-skill-group-title"
                  th:text="#{page.skills.database}"
                >
                  数据库
                </p>
                <div class="about-tag-list">
                  <span
                    th:each="skill : ${skillDatabase}"
                    class="about-tag-chip"
                  >
                    <span
                      th:if="${skill?.icon != null and !#strings.isEmpty(skill?.icon?.value)}"
                      class="about-ico about-ico--svg"
                      aria-hidden="true"
                      th:utext="${skill?.icon?.value}"></span>
                    <span th:text="${skill?.name}">技能</span>
                  </span>
                </div>
              </div>
              <div
                class="about-skill-group"
                th:if="${skillTools != null and not #lists.isEmpty(skillTools)}"
              >
                <p
                  class="about-skill-group-title"
                  th:text="#{page.skills.tools}"
                >
                  开发工具
                </p>
                <div class="about-tag-list">
                  <span th:each="skill : ${skillTools}" class="about-tag-chip">
                    <span
                      th:if="${skill?.icon != null and !#strings.isEmpty(skill?.icon?.value)}"
                      class="about-ico about-ico--svg"
                      aria-hidden="true"
                      th:utext="${skill?.icon?.value}"></span>
                    <span th:text="${skill?.name}">技能</span>
                  </span>
                </div>
              </div>
              <div
                class="about-skill-group"
                th:if="${skillOther != null and not #lists.isEmpty(skillOther)}"
              >
                <p
                  class="about-skill-group-title"
                  th:text="#{page.skills.other}"
                >
                  其他技能
                </p>
                <div class="about-tag-list">
                  <span th:each="skill : ${skillOther}" class="about-tag-chip">
                    <span
                      th:if="${skill?.icon != null and !#strings.isEmpty(skill?.icon?.value)}"
                      class="about-ico about-ico--svg"
                      aria-hidden="true"
                      th:utext="${skill?.icon?.value}"></span>
                    <span th:text="${skill?.name}">技能</span>
                  </span>
                </div>
              </div>
            </div>
          </section>

          <!-- 我的朋友（数据取自本站友情链接）
               2026-09-13：由「文字胶囊网格」改版为「带头像的卡片墙」，
               并从「我的技能」上方移到下方（LQ 要求：我的技能卡片下面）。
               形态：圆形 logo + 名称 + 单行描述，两列网格。
               数据源：Links 插件的 linkFinder.random(N) —— 服务端每次请求随机取 N 条
               （N = 设置里的「显示数量」），所以「每次刷新换一批」是零 JS 的：客户端洗牌
               那套已从 extend-pages.js 移除，超量条目也不会下发到前台。
               ⚠️ 依赖插件的 random(maxSize)（插件 README 有列，但主题里此前没用过）：
               若插件版本不支持，本页渲染会抛错 —— 届时把顶层 th:with 的 friendLinks 换回
               linkFinder.groupBy()，本段按分组两轮遍历即可（改动只有这两处）。

               🔴🔴 1.4.84 修正：变量都在上方页面顶层 th:with 里（friendLinks /
               friendCount）。**不要**在本 section 上再叠 th:with + th:if：th:if(3)
               先于 th:with(4) 执行，同元素上 th:if 读不到 th:with 的变量
               （1.4.83 正是这样修坏的）。 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.friends?.enable != false and friendLinks != null and !#lists.isEmpty(friendLinks)}"
          >
            <div class="about-card-head">
              <h2
                class="about-card-title text-90"
                th:text="#{page.about.friendsTitle}"
              >
                我的朋友
              </h2>
            </div>
            <!-- aboutLogoOk 口径与页脚友链一致：logo 非空且是 http / // / / 开头；
                 url 非法时只渲染卡片、不生成 href（沿用原有行为）。 -->
            <div class="about-friends">
              <a
                class="about-friend"
                th:each="l : ${friendLinks}"
                th:with="aboutLogoOk = ${l?.spec?.logo != null and (l?.spec?.logo.startsWith('http') or l?.spec?.logo.startsWith('//') or l?.spec?.logo.startsWith('/'))}"
                th:href="${l?.spec?.url != null and (l?.spec?.url.startsWith('http') or l?.spec?.url.startsWith('//') or l?.spec?.url.startsWith('/')) ? l?.spec?.url : null}"
                th:title="${#strings.defaultString(l?.spec?.description, l?.spec?.displayName)}"
                target="_blank"
                rel="noopener noreferrer"
              >
                <img
                  th:if="${aboutLogoOk}"
                  th:src="${l?.spec?.logo}"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="about-friend-logo"
                />
                <span th:unless="${aboutLogoOk}" class="about-friend-logo-ph">
                  <span
                    class="icon-[material-symbols--link-rounded]"
                    aria-hidden="true"></span>
                </span>
                <span class="about-friend-body">
                  <span
                    class="about-friend-name"
                    th:text="${l?.spec?.displayName}">链接</span
                  >
                  <span
                    class="about-friend-desc"
                    th:if="${!#strings.isEmpty(l?.spec?.description)}"
                    th:text="${l?.spec?.description}"></span>
                </span>
              </a>
            </div>
          </section>

          <!-- 保持联系：数据 = 侧栏「个人简介小组件 → 社交媒体」
               （social_icon 是 $formkit: iconify + format: svg ⇒ 值是一整段内联 SVG，
               必须用 th:utext 注入，不能走 th:class —— 见 Profile.astro / Footer.astro） -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.contact?.enable != false and socials != null and !#lists.isEmpty(socials)}"
          >
            <div class="about-card-head">
              <h2
                class="about-card-title text-90"
                th:text="#{page.about.contactTitle}"
              >
                保持联系
              </h2>
            </div>
            <div class="about-connect-list">
              <a
                class="about-connect"
                th:each="social : ${socials}"
                th:href="${social.url}"
                th:title="${social.name}"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="about-connect-icon"
                  th:utext="${social.social_icon?.value}"
                  aria-hidden="true"></span>
                <span th:text="${social.name}">名称</span>
                <span
                  class="about-connect-arrow icon-[material-symbols--arrow-outward-rounded]"
                  aria-hidden="true"></span>
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>

    <!-- ================= ④ 页脚卡 ================= -->
    <!-- 页脚链接走结构化设置（主题设置 → 关于我 → 页脚 → 页脚链接：名称 + 图标（可选）+ 链接，
         最多 5 条由设置项自身的 max 限制），不再用「名称|链接」的多行文本 ——
         名称位置填成 URL 那种误用就此消失。
         图标与「我的技能」胶囊 / 身份卡按钮同一套：iconify(format: svg) 值是一整段内联 SVG，
         必须 th:utext 注入、留空则完全不渲染图标元素。 -->
    <section
      class="card-base about-footer-card onload-animation mb-4"
      th:if="${cfg?.footer?.enable != false and ((!#strings.isEmpty(cfg?.footer?.motto)) or (cfg?.footer?.linkItems != null and !#lists.isEmpty(cfg?.footer?.linkItems)))}"
    >
      <div class="min-w-0">
        <p
          class="about-section-label"
          th:if="${!#strings.isEmpty(cfg?.footer?.eyebrow)}"
          th:text="${cfg?.footer?.eyebrow}"
        >
          OPEN SOURCE, OPEN CHANNEL
        </p>
        <p
          class="about-footer-motto"
          th:if="${!#strings.isEmpty(cfg?.footer?.motto)}"
          th:text="${cfg?.footer?.motto}"
        >
          页脚一句话
        </p>
      </div>
      <div
        class="about-footer-links"
        th:if="${cfg?.footer?.linkItems != null and !#lists.isEmpty(cfg?.footer?.linkItems)}"
      >
        <a
          th:each="fl : ${cfg?.footer?.linkItems}"
          th:href="${!#strings.isEmpty(fl?.url) ? fl?.url : null}"
          th:target="${!#strings.isEmpty(fl?.url) ? '_blank' : null}"
          rel="noopener noreferrer"
        >
          <span
            th:if="${fl?.icon != null and !#strings.isEmpty(fl?.icon?.value)}"
            class="about-ico about-ico--svg"
            aria-hidden="true"
            th:utext="${fl?.icon?.value}"></span>
          <span th:text="${#strings.defaultString(fl?.label, fl?.url)}"
            >链接</span
          >
        </a>
      </div>
    </section>
  </div>

  <!-- 多行字段渲染（正文 / 项目技术栈 / 标签）+ 友链随机
       + 「最近的提交」两组数据归并排序 -->
  <script
    is:inline
    src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/extend-pages.js?v=${ASSET_VERSION}`}
    defer></script>
</MainGridLayout>
