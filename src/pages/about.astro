  </Fragment>

  <!-- 数据通道：
       · cfg          = 本页配置（主题设置 → 关于我）
       · aboutPosts   = 最新已发布文章（Finder 变量，用 ?. 空安全）
       · aboutMoments = 最新瞬间（瞬间插件注入 momentFinder；未装插件时短路为 null）
       两组一起供「最近的提交」卡片用，客户端按 data-time 归并成一条时间线。
       · groups       = 友情链接分组（linkFinder.groupBy()，过滤掉空/非法 url），
       供「我的朋友」卡片 + subnav 友链计数用。

       🔴🔴 1.4.84 修正（推翻 1.4.83 的错误结论）：这条 th:with 的变量
       **能被下方所有卡片正常读到**（cfg / aboutPosts 一直在被「关于我」
       「最近的提交」等卡片使用且渲染正常）。1.4.83 曾误判「顶层 th:with
       跨 slot 失效」，于是把变量下放到卡片自身 section 的 th:with，却又把
       th:if 放在了**同一个元素上**——Thymeleaf 里 th:if(优先级3) 先于
       th:with(优先级4) 执行 ⇒ th:if 求值时变量还是 null ⇒ 恒假。所以
       1.4.83 依然没修好。正确做法：变量就在这条顶层 th:with 里补 groups，
       卡片/subnav 直接用，勿再在消费点上叠 th:with + th:if。 -->
  <div
    th:with="cfg=${theme.config?.extendPages?.about},
      aboutPosts=${postFinder?.list({page: 1, size: cfg?.activity?.count ?: 5})?.items},
      aboutMoments=${momentFinder?.list({size: cfg?.activity?.count ?: 5})?.items},
      aboutPostCount=${aboutPosts != null ? #lists.size(aboutPosts) : 0},
      aboutMomentCount=${aboutMoments != null ? #lists.size(aboutMoments) : 0},
      groups=${(pluginFinder == null or !pluginFinder.available('PluginLinks') or linkFinder == null) ? null : linkFinder.groupBy()},
      linksTotal=${groups != null and !#lists.isEmpty(groups) ? #aggregates.sum(groups.![links.size()]) : 0},
      socials=${theme.config?.sidebar?.profile?.social_media}"
    th:remove="tag"
  >
    <!-- ================= ① 身份卡 =================
         ⚠️ 本页 cfg = theme.config?.extendPages?.about（页面级作用域），
         所以「在线状态」等侧栏配置项**不能**写 cfg?.sidebar?.…（永远为 null，
         1.4.90 正是踩了这条 ⇒ 状态胶囊恒不渲染），必须走完整路径
         theme.config?.sidebar?.profile?.statusSettings（同 socials 的写法）。 -->
    <section
      class="card-base about-hero-card onload-animation mb-4"
      th:with="ident=${cfg?.identity},
        sts=${theme.config?.sidebar?.profile?.statusSettings},
        hasPrimary=${!#strings.isEmpty(ident?.actionPrimaryLabel) and !#strings.isEmpty(ident?.actionPrimaryUrl)},
        hasSecondary=${!#strings.isEmpty(ident?.actionSecondaryLabel) and !#strings.isEmpty(ident?.actionSecondaryUrl)}"
    >
      <div class="relative z-1 flex flex-col gap-5 sm:flex-row sm:items-center">
        <span class="about-avatar" th:if="${!#strings.isEmpty(ident?.avatar)}">
          <img
            class="about-avatar__image"
            th:src="${ident?.avatar}"
            th:alt="${ident?.name ?: site.title}"
            src=""
            alt="avatar"
          />
        </span>
        <div class="min-w-0 flex-1">
          <h1
            class="about-name text-90"
            th:text="${#strings.defaultString(ident?.name, site.title)}"
          >
            关于我
          </h1>
          <p
            class="about-roles"
            th:if="${!#strings.isEmpty(ident?.roles)}"
            th:text="${ident?.roles}"
          >
            身份
          </p>
          <p
            class="about-tagline text-75"
            th:if="${!#strings.isEmpty(ident?.tagline)}"
            th:text="${ident?.tagline}"
          >
