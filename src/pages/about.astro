        <span
          class="icon-[material-symbols--rss-feed-rounded] about-ico"
          aria-hidden="true"></span>
        <span
          th:text="${#strings.defaultString(cfg?.nav?.friendsLabel, '朋友圈')}"
          >朋友圈</span
        >
      </a>
    </nav>

    <!-- ================= ③ 两栏正文 ================= -->
    <div class="about-cols-wrap">
      <div class="about-cols">
        <!-- ---------- 主列 ---------- -->
        <div class="about-col-main">
          <!-- 关于我 -->
          <section class="card-base onload-animation">
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="about-section-label">
                  <span
                    class="icon-[material-symbols--menu-book-rounded]"
                    aria-hidden="true"></span>
                  <span>ABOUT ME</span>
                </p>
                <h2 class="about-card-title mt-1 text-90">关于我</h2>
              </div>
              <span
                class="about-card-meta"
                th:if="${!#strings.isEmpty(cfg?.identity?.introSubtitle)}"
                th:text="${cfg?.identity?.introSubtitle}">公开 · 持续更新</span
              >
            </div>
            <blockquote
              class="about-quote text-75"
              th:if="${!#strings.isEmpty(cfg?.identity?.quote)}"
              th:text="${cfg?.identity?.quote}"
            >
              引语
            </blockquote>
            <div
              class="about-paragraphs"
              th:if="${!#strings.isEmpty(cfg?.identity?.intro)}"
              th:data-lines="${cfg?.identity?.intro}"
              data-lines-render="paragraphs"
            >
            </div>
          </section>

          <!-- 本人项目 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.projects?.items != null and !#lists.isEmpty(cfg?.projects?.items)}"
          >
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="about-section-label">
                  <span
                    class="icon-[material-symbols--widgets-outline-rounded]"
                    aria-hidden="true"></span>
                  <span>MY PROJECTS</span>
                </p>
                <h2 class="about-card-title mt-1 text-90">本人项目</h2>
              </div>
              <a
                class="about-section-link"
                th:if="${!#strings.isEmpty(cfg?.projects?.moreUrl)}"
                th:href="${cfg?.projects?.moreUrl}"
              >
                <span
                  th:text="${#strings.defaultString(cfg?.projects?.moreLabel, '全部项目 →')}"
                  >全部项目 →</span
                >
              </a>
            </div>
            <div class="about-proj-grid">
              <!-- 图标留空时按序号轮换，避免整列卡片图标雷同；填了 icon 则以填的为准。
                   ⚠️ 这里刻意不用内联列表 / 拼接类名：Thymeleaf 的 ${} 里放 {} 会截断表达式，
                   Tailwind 也不会为拼出来的类名生成 CSS。就写死几个字面量三元。 -->
              <a
                class="about-proj"
                th:each="p, pst : ${cfg?.projects?.items}"
                th:with="pIcon=${!#strings.isEmpty(p?.icon)
                  ? p?.icon
                  : (pst.index == 0 ? 'icon-[material-symbols--terminal-rounded]'
                    : (pst.index == 1 ? 'icon-[material-symbols--database]'
                      : (pst.index == 2 ? 'icon-[material-symbols--menu-book-rounded]'
                        : (pst.index == 3 ? 'icon-[material-symbols--widgets-outline-rounded]'
                          : 'icon-[material-symbols--bolt-rounded]'))))}"
                th:classappend="${!#strings.isEmpty(p?.tone) ? ' is-' + p?.tone : ''}"
                th:href="${!#strings.isEmpty(p?.link) ? p?.link : null}"
                th:target="${!#strings.isEmpty(p?.link) ? '_blank' : null}"
                rel="noopener noreferrer"
              >
                <span class="about-proj__icon">
                  <span th:class="${pIcon}" aria-hidden="true"></span>
                </span>
                <span class="about-proj__body">
                  <strong class="about-proj__title" th:text="${p?.title}"
                    >项目名</strong
                  >
                  <span
                    class="about-proj__desc"
                    th:if="${!#strings.isEmpty(p?.description)}"
                    th:text="${p?.description}">说明</span
                  >
                  <span
                    class="about-proj__tech"
                    th:if="${!#strings.isEmpty(p?.tags)}"
                    th:data-lines="${p?.tags}"
                    data-lines-render="projTech"></span>
                </span>
                <span
                  class="about-proj__arrow icon-[material-symbols--arrow-outward-rounded]"
                  aria-hidden="true"></span>
              </a>
            </div>
          </section>

          <!-- 更新摘要 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.highlights?.items != null and !#lists.isEmpty(cfg?.highlights?.items)}"
          >
            <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
              <div>
                <p class="about-section-label">
                  <span
                    class="icon-[material-symbols--update-rounded]"
                    aria-hidden="true"></span>
                  <span>LATEST CHANGES</span>
                </p>
                <h2 class="about-card-title mt-1 text-90">更新摘要</h2>
              </div>
              <a
                class="about-section-link"
                th:if="${!#strings.isEmpty(cfg?.highlights?.moreUrl)}"
                th:href="${cfg?.highlights?.moreUrl}"
              >
                <span
                  th:text="${#strings.defaultString(cfg?.highlights?.moreLabel, '按日查看 →')}"
                  >按日查看 →</span
                >
              </a>
            </div>
            <div class="about-tile-list">
              <!-- 同「本人项目」：留空按序号轮换，和左边那张卡的图标序列不重叠 -->
              <a
                class="about-tile"
                th:each="h, hst : ${cfg?.highlights?.items}"
                th:with="hIcon=${!#strings.isEmpty(h?.icon)
                  ? h?.icon
                  : (hst.index == 0 ? 'icon-[material-symbols--history-rounded]'
                    : (hst.index == 1 ? 'icon-[material-symbols--update-rounded]'
                      : (hst.index == 2 ? 'icon-[material-symbols--edit-note-rounded]'
                        : 'icon-[material-symbols--auto-awesome-rounded]')))}"
                th:classappend="${!#strings.isEmpty(h?.tone) ? ' is-' + h?.tone : ''}"
                th:href="${!#strings.isEmpty(h?.link) ? h?.link : null}"
                th:target="${!#strings.isEmpty(h?.link) ? '_blank' : null}"
                rel="noopener noreferrer"
              >
                <span class="about-tile__icon">
                  <span th:class="${hIcon}" aria-hidden="true"></span>
                </span>
                <span class="about-tile__body">
                  <strong class="about-tile__title" th:text="${h?.title}"
                    >标题</strong
                  >
                  <span
                    class="about-tile__desc"
                    th:if="${!#strings.isEmpty(h?.description)}"
                    th:text="${h?.description}">说明</span
                  >
                  <span
                    class="about-chip-list"
                    th:if="${(!#strings.isEmpty(h?.version)) or (!#strings.isEmpty(h?.tags))}"
                    th:data-lines="${h?.tags}"
                    data-lines-render="chips"
                  >
                    <span
                      class="about-chip"
                      th:if="${!#strings.isEmpty(h?.version)}"
                      th:text="${h?.version}">v0.0.0</span
                    >
                  </span>
                </span>
                <span
                  class="about-tile__arrow icon-[material-symbols--arrow-outward-rounded]"
                  aria-hidden="true"></span>
              </a>
            </div>
          </section>

          <!-- 最近的提交：数据 = 最新文章 + 最新瞬间（服务端直出，无 JS 也完整可见）
               瞬间的 spec.content.raw 是富文本 HTML，先剥标签再当纯文本用；
               超长交给 .about-activity-link 的单行省略号收尾，不做裁剪。
               行上的 data-time 供客户端把两组归并成一条时间线。 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.activity?.enable != false and (aboutPostCount + aboutMomentCount) > 0}"
          >
            <div class="mb-5">
              <p class="about-section-label">
                <span
                  class="icon-[material-symbols--history-rounded]"
                  aria-hidden="true"></span>
                <span>RECENT ACTIVITY</span>
              </p>
              <h2 class="about-card-title mt-1 text-90">最近的提交</h2>
              <p
                class="about-card-meta mt-1"
                th:if="${!#strings.isEmpty(cfg?.activity?.subtitle)}"
                th:text="${cfg?.activity?.subtitle}"
              >
                写下来的，才会留下
              </p>
            </div>
            <ul class="about-activity-list" data-activity-timeline>
              <li
                class="about-activity"
                th:each="p : ${aboutPosts}"
                th:data-time="${p?.spec?.publishTime}"
              >
                <span class="about-activity-marker" aria-hidden="true"></span>
                <span class="about-activity-kind">文章</span>
                <a
                  class="about-activity-link"
                  th:href="@{${p?.status?.permalink}}"
                  th:text="${p?.spec?.title}">标题</a
                >
                <span
                  class="about-activity-arrow icon-[material-symbols--arrow-outward-rounded]"
                  aria-hidden="true"></span>
              </li>
              <li
                class="about-activity"
                th:each="m : ${aboutMoments}"
                th:with="momentText=${m?.spec?.content?.raw != null
                    ? m?.spec?.content?.raw.replaceAll('<[^>]*>', ' ').trim()
                    : ''},
                  momentLabel=${#strings.defaultString(momentText, '分享了一条瞬间')}"
                th:data-time="${m?.spec?.releaseTime}"
              >
                <span class="about-activity-marker" aria-hidden="true"></span>
                <span class="about-activity-kind">瞬间</span>
                <a
                  class="about-activity-link"
                  th:href="@{/moments/{name}(name=${m?.metadata?.name})}"
                  th:text="${momentLabel}">内容</a
                >
                <span
                  class="about-activity-arrow icon-[material-symbols--arrow-outward-rounded]"
                  aria-hidden="true"></span>
              </li>
            </ul>
          </section>
        </div>

        <!-- ---------- 侧列 ---------- -->
        <div class="about-col-side">
          <!-- 技术轨迹 -->
          <section
            class="card-base onload-animation"
            th:if="${!#strings.isEmpty(cfg?.identity?.trajectory)}"
          >
            <div class="about-card-head">
              <span class="about-head-icon">
                <span
                  class="icon-[material-symbols--terminal-rounded]"
                  aria-hidden="true"></span>
              </span>
              <h2 class="about-card-title text-90">技术轨迹</h2>
            </div>
            <div
              class="about-tag-list"
              th:data-lines="${cfg?.identity?.trajectory}"
              data-lines-render="stackTags"
            >
            </div>
            <p class="mt-3 text-xs text-50">
              工具会变化，解决问题的方式会留下。
            </p>
          </section>

          <!-- 我的朋友（数据取自本站友情链接，可随机）
               2026-09-13：由「文字胶囊网格」改版为「带头像的卡片墙」，
               并从「技术轨迹」上方移到下方（LQ 要求：技术轨迹卡片下面）。
               形态：圆形 logo + 名称 + 单行描述，两列网格。
               数据源：Links 插件的 linkFinder.groupBy()（服务端全量渲染，
               客户端洗牌后截前 N）。

               🔴🔴 1.4.84 修正：groups 已在上方页面顶层 th:with 里定义
               （linkFinder.groupBy() + url 过滤），这里直接用即可。
               **不要**在本 section 上再叠 th:with + th:if —— th:if(3)
               先于 th:with(4) 执行，同元素上 th:if 读不到 th:with 的变量
               （1.4.83 正是这样修坏的）。 -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.friends?.enable != false and groups != null and !#lists.isEmpty(groups)}"
          >
            <div class="about-card-head">
              <span class="about-head-icon">
                <span
                  class="icon-[material-symbols--group-rounded]"
                  aria-hidden="true"></span>
              </span>
              <h2 class="about-card-title text-90">我的朋友</h2>
            </div>
            <!-- 友链卡片：服务端全量渲染本站友情链接，客户端按「每次刷新随机排序」
                 洗牌后截前 N（extend-pages.js 的 shuffleFriends）。无 JS 时按服务端
                 顺序完整展示，功能不缺失。 -->
            <div
              class="about-friends"
              th:data-shuffle="${cfg?.friends?.shuffle != false ? 'true' : null}"
              th:data-count="${cfg?.friends?.count != null ? cfg?.friends?.count : 6}"
            >
              <div th:each="g : ${groups}" th:remove="tag">
                <!-- aboutLogoOk 口径与页脚友链一致：logo 非空且是 http / // / / 开头 -->
                <a
                  class="about-friend"
                  th:each="l : ${g?.links}"
                  th:with="aboutLogoOk = ${l?.spec?.logo != null and (l?.spec?.logo.startsWith('http') or l?.spec?.logo.startsWith('//') or l?.spec?.logo.startsWith('/'))}"
                  th:href="${l?.spec?.url != null and (l?.spec?.url.startsWith('http') or l?.spec?.url.startsWith('//') or l?.spec?.url.startsWith('/')) ? l?.spec?.url : null}"
                  th:title="${#strings.defaultString(l?.spec?.description, l?.spec?.displayName)}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <img
                    th:if="${aboutLogoOk}"
                    th:src="${l?.spec?.logo}"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="about-friend-logo"
                  />
                  <span th:unless="${aboutLogoOk}" class="about-friend-logo-ph">
                    <span
                      class="icon-[material-symbols--link-rounded]"
                      aria-hidden="true"></span>
                  </span>
                  <span class="about-friend-body">
                    <span
                      class="about-friend-name"
                      th:text="${l?.spec?.displayName}">链接</span
                    >
                    <span
                      class="about-friend-desc"
                      th:if="${!#strings.isEmpty(l?.spec?.description)}"
                      th:text="${l?.spec?.description}"></span>
                  </span>
                </a>
              </div>
            </div>
            <p
              class="mt-3 text-xs text-50"
              th:if="${!#strings.isEmpty(cfg?.friends?.note)}"
              th:text="${cfg?.friends?.note}"
            >
              各自折腾，互相串门。
            </p>
          </section>

          <!-- 保持联系：数据 = 侧栏「个人简介小组件 → 社交媒体」
               （social_icon 是 $formkit: iconify + format: svg ⇒ 值是一整段内联 SVG，
               必须用 th:utext 注入，不能走 th:class —— 见 Profile.astro / Footer.astro） -->
          <section
            class="card-base onload-animation"
            th:if="${cfg?.friends?.contactEnable != false and socials != null and !#lists.isEmpty(socials)}"
          >
            <div class="about-card-head">
              <span class="about-head-icon">
                <span
                  class="icon-[material-symbols--alternate-email-rounded]"
                  aria-hidden="true"></span>
              </span>
              <h2 class="about-card-title text-90">保持联系</h2>
            </div>
            <div class="about-connect-list">
              <a
                class="about-connect"
                th:each="social : ${socials}"
                th:href="${social.url}"
                th:title="${social.name}"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="about-connect-icon"
                  th:utext="${social.social_icon?.value}"
                  aria-hidden="true"></span>
                <span th:text="${social.name}">名称</span>
                <span
                  class="about-connect-arrow icon-[material-symbols--arrow-outward-rounded]"
                  aria-hidden="true"></span>
              </a>
            </div>
            <p class="about-card-foot">欢迎来串门，一起交流。</p>
          </section>
        </div>
      </div>
    </div>

    <!-- ================= ④ 页脚卡 ================= -->
    <!-- 页脚链接走结构化设置（主题设置 → 关于我 → 页脚 → 页脚链接，名称 + 链接两栏），
         不再用「名称|链接」的多行文本 —— 名称位置填成 URL 那种误用就此消失。 -->
    <section
      class="card-base about-footer-card onload-animation mb-4"
      th:if="${(!#strings.isEmpty(cfg?.footer?.motto)) or (cfg?.footer?.linkItems != null and !#lists.isEmpty(cfg?.footer?.linkItems))}"
    >
      <div class="min-w-0">
        <p
          class="about-section-label"
          th:if="${!#strings.isEmpty(cfg?.footer?.eyebrow)}"
          th:text="${cfg?.footer?.eyebrow}"
        >
          OPEN SOURCE, OPEN CHANNEL
        </p>
        <p
          class="about-footer-motto"
          th:if="${!#strings.isEmpty(cfg?.footer?.motto)}"
          th:text="${cfg?.footer?.motto}"
        >
          页脚一句话
        </p>
      </div>
      <div
        class="about-footer-links"
        th:if="${cfg?.footer?.linkItems != null and !#lists.isEmpty(cfg?.footer?.linkItems)}"
      >
        <a
          th:each="fl : ${cfg?.footer?.linkItems}"
          th:href="${!#strings.isEmpty(fl?.url) ? fl?.url : null}"
          th:target="${!#strings.isEmpty(fl?.url) ? '_blank' : null}"
          rel="noopener noreferrer"
          th:text="${#strings.defaultString(fl?.label, fl?.url)}">链接</a
        >
      </div>
    </section>
  </div>

  <!-- 多行字段渲染（正文 / 项目技术栈 / 标签）+ 友链随机
       + 「最近的提交」两组数据归并排序 -->
  <script
    is:inline
    src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/extend-pages.js?v=${ASSET_VERSION}`}
    defer></script>
</MainGridLayout>
