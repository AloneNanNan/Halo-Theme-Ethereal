            </span>
            <span th:case="away" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--cloud-fill] text-neutral-400 status-drift"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.away) ? sts?.away : '暂时离开'}"
                >暂时离开</span
              >
            </span>
            <!-- 在线（默认分支） -->
            <span th:case="*" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--leaf-fill] text-green-500 status-pulse"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.online) ? sts?.online : '在线中'}"
                >在线中</span
              >
            </span>
          </button>
          <p
            class="about-status"
            th:if="${(sts == null or sts?.enable == false) and !#strings.isEmpty(ident?.status)}"
          >
            <span
              class="icon-[material-symbols--bolt-rounded] about-ico"
              aria-hidden="true"></span>
            <span th:text="${ident?.status}">状态</span>
          </p>
        </div>

        <div class="about-hero-actions" th:if="${hasPrimary or hasSecondary}">
          <a
