      }
      .about-footer-links > a:hover,
      .about-footer-links > a:focus-visible {
        border-color: var(--primary);
        background: color-mix(in srgb, var(--primary) 10%, var(--card-bg));
        outline: none;
      }

      /* ================= ⑱ 窄屏档 = 参考站 ≤640px 那一组 ================= */
      @media (max-width: 640px) {
        .about-cols {
          gap: 0.75rem;
        }
        .about-hero-card {
          padding: 1rem;
