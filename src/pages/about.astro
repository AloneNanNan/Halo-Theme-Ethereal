          </p>
          <!-- 状态：1.4.90 起优先绑定主题「在线状态」statusSettings（与侧栏头像卡
               同源，点击同样弹出切换模态框，由 profile-status.ts 委托处理）；
               未启用 / 未配置时回退 ident.status 静态文案（闪电图标行）。
               图标/动效/配色类与 Profile.astro 的 th:case 分支逐字面量一致
               （Tailwind 只认完整字面量 + 空白分隔，别运行时拼类名）。 -->
          <button
            type="button"
            class="about-status about-status-pill"
            th:if="${sts != null and sts?.enable != false}"
            th:attr="data-status=${sts?.status ?: 'online'}"
            th:switch="${sts?.status ?: 'online'}"
            aria-label="切换当前状态"
          >
            <span th:case="energetic" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--sun-fill] text-amber-500 status-spin"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.energetic) ? sts?.energetic : '元气满满'}"
                >元气满满</span
              >
            </span>
            <span th:case="emo" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--sad-fill] text-violet-400 status-float"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.emo) ? sts?.emo : 'emo中'}"
                >emo中</span
              >
            </span>
            <span th:case="study" class="about-status-item">
              <span
                class="about-status-ico icon-[mingcute--book-2-fill] text-sky-500 status-drift"
              ></span>
              <span
                class="about-status-text"
                th:text="${!#strings.isEmpty(sts?.study) ? sts?.study : '学习中'}"
