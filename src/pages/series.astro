---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PageHeader from "../components/control/PageHeader.astro";
---

<!--
  系列页面模板（Halo 自定义页面「系列」）。
  数据来自配套插件 ethereal-companion 的 recentCommentsSeriesFinder：插件读取文章的
  series / seriesOrder 注解，聚合为「系列 → 文章列表」。
  插件未安装时用 pluginFinder.available 守卫短路为 null，只渲染空态，绝不崩页
  （⚠️ 直接调 Finder 而不加守卫，插件缺失时会抛异常、整个容器被跳过）。
  注：canonical 由 Halo 核心自动注入，页面不自行输出。
-->
<MainGridLayout
  title="${singlePage.spec.title + ' - ' + site.title}"
  description="${singlePage.spec.excerpt.raw ?: #messages.msg('page.series.description', site.title)}"
  setOGTypeArticle={true}
>
  <div
    th:remove="tag"
    th:with="seriesList=${pluginFinder != null and pluginFinder.available('ethereal-companion') ? recentCommentsSeriesFinder.listAll() : null},
      totalPosts=${seriesList == null or #lists.isEmpty(seriesList) ? 0 : #aggregates.sum(seriesList.![posts.size()])}"
  >
    <!-- 段一：页头（主题统一标题框 PageHeader） -->
    <section class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
      <PageHeader
        containerClass="flex flex-col items-start gap-3 md:flex-row md:items-end md:justify-between"
        titleExpr="${singlePage.spec.title}"
        title="系列"
        iconClass="icon-[material-symbols--layers]"
        labelExpr="#{page.series.title}"
        label="全部系列"
        subExpr="#{page.series.subtitleCount(${totalPosts})}"
        sub="0 篇文章"
      />
    </section>

    <!-- 段二：手风琴双列网格（互斥展开，一次只开一个系列） -->
    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(20rem,1fr))] items-start gap-4 mb-4"
    >
      <div
        th:each="s, stat : ${seriesList}"
        class="series-acc card-base overflow-hidden onload-animation"
      >
        <button
          type="button"
          aria-expanded="false"
          class="series-acc-header group flex w-full items-center gap-3 p-5 md:p-6 pb-3 cursor-pointer select-none text-left transition"
        >
          <span
            class="shrink-0 w-12 h-12 rounded-full bg-(--primary)/10 group-hover:bg-(--primary)/20 flex items-center justify-center transition-colors"
          >
            <span
              class="icon-[material-symbols--layers] text-2xl text-(--primary)"
              aria-hidden="true"></span>
          </span>
          <span class="flex-1 min-w-0">
            <span
              class="block text-lg font-bold text-90 truncate group-hover:text-(--primary) transition"
              th:text="${s.name}">系列名</span
            >
            <span
              class="block text-sm text-30 mt-0.5 transition group-hover:text-(--primary)/60"
              th:text="#{page.series.count(${#lists.size(s.posts)})}"
              >0 篇文章</span
            >
          </span>
          <span
            class="acc-arrow icon-[material-symbols--keyboard-arrow-down-rounded] shrink-0 text-[1.25rem] text-30 group-hover:text-(--primary) transition-transform duration-300"
            aria-hidden="true"></span>
        </button>
        <div
          class="series-acc-content overflow-hidden max-h-0 transition-[max-height,opacity] duration-300 ease-in-out"
        >
          <ol class="flex flex-col px-5 md:px-6 pb-4">
            <li th:each="p, pstat : ${s.posts}">
              <a
                th:href="@{${p.permalink}}"
                class="group flex items-center gap-3 px-3 py-3 -mx-1 rounded-lg transition-all hover:bg-black/5 dark:hover:bg-white/5 active:scale-[0.98] border-b border-dashed border-(--line-divider)"
              >
                <span
                  class="shrink-0 w-6 h-6 rounded-md bg-(--enter-btn-bg) text-(--primary) flex items-center justify-center text-sm font-bold transition"
                  th:text="${p.order != null ? p.order : pstat.count}">1</span
                >
                <span
                  class="flex-1 min-w-0 font-bold text-sm text-black/75 dark:text-white/75 truncate transition group-hover:text-(--primary)"
                  th:text="${p.title}">文章标题</span
                >
                <span
                  class="icon-[material-symbols--chevron-right-rounded] shrink-0 text-xl text-black/15 dark:text-white/15 transition group-hover:text-(--primary) group-hover:translate-x-0.5"
                  aria-hidden="true"></span>
              </a>
            </li>
          </ol>
        </div>
      </div>

      <!-- 空态（含插件未安装） -->
      <div
        th:if="${#lists.isEmpty(seriesList)}"
        class="card-base px-8 py-12 text-center col-span-full"
      >
        <p class="text-30 text-sm" th:text="#{page.series.empty}">暂无系列</p>
      </div>
    </div>
  </div>

  <style is:global>
    /* ── 系列手风琴 ── */
    .series-acc-header[aria-expanded="true"] .acc-arrow {
      transform: rotate(180deg);
    }
    .series-acc-content {
      opacity: 0;
    }
    .series-acc-content[data-open="true"] {
      opacity: 1;
    }
  </style>

  <script is:inline>
    function onSeriesAccordion(e) {
      var btn =
        e.target && e.target.closest
          ? e.target.closest(".series-acc-header")
          : null;
      if (!btn) return;
      var card = btn.closest(".series-acc");
      var content = card ? card.querySelector(".series-acc-content") : null;
      if (!content) return;
      var isOpen = btn.getAttribute("aria-expanded") === "true";
      // 互斥：收起其它已展开的系列
      var others = document.querySelectorAll(
        '.series-acc-header[aria-expanded="true"]',
      );
      for (var i = 0; i < others.length; i++) {
        var o = others[i];
        if (o === btn) continue;
        o.setAttribute("aria-expanded", "false");
        var oc = o.closest(".series-acc");
        var ocC = oc ? oc.querySelector(".series-acc-content") : null;
        if (ocC) {
          ocC.setAttribute("data-open", "false");
          ocC.style.maxHeight = "0px";
        }
      }
      var next = !isOpen;
      btn.setAttribute("aria-expanded", String(next));
      content.setAttribute("data-open", String(next));
      content.style.maxHeight = next ? content.scrollHeight + "px" : "0px";
    }
    window.__seriesAccordionInit ||
      ((window.__seriesAccordionInit = true),
      document.addEventListener("click", onSeriesAccordion));
  </script>
</MainGridLayout>
