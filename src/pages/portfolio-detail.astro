---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="${project.title + ' - ' + (projectFinder.setting().seoTitle ?: #messages.msg('page.portfolio.seoTitle')) + ' - ' + site.title}"
  description="#{page.portfolioDetail.description(${site.title}, ${project.title})}"
>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <div
    th:remove="tag"
    th:with="platformLabels=${projectFinder.platformLabels()},
             typeLabels=${projectFinder.typeLabels()},
             content=${projectFinder.renderContent(project)}"
  >
    <article class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
      <!-- 头部：标签 + 标题 + 元信息 -->
      <header class="mb-8">
        <!-- 标题行：标题与推荐徽章同排（徽章贴标题文字右侧）
             标题 flex-1 + min-w-0 ⇒ 长标题在自身内部换行、徽章始终留在同一行右侧；
             mb-3 从 h1 移到本行容器上；h1 的 before 装饰竖线仍以本容器为包含块（relative），位置不变。
             推荐徽章是权重标识、不属于「分类」，故不并入下方分类区。 -->
        <div class="relative mb-3 flex flex-wrap items-center gap-x-3 gap-y-2">
          <h1
            class="min-w-0 flex-1 text-3xl font-bold text-black/90 transition before:absolute before:-left-4.5 before:top-3 before:h-5 before:rounded-md before:bg-(--primary) dark:text-white/90 md:text-[2.25rem]/[2.75rem] md:before:w-1"
            th:text="${project.title}"
          >
            Project Title
          </h1>
          <span
            th:if="${project.featured}"
            class="inline-flex shrink-0 items-center gap-1 rounded-lg bg-(--primary)/10 px-3 py-1 text-sm font-medium text-(--primary)"
          >
            <span class="icon-[material-symbols--star-rounded] text-base"
            ></span>
            <span th:text="#{page.portfolio.featured}">推荐</span>
          </span>
        </div>

        <!-- 元信息行 -->
        <div
          class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-50"
        >
          <!-- 创建日期 -->
          <div
            th:if="${not #strings.isEmpty(project.createTime)}"
            class="flex items-center"
          >
            <div class="meta-icon">
              <span
                class="icon-[material-symbols--calendar-today-outline-rounded] text-xl"
              ></span>
            </div>
            <span
              class="text-sm font-medium text-50"
              th:text="${#strings.substring(project.createTime, 0, 10)}"
              >2026-01-01</span
            >
          </div>

          <!-- 外链：结构与文章页 PostMeta 分类/标签项一致——meta-icon 方形图标 + link-lg 文字链接
               （悬浮时文字浮现圆角矩形背景高亮并变主题色），不带外链箭头；
               th:if 挂在外层 div 上，避免空 URL 时只剩一个空图标框 -->
          <div
            th:if="${not #strings.isEmpty(project.repoUrl)}"
            class="flex items-center"
          >
            <span class="meta-icon">
              <span class="icon-[material-symbols--code-rounded] text-xl"
              ></span>
            </span>
            <a
              th:href="${project.repoUrl}"
              target="_blank"
              rel="noopener noreferrer"
              class="link-lg whitespace-nowrap text-sm font-medium text-50 transition hover:text-(--primary) active:scale-95 dark:hover:text-(--primary)"
              >仓库</a
            >
          </div>
          <div
            th:if="${not #strings.isEmpty(project.demoUrl)}"
            class="flex items-center"
          >
            <span class="meta-icon">
              <span class="icon-[material-symbols--play-circle-rounded] text-xl"
              ></span>
            </span>
            <a
              th:href="${project.demoUrl}"
              target="_blank"
              rel="noopener noreferrer"
              class="link-lg whitespace-nowrap text-sm font-medium text-50 transition hover:text-(--primary) active:scale-95 dark:hover:text-(--primary)"
              >演示</a
            >
          </div>
          <div
            th:if="${not #strings.isEmpty(project.docsUrl)}"
            class="flex items-center"
          >
            <span class="meta-icon">
              <span class="icon-[material-symbols--description-rounded] text-xl"
              ></span>
            </span>
            <a
              th:href="${project.docsUrl}"
              target="_blank"
              rel="noopener noreferrer"
              class="link-lg whitespace-nowrap text-sm font-medium text-50 transition hover:text-(--primary) active:scale-95 dark:hover:text-(--primary)"
              >文档</a
            >
          </div>
        </div>

        <!-- 分类区：分类 / 技术栈 / 标签三行，行首小标题固定宽 w-13(52px)、三行左对齐成一列，
             上方一条分隔线与元信息行隔开。小标题的 pt-1.5 是为了与右侧首个 chip 的文字对齐
             （chip 自带 py-1.5 内边距），不加会顶到行首上方。
             ★ 仅展示、不做点击筛选：全部用 <span>，不生成链接、不带 hover。 -->
        <div
          th:if="${not #strings.isEmpty(project.platform) or not #strings.isEmpty(project.type) or not #lists.isEmpty(project.techStacks) or not #lists.isEmpty(project.tags)}"
          class="mt-5 flex flex-col gap-2 border-t border-black/10 pt-5 dark:border-white/10"
        >
          <!-- 分类（平台 / 类型） -->
          <div
            th:if="${not #strings.isEmpty(project.platform) or not #strings.isEmpty(project.type)}"
            class="flex items-start gap-3"
          >
            <span
              class="w-13 shrink-0 pt-1.5 text-xs font-bold text-50"
              th:text="#{page.portfolio.category}">分类</span
            >
            <span class="flex min-w-0 flex-wrap gap-2">
              <span
                th:if="${not #strings.isEmpty(project.platform)}"
                class="rounded-lg bg-(--btn-regular-bg) px-3 py-1.5 text-sm font-medium text-(--btn-content)"
                th:text="${platformLabels[project.platform] ?: project.platform}"
                >Platform</span
              >
              <span
                th:if="${not #strings.isEmpty(project.type)}"
                class="rounded-lg bg-(--btn-regular-bg) px-3 py-1.5 text-sm font-medium text-(--btn-content)"
                th:text="${typeLabels[project.type] ?: project.type}">Type</span
              >
            </span>
          </div>

          <!-- 技术栈 -->
          <div
            th:if="${not #lists.isEmpty(project.techStacks)}"
            class="flex items-start gap-3"
          >
            <span
              class="w-13 shrink-0 pt-1.5 text-xs font-bold text-50"
              th:text="#{page.portfolio.stack}">技术栈</span
            >
            <span class="flex min-w-0 flex-wrap gap-2">
              <span
                th:each="tech : ${project.techStacks}"
                class="rounded-lg bg-(--btn-regular-bg) px-3 py-1.5 text-sm font-medium text-(--btn-content)"
                th:text="${tech}">Tech</span
              >
            </span>
          </div>

          <!-- 标签 -->
          <div
            th:if="${not #lists.isEmpty(project.tags)}"
            class="flex items-start gap-3"
          >
            <span
              class="w-13 shrink-0 pt-1.5 text-xs font-bold text-50"
              th:text="#{page.portfolio.tags}">标签</span
            >
            <span class="flex min-w-0 flex-wrap gap-2">
              <span
                th:each="tag : ${project.tags}"
                class="rounded-lg bg-(--btn-regular-bg) px-3 py-1.5 text-sm font-medium text-(--btn-content)"
                th:text="${tag}">Tag</span
              >
            </span>
          </div>
        </div>
      </header>

      <!-- 封面图 -->
      <div
        th:if="${not #strings.isEmpty(project.cover)}"
        class="mb-5 overflow-hidden rounded-xl"
      >
        <img
          th:src="${project.cover}"
          th:alt="${project.title}"
          loading="eager"
          class="w-full max-h-[28rem] object-cover"
        />
      </div>

      <!-- 正文内容 -->
      <div
        th:if="${not #strings.isEmpty(content)}"
        class="prose-custom portfolio-content"
      >
        <div th:utext="${content}">Content</div>
      </div>

      <!-- 技术栈 / 标签已上移到 header 末尾的分类区（全页只保留那一处分类展示） -->
    </article>
  </div>
</MainGridLayout>

<style is:global>
  /* 正文内容样式 - 与文章页保持一致 */
  .portfolio-content {
    color: var(--content-color, inherit);
    line-height: 1.8;
  }

  .portfolio-content h1,
  .portfolio-content h2,
  .portfolio-content h3,
  .portfolio-content h4,
  .portfolio-content h5,
  .portfolio-content h6 {
    color: var(--heading-color, var(--text-90));
    font-weight: 700;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .portfolio-content h2 {
    font-size: 1.5rem;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
    padding-bottom: 0.3em;
  }

  html.dark .portfolio-content h2 {
    border-bottom-color: rgb(255 255 255 / 0.08);
  }

  .portfolio-content p {
    margin-bottom: 1em;
  }

  .portfolio-content a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .portfolio-content a:hover {
    opacity: 0.8;
  }

  .portfolio-content img {
    max-width: 100%;
    border-radius: var(--radius-large, 0.75rem);
    margin: 1.5em 0;
  }

  .portfolio-content pre {
    border-radius: var(--radius-large, 0.75rem);
    margin: 1em 0;
    overflow-x: auto;
  }

  .portfolio-content code {
    font-size: 0.875em;
  }

  .portfolio-content blockquote {
    border-left: 3px solid var(--primary);
    padding-left: 1em;
    margin: 1em 0;
    color: var(--text-50);
  }

  .portfolio-content ul,
  .portfolio-content ol {
    padding-left: 1.5em;
    margin-bottom: 1em;
  }

  .portfolio-content li {
    margin-bottom: 0.25em;
  }

  .portfolio-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
  }

  .portfolio-content th,
  .portfolio-content td {
    border: 1px solid rgb(0 0 0 / 0.1);
    padding: 0.5em 0.75em;
  }

  html.dark .portfolio-content th,
  html.dark .portfolio-content td {
    border-color: rgb(255 255 255 / 0.1);
  }

  .portfolio-content th {
    background: var(--btn-regular-bg);
    font-weight: 600;
  }
</style>
