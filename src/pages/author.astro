---
import PostList from "../components/PostList.astro";
import TaxonomyHeader from "../components/control/TaxonomyHeader.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="|#{page.author.title(${author.spec.displayName})} - ${site.title}|"
  description="#{page.author.description(${site.title}, ${author.spec.displayName})}"
>
  <!-- Halo 作者路由 /authors/{name} 提供 author（UserVo）与 posts，和标签页同构 -->
  <TaxonomyHeader
    labelExpr="#{page.author.label}"
    label="作者"
    titleExpr="${author.spec.displayName}"
    title="Author"
    descriptionExpr="${author.spec.bio}"
  />
  <PostList />
</MainGridLayout>
