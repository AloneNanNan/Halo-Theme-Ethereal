---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PageHeader from "../components/control/PageHeader.astro";
---

<MainGridLayout
  title="${singlePage.spec.title + ' - ' + site.title}"
  description="${singlePage.spec.excerpt.raw ?: #messages.msg('page.friends.description')}"
>
  <Fragment slot="head">
    <!-- 页面标题由 Layout.astro 统一输出；此处仅保留页面特有 head 内容 -->
    <style is:global>
      /* 随机钓鱼按钮：点击后鱼钩图标左右摇摆（像鱼咬钩晃动） */
      .random-fish-btn.spinning .random-fish-icon {
        animation: random-fish-swing var(--swing-duration, 0.5s) ease-in-out
          infinite alternate;
        /* 顶部为轴心，像挂在鱼线上，钩尖（下方）晃动 */
        transform-origin: top center;
      }
      @keyframes random-fish-swing {
        from {
          transform: rotate(-20deg);
        }
        to {
          transform: rotate(20deg);
        }
      }
    </style>
  </Fragment>

  <div
    th:remove="tag"
    th:with="allItems = ${theme.config?.extendPages?.friends?.fetchLimit != null ? linkFeedFinder.list({limit: theme.config?.extendPages?.friends?.fetchLimit}) : linkFeedFinder.list({limit: 20})}"
  >
    <!-- 头部卡：新版页头（modern，含图标水印） -->
    <div class="card-base page-head-card onload-animation mb-4">
      <PageHeader
        containerClass=""
        titleExpr="${singlePage.spec.title}"
        title="朋友圈"
        iconClass="icon-[tabler--aperture]"
        eyebrow="FRIENDS"
        stats={[
          {
            valueExpr: "${#lists.size(allItems.items)}",
            value: "0",
            labelExpr: "#{common.stat.feeds}",
            label: "动态",
          },
        ]}
      >
        <button
          th:if="${theme.config?.extendPages?.friends?.enable_random_fish == null || theme.config?.extendPages?.friends?.enable_random_fish}"
          type="button"
          id="random-fish-btn"
          class="random-fish-btn act-outline group w-fit active:scale-95"
          title="随机钓鱼"
          th:title="#{page.friends.randomFishTitle}"
          slot="right"
        >
          <span
            class="random-fish-icon icon-[material-symbols--phishing-outline-rounded] text-base"
          ></span>
          <span class="random-fish-label" th:text="#{page.friends.randomFish}"
            >随机钓鱼</span
          >
        </button>
      </PageHeader>
    </div>

    <!-- 内容卡：时间线列表 - 纵向时间轴布局 -->
    <section class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
      <div
        th:if="${not #lists.isEmpty(allItems.items)}"
        id="friends-timeline"
        class="friends-timeline"
        th:attr="data-batch-size=${theme.config?.extendPages?.friends?.pageSize ?: 30}"
      >
        <!-- 每条动态一个 group（日期头 + 卡片）：加载更多 / 合并以整组为
             单位增删显隐，避免「日期头孤儿」 -->
        <div
          class="friends-timeline-group"
          th:each="item, iterStat : ${allItems.items}"
        >
          <div
            th:remove="tag"
            th:with="curDate = ${item.publishedAt != null ? #dates.format(item.publishedAt, 'yyyy-MM-dd') : ''}, prevItem = ${iterStat.index > 0 ? allItems.items[iterStat.index - 1] : null}, prevDate = ${prevItem != null && prevItem.publishedAt != null ? #dates.format(prevItem.publishedAt, 'yyyy-MM-dd') : ''}"
          >
            <div
              class="friends-timeline-row"
              th:attr="data-group-author=${item.author}, data-group-date=${curDate}"
            >
              <!-- 左栏：虚线 + 圆点 -->
              <div class="friends-timeline-col-line">
                <div
                  class="friends-timeline-dot"
                  th:classappend="${iterStat.index == 0 || curDate != prevDate} ? 'friends-timeline-dot-primary' : 'friends-timeline-dot-dimmed'"
                >
                </div>
              </div>

              <!-- 右栏：日期（卡片上方）+ 卡片 -->
              <div class="friends-timeline-col-card">
                <!-- 日期文本，日期变更时才显示 -->
                <div
                  class="friends-timeline-card-date"
                  th:if="${iterStat.index == 0 || curDate != prevDate}"
                  th:text="${curDate}"
                >
                  2025-07-26
                </div>
                <article
                  class="card-base btn-card-outline rounded-xl p-5 onload-animation friends-card card-hover-lift"
                  th:style="'animation-delay: min(calc(var(--content-delay) + ' + ${iterStat.index} + ' * var(--dur-entry-step)), var(--dur-entry-max, 400ms))'"
                >
                  <!-- 头部：头像 + 昵称 / 日期时间（同瞬间动态卡片：信息列与头像两端对齐） -->
                  <div class="flex items-start gap-4">
                    <div class="relative shrink-0">
                      <img
                        th:if="${not #strings.isEmpty(item.authorLogo)}"
                        th:src="${item.authorLogo != null and (item.authorLogo.startsWith('http') or item.authorLogo.startsWith('//') or item.authorLogo.startsWith('/')) ? item.authorLogo : null}"
                        th:alt="${item.author}"
                        class="friends-avatar h-13 w-13 rounded-xl bg-(--btn-regular-bg) object-cover"
                      />
                      <div
                        th:unless="${not #strings.isEmpty(item.authorLogo)}"
                        class="flex h-13 w-13 shrink-0 items-center justify-center rounded-xl bg-(--btn-regular-bg) text-(--primary)"
                      >
                        <span
                          class="icon-[material-symbols--account-circle] text-3xl"
                        ></span>
                      </div>
                    </div>

                    <div
                      class="flex min-h-[3.25rem] min-w-0 flex-1 flex-col justify-between"
                    >
                      <a
                        href="#"
                        class="friend-author truncate text-base font-bold text-(--primary) transition hover:text-(--primary)"
                        th:attr="data-site=${item.url}"
                      >
                        <span th:text="${item.author}">Author</span>
                      </a>
                      <div
                        class="friends-item-time mt-1.5 flex flex-wrap items-center gap-2"
                      >
                        <time
                          class="inline-flex items-center gap-1 text-sm text-50"
                          th:datetime="${item.publishedAt}"
                          th:title="${item.publishedAt != null ? #dates.format(item.publishedAt, 'yyyy-MM-dd HH:mm') : null}"
                          th:text="${item.publishedAt != null ? #dates.format(item.publishedAt, 'MM-dd HH:mm') : ''}"
                          >09-21 14:30</time
                        >
                      </div>
                    </div>
                  </div>

                  <!-- 内容：桌面缩进对齐昵称、移动端全宽（同瞬间卡片的缩进轨道） -->
                  <div class="friends-card-body mt-3.5 md:ml-[4.25rem]">
                    <a
                      th:href="${item.url != null and (item.url.startsWith('http') or item.url.startsWith('//') or item.url.startsWith('/')) ? item.url : null}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="friends-item-title block line-clamp-2 text-[15px] font-semibold text-90 leading-snug transition hover:text-(--primary)"
                    >
                      <span th:text="${item.title}">Article Title</span>
                      <span
                        class="icon-[fa6-solid--arrow-up-right-from-square] ml-1 inline-block align-middle text-[10px] text-30"
                      ></span>
                    </a>
                    <div
                      th:if="${not #strings.isEmpty(item.summary)}"
                      class="friends-item-summary mt-1.5 line-clamp-2 text-[13px] leading-relaxed text-50"
                      th:text="${item.summary}"
                    >
                      Summary text here...
                    </div>
                  </div>
                </article>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 加载更多 -->
      <button
        id="friends-load-more"
        type="button"
        class="btn-regular mx-auto mt-8 hidden h-11 rounded-xl px-4 text-sm font-bold active:scale-95"
      >
        <span
          class="icon-[material-symbols--expand-circle-down-outline] mr-1.5 text-base"
        ></span>
        <span th:text="#{page.friends.loadMore}">加载更多</span>
      </button>

      <!-- 空状态 -->
      <div th:if="${#lists.isEmpty(allItems.items)}" class="py-16 text-center">
        <span class="icon-[material-symbols--inbox-rounded] text-5xl text-20"
        ></span>
        <p class="mt-4 text-sm text-50" th:text="#{page.friends.empty}">
          暂无朋友圈动态
        </p>
      </div>
    </section>

    <!-- 朋友圈脚本（I27）：由 friend-authors / group / load-more 三个脚本合并，
         置于 allItems 作用域内，列表为空时整体不加载（各脚本空列表下均无用）；
         Swup 换页由 SwupScriptsPlugin 重执行，IIFE 内守卫防重复绑定 -->
    <script
      th:if="${not #lists.isEmpty(allItems.items)}"
      src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/friends.bundle.js?v=${ASSET_VERSION}`}
      defer
      is:inline></script>
  </div>
</MainGridLayout>
