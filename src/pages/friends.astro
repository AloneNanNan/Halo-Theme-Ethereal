---
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="${singlePage.spec.title + ' - ' + site.title}"
  description="${singlePage.spec.excerpt.raw ?: #messages.msg('page.friends.description')}"
>
  <Fragment slot="head">
    <!-- 页面标题由 Layout.astro 统一输出；此处仅保留页面特有 head 内容 -->
    <style is:global>
      /* 随机钓鱼按钮：点击后鱼钩图标左右摇摆（像鱼咬钩晃动） */
      .random-fish-btn.spinning .random-fish-icon {
        animation: random-fish-swing var(--swing-duration, 0.5s) ease-in-out
          infinite alternate;
        /* 顶部为轴心，像挂在鱼线上，钩尖（下方）晃动 */
        transform-origin: top center;
      }
      @keyframes random-fish-swing {
        from {
          transform: rotate(-20deg);
        }
        to {
          transform: rotate(20deg);
        }
      }
    </style>
  </Fragment>

  <div
    th:remove="tag"
    th:with="allItems = ${theme.config?.extendPages?.friends?.fetchLimit != null ? linkFeedFinder.list({limit: theme.config?.extendPages?.friends?.fetchLimit}) : linkFeedFinder.list({limit: 20})}"
  >
    <!-- 单个白板卡片包裹全部内容 -->
    <section class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
      <!-- 页头 -->
      <div
        class="mb-8 flex flex-col items-start gap-3 md:flex-row md:items-end md:justify-between"
      >
        <div class="min-w-0">
          <h1
            class="relative mb-2 text-3xl font-bold text-90 before:absolute before:-left-4.5 before:top-3 before:h-5 before:w-1 before:rounded-md before:bg-(--primary) md:text-4xl"
            th:text="${singlePage.spec.title}"
          >
            朋友圈
          </h1>
          <div class="flex flex-wrap items-center gap-1.5 text-sm">
            <span
              class="icon-[material-symbols--groups-rounded] text-base text-(--primary)"
            ></span>
            <span
              class="font-bold text-(--primary)"
              th:text="#{page.friends.subtitle}">朋友圈</span
            >
            <span class="text-30">·</span>
            <span class="text-50" th:text="#{page.friends.description}"
              >关注博主的最新动态</span
            >
          </div>
        </div>
        <button
          th:if="${theme.config?.extendPages?.friends?.enable_random_fish == null || theme.config?.extendPages?.friends?.enable_random_fish}"
          type="button"
          id="random-fish-btn"
          class="random-fish-btn btn-regular group h-11 w-fit rounded-xl px-4 text-sm font-bold active:scale-95"
          title="随机钓鱼"
          th:title="#{page.friends.randomFishTitle}"
        >
          <span
            class="random-fish-icon icon-[material-symbols--phishing-outline-rounded] mr-1.5 text-base transition-transform group-hover:scale-110"
          ></span>
          <span class="random-fish-label" th:text="#{page.friends.randomFish}"
            >随机钓鱼</span
          >
        </button>
      </div>

      <!-- 时间线列表 - 纵向时间轴布局 -->
      <div
        th:if="${not #lists.isEmpty(allItems.items)}"
        id="friends-timeline"
        class="friends-timeline"
        th:attr="data-batch-size=${theme.config?.extendPages?.friends?.pageSize ?: 30}, data-blacklist=${theme.config?.extendPages?.friends?.blacklist ?: ''}"
      >
        <div th:remove="tag" th:each="item, iterStat : ${allItems.items}">
          <div
            th:remove="tag"
            th:with="curDate = ${item.publishedAt != null ? #dates.format(item.publishedAt, 'yyyy-MM-dd') : ''}, prevItem = ${iterStat.index > 0 ? allItems.items[iterStat.index - 1] : null}, prevDate = ${prevItem != null && prevItem.publishedAt != null ? #dates.format(prevItem.publishedAt, 'yyyy-MM-dd') : ''}"
          >
            <div
              class="friends-timeline-row"
              th:attr="data-group-author=${item.author}, data-group-date=${curDate}"
            >
              <!-- 左栏：虚线 + 圆点 -->
              <div class="friends-timeline-col-line">
                <div
                  class="friends-timeline-dot"
                  th:classappend="${iterStat.index == 0 || curDate != prevDate} ? 'friends-timeline-dot-primary' : 'friends-timeline-dot-dimmed'"
                >
                </div>
              </div>

              <!-- 右栏：日期（卡片上方）+ 卡片 -->
              <div class="friends-timeline-col-card">
                <!-- 日期文本，日期变更时才显示 -->
                <div
                  class="friends-timeline-card-date"
                  th:if="${iterStat.index == 0 || curDate != prevDate}"
                  th:text="${curDate}"
                >
                  2025-07-26
                </div>
                <article
                  class="card-base btn-card-outline rounded-xl p-5 onload-animation friends-card card-hover-lift"
                  th:style="'animation-delay: min(calc(var(--content-delay) + ' + ${iterStat.index} + ' * var(--dur-entry-step)), var(--dur-entry-max, 400ms))'"
                >
                  <div class="flex gap-4">
                    <!-- 头像 -->
                    <div class="relative shrink-0">
                      <img
                        th:if="${not #strings.isEmpty(item.authorLogo)}"
                        th:src="${item.authorLogo != null and (item.authorLogo.startsWith('http') or item.authorLogo.startsWith('//') or item.authorLogo.startsWith('/')) ? item.authorLogo : null}"
                        th:alt="${item.author}"
                        class="friends-avatar h-12 w-12 rounded-xl bg-(--btn-regular-bg) object-cover"
                      />
                      <div
                        th:unless="${not #strings.isEmpty(item.authorLogo)}"
                        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-(--btn-regular-bg) text-(--primary)"
                      >
                        <span
                          class="icon-[material-symbols--account-circle] text-[2rem]"
                        ></span>
                      </div>
                    </div>

                    <!-- 内容区 -->
                    <div class="min-w-0 flex-1">
                      <!-- 作者 + 时间 -->
                      <div
                        class="flex items-center gap-2 min-w-0 friends-item-header"
                      >
                        <a
                          href="#"
                          class="friend-author truncate text-[15px] font-semibold text-(--primary) transition hover:text-(--primary)"
                          th:attr="data-site=${item.url}"
                        >
                          <span th:text="${item.author}">Author</span>
                        </a>
                        <span class="text-30 select-none">&middot;</span>
                        <time
                          class="shrink-0 text-xs text-30"
                          th:datetime="${item.publishedAt}"
                          th:text="${item.publishedAt != null ? #dates.format(item.publishedAt, 'HH:mm') : ''}"
                          >14:30</time
                        >
                      </div>

                      <!-- 文章标题 -->
                      <a
                        th:href="${item.url != null and (item.url.startsWith('http') or item.url.startsWith('//') or item.url.startsWith('/')) ? item.url : null}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-2 block line-clamp-2 text-[15px] font-semibold text-90 leading-snug transition hover:text-(--primary) friends-item-title"
                      >
                        <span th:text="${item.title}">Article Title</span>
                        <span
                          class="icon-[fa6-solid--arrow-up-right-from-square] ml-1 inline-block align-middle text-[10px] text-30"
                        ></span>
                      </a>

                      <!-- 文章摘要 -->
                      <div
                        th:if="${not #strings.isEmpty(item.summary)}"
                        class="mt-1.5 line-clamp-2 text-[13px] leading-relaxed text-50 friends-item-summary"
                        th:text="${item.summary}"
                      >
                        Summary text here...
                      </div>

                      <!-- 来源链接 -->
                      <a
                        th:href="${item.url != null and (item.url.startsWith('http') or item.url.startsWith('//') or item.url.startsWith('/')) ? item.url : null}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="friends-source-link mt-2.5 inline-flex items-center gap-1 text-xs text-30 transition hover:text-(--primary)"
                      >
                        <span
                          class="icon-[material-symbols--link-rounded] shrink-0 text-[13px]"
                        ></span>
                        <span th:text="#{page.friends.source}">来自朋友圈</span>
                      </a>
                    </div>
                  </div>
                </article>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 加载更多 -->
      <button
        id="friends-load-more"
        type="button"
        class="btn-regular mx-auto mt-8 hidden h-11 rounded-lg px-4 text-sm font-bold active:scale-95"
      >
        <span
          class="icon-[material-symbols--expand-circle-down-outline] mr-1.5 text-base"
        ></span>
        <span th:text="#{page.friends.loadMore}">加载更多</span>
      </button>

      <!-- 空状态 -->
      <div th:if="${#lists.isEmpty(allItems.items)}" class="py-16 text-center">
        <span class="icon-[material-symbols--inbox-rounded] text-5xl text-20"
        ></span>
        <p class="mt-4 text-sm text-50" th:text="#{page.friends.empty}">
          暂无朋友圈动态
        </p>
      </div>
    </section>

    <!-- 朋友圈脚本（I27）：由原 4 个脚本合并（friend-authors/blacklist/group/load-more），
         置于 allItems 作用域内，列表为空时整体不加载（各脚本空列表下均无用）；
         Swup 换页由 SwupScriptsPlugin 重执行，IIFE 内守卫防重复绑定 -->
    <script
      th:if="${not #lists.isEmpty(allItems.items)}"
      src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/friends.bundle.js?v=${ASSET_VERSION}`}
      defer></script>
  </div>
</MainGridLayout>
