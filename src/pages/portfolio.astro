---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import FilterTabs from "../components/control/FilterTabs.astro";
import PageHeader from "../components/control/PageHeader.astro";
import PortfolioCard from "../components/PortfolioCard.astro";
---

<MainGridLayout
  title="${(projectFinder.setting().seoTitle ?: #messages.msg('page.portfolio.seoTitle')) + ' - ' + site.title}"
  description="#{page.portfolio.description(${site.title})}"
>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <div
    th:remove="tag"
    th:with="platformLabels=${projectFinder.platformLabels()},
             typeLabels=${projectFinder.typeLabels()},
             platform=${#strings.isEmpty(param.platform) ? '' : param.platform},
             type=${#strings.isEmpty(param.type) ? '' : param.type},
             projects=${projectFinder.listBy('', platform, type, '', 1, 999)}"
  >
    <section class="card-base mb-4 px-6 py-6 md:px-9 onload-animation">
      <!-- 标题区域 -->
      <PageHeader
        containerClass="mb-6 flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between"
        titleExpr="${projectFinder.setting().seoTitle ?: #messages.msg('page.portfolio.seoTitle')}"
        title="作品集"
        iconClass="icon-[material-symbols--inventory-2-rounded]"
        labelExpr="#{page.portfolio.subtitle}"
        label="我的项目"
        subExpr="#{page.portfolio.subtitleCount(${projects.total})}"
        subShowIfExpr="${projects != null}"
        sub="0 个项目"
        filteredExpr="${not #strings.isEmpty(platform) or not #strings.isEmpty(type)}"
      />

      <!-- 平台筛选 -->
      <FilterTabs
        showIfExpr="${platformLabels != null and not platformLabels.isEmpty()}"
        class="mb-4 flex flex-wrap gap-2"
        allHrefExpr="@{/portfolio(type=${type})}"
        allActiveExpr="#strings.isEmpty(platform)"
        allLabelExpr="#{page.portfolio.allPlatforms}"
        allLabel="全部平台"
        eachExpr="entry : ${platformLabels.entrySet()}"
        tabTemplate={{
          hrefExpr: "@{/portfolio(platform=${entry.key}, type=${type})}",
          activeExpr: "#strings.equals(platform, entry.key)",
          labelExpr: "${entry.value}",
          countExpr: "${platformCount.total}",
          withExpr:
            "platformCount=${projectFinder.listByPlatform(entry.key, 1, 1)}",
        }}
      />

      <!-- 类型筛选 -->
      <FilterTabs
        showIfExpr="${typeLabels != null and not typeLabels.isEmpty()}"
        class="mb-6 flex flex-wrap gap-2"
        allHrefExpr="@{/portfolio(platform=${platform})}"
        allActiveExpr="#strings.isEmpty(type)"
        allLabelExpr="#{page.portfolio.allTypes}"
        allLabel="全部类型"
        eachExpr="entry : ${typeLabels.entrySet()}"
        tabTemplate={{
          hrefExpr: "@{/portfolio(platform=${platform}, type=${entry.key})}",
          activeExpr: "#strings.equals(type, entry.key)",
          labelExpr: "${entry.value}",
          countExpr: "${typeCount.total}",
          withExpr: "typeCount=${projectFinder.listByType(entry.key, 1, 1)}",
        }}
      />

      <!-- 推荐项目（仅首页无筛选时展示） -->
      <div
        th:remove="tag"
        th:if="${#strings.isEmpty(platform) and #strings.isEmpty(type)}"
      >
        <div th:remove="tag" th:with="featured=${projectFinder.featured(1, 6)}">
          <div
            th:if="${featured != null and not featured.items.isEmpty()}"
            class="mb-8"
          >
            <!-- 分区标题：与友情链接页的分组标题同款（text-xl + font-bold + text-90），
                 不再另加主题色竖线/图标；「全部项目」用同一套，改动两处同步 -->
            <h2 class="mb-4 text-xl font-bold text-90">
              <span th:text="#{page.portfolio.featuredProjects}">推荐项目</span>
            </h2>
            <!-- 卡片最小宽 240px（与下方「全部项目」网格同值，改动两处同步；
                 取值范围 (226, 248] 的推导见下方注释） -->
            <div
              class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(min(240px,100%),1fr))]"
            >
              <PortfolioCard eachExpr="project, stat : ${featured.items}" />
            </div>
          </div>
        </div>
      </div>

      <!-- 项目卡片网格 -->
      <!-- 卡片最小宽 240px：列数由「网格容器宽」决定（容器 = 内容列 − 本页 section 的
           md:px-9 72px，随窗口在 482~952px 之间浮动），所以 min 必须同时满足两头，
           取值区间只有 (226, 248]：
             · min > 226px ⇒ 最宽时（容器上限 952px）不会排成 4 列（4×226+3×16=952，
               单卡被压到 226px）
             · min ≤ 248px ⇒ 容器 776px（三栏 + 视口≈1600）时仍能排 3 列
           ⚠️ 推荐项目区用同一个网格（见文件上方），改动务必两处同步。 -->
      <!-- 全部项目分区标题：与「推荐项目」同款（text-xl + font-bold + text-90）
           ⚠️ th:if 与下方网格同条件（Thymeleaf 两处无法共享），改动务必同步 -->
      <h2
        th:if="${projects != null and not projects.items.isEmpty()}"
        class="mb-4 text-xl font-bold text-90"
      >
        <span th:text="#{page.portfolio.allProjects}">全部项目</span>
      </h2>
      <div
        th:if="${projects != null and not projects.items.isEmpty()}"
        class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(min(240px,100%),1fr))]"
      >
        <PortfolioCard eachExpr="project, stat : ${projects.items}" />
      </div>

      <!-- 空状态 -->
      <div
        th:if="${projects == null or projects.items.isEmpty()}"
        class="py-16 text-center text-50"
      >
        <span
          class="icon-[material-symbols--folder-open-rounded] text-5xl text-30"
        ></span>
        <p class="mt-4 text-sm" th:text="#{page.portfolio.empty}">暂无项目</p>
        <p class="mt-1 text-xs text-30">
          <span th:text="#{page.portfolio.go}">去</span>
          <a
            th:href="@{/portfolio}"
            class="text-(--primary) hover:underline"
            th:text="#{page.portfolio.viewAll}">查看全部</a
          >
        </p>
      </div>
    </section>
  </div>
</MainGridLayout>
