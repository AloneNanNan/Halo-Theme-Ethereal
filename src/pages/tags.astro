---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PageHeader from "../components/control/PageHeader.astro";
---

<MainGridLayout
  title="|#{page.tags.title} - ${site.title}|"
  description="#{page.tags.description(${site.title})}"
>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <section class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
    <PageHeader
      containerClass="mb-6"
      titleExpr="#{page.tags.title}"
      title="标签"
      iconClass="icon-[material-symbols--tag-rounded]"
      labelExpr="#{page.tags.subtitle}"
      label="文章标签"
      sepShowIfExpr="${true}"
      subExpr="#{page.tags.subtitleCount(${#lists.size(tags)})}"
      sub="0 个标签"
      subShowIfExpr="${tags != null}"
    />
    <div class="flex flex-wrap gap-3">
      <a
        th:each="tag, stat : ${tags}"
        th:href="@{${tag.status.permalink}}"
        th:style="|animation-delay: min(calc(var(--content-delay) + ${stat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
        class="btn-regular h-10 rounded-xl px-4 text-sm font-bold active:scale-95 onload-animation card-hover-lift"
      >
        <span th:text="${tag.spec.displayName}">Tag</span>
        <span class="ml-2 opacity-70" th:text="${tag.postCount ?: 0}">0</span>
      </a>
    </div>
  </section>
</MainGridLayout>
