---
import PostMeta from "../components/PostMeta.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { imageSuffixThWith, CDN_SUFFIX_PATTERNS } from "../utils/image-suffix";

const basePath = import.meta.env.BASE_URL.replace(/\/+$/, "");
// ASSET_VERSION 由 astro.config.mjs 构建期从 theme.yaml 注入（vite.define），
// 用于替代原 `?v=${Date.now()}`——那会让浏览器每次访问都重新下载脚本（曾用于 156KB 的 post.bundle.js），
// 击穿 CDN/浏览器缓存；改为随版本号变更是稳定的缓存指纹。
---

<MainGridLayout
  title="${post.spec.title + ' - ' + site.title}"
  description="${post.status.excerpt}"
  setOGTypeArticle={true}
  showToc={true}
>
  <Fragment slot="head">
    <!-- og:title 由 Layout.astro 统一输出；此处仅保留文章特有 og 元数据 -->
    <meta property="og:description" th:content="${post.status.excerpt}" />
    <meta
      property="og:image"
      th:if="${not #strings.isEmpty(post.spec.cover)}"
      th:content="${post.spec.cover}"
    />
  </Fragment>

  <article
    class="relative mb-4 flex w-full overflow-hidden rounded-(--radius-large)"
  >
    <div
      id="post-container"
      class="card-base relative z-10 w-full px-6 pb-4 pt-6 md:px-9"
    >
      <!-- 文章摘要（始终渲染，供分享海报使用） -->
      <span
        id="post-excerpt-data"
        class="hidden"
        th:attr="data-text=${post.status.excerpt}"></span>
      <div
        class="onload-animation mb-3 flex flex-row gap-5 text-black/50 transition dark:text-white/50"
        th:if="${post.stats != null}"
      >
        <div class="flex flex-row items-center">
          <div
            class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/5 text-black/50 transition dark:bg-white/10 dark:text-white/50"
          >
            <span class="icon-[material-symbols--visibility-outline-rounded]"
            ></span>
          </div>
          <span class="text-sm" th:text="${post.stats.visit}">0</span>
        </div>
        <div class="flex flex-row items-center">
          <div
            class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/5 text-black/50 transition dark:bg-white/10 dark:text-white/50"
          >
            <span class="icon-[mdi--comment-text-outline]"></span>
          </div>
          <span class="text-sm" th:text="${post.stats.comment}">0</span>
        </div>
        <!-- 点赞：跟随后台文章操作栏"启用点赞"开关 -->
        <div
          class="flex flex-row items-center"
          th:if="${theme.config?.post?.actionBar?.like == true}"
        >
          <div
            class="mr-2 flex h-6 w-6 items-center justify-center rounded-md bg-black/5 text-black/50 transition dark:bg-white/10 dark:text-white/50"
          >
            <span class="icon-[material-symbols--favorite-outline-rounded]"
            ></span>
          </div>
          <span class="text-sm" th:text="${post.stats.upvote}">0</span>
        </div>
      </div>

      <div class="onload-animation relative">
        <h1
          class="mb-3 block w-full text-3xl font-bold text-black/90 transition before:absolute before:-left-4.5 before:top-3 before:h-5 before:rounded-md before:bg-(--primary) dark:text-white/90 md:text-[2.25rem]/[2.75rem] md:before:w-1"
          th:text="${post.spec.title}"
        >
          Post title
        </h1>
      </div>

      <div class="onload-animation">
        <PostMeta class="mb-5" />
        <div
          th:if="${not #strings.isEmpty(post.spec.cover) and theme.config?.post?.contentDisplay?.showCover != false}"
          id="post-cover"
          class="mb-5 overflow-hidden rounded-xl"
          th:with={imageSuffixThWith("p?.article_image_width ?: 1200")}
        >
          <!-- aspect-ratio 预占空间避免 CLS：封面图加载前按 16/9 预留高度，
               max-h-112 保留原上限，两者结合不会发生布局跳动 -->
          <img
            th:src="|${post.spec.cover}${suffix}|"
            th:alt="${post.spec.title}"
            fetchpriority="high"
            decoding="async"
            class="aspect-[16/9] w-full max-h-112 object-cover"
          />
        </div>
      </div>

      {/* 文章摘要 */}
      <div
        th:if="${theme.config?.post?.summary != null and theme.config?.post?.summary?.enable_summary != false and post.status.excerpt != null and !#strings.isEmpty(post.status.excerpt)}"
        class="onload-animation"
      >
        <div class="summary-box">
          <div
            class="summary-header"
            th:if="${theme.config?.post?.summary != null and theme.config?.post?.summary?.summary_title != null and !#strings.isEmpty(theme.config?.post?.summary?.summary_title)}"
          >
            <span class="icon-[mdi--text-box-outline] summary-icon"></span>
            <span th:text="${theme.config?.post?.summary?.summary_title}"
              >文章摘要</span
            >
          </div>
          <div class="summary-content">
            <span id="summary-text" th:data-text="${post.status.excerpt}"
            ></span><span
              id="summary-caret"
              th:if="${theme.config?.post?.summary == null or theme.config?.post?.summary?.summaryEffect == null or theme.config?.post?.summary?.summaryEffect != 'drop'}"
              class="summary-caret">|</span
            >
          </div>
        </div>
      </div>

      <!-- provider = halo 或 none：直接渲染，Halo 内核自行处理内容图片 -->
      <div
        th:if="${theme.config?.performance?.imageProcessing?.provider == 'halo' or theme.config?.performance?.imageProcessing?.provider == 'none'}"
        id="content"
        class="custom-md markdown-content onload-animation prose prose-base mb-6 max-w-none! dark:prose-invert!"
        th:classappend="| ${theme.config?.post?.contentDisplay?.content_size} ${theme.config?.post?.contentDisplay?.content_theme}|"
        th:utext="${post.content.content}"
      >
      </div>

      <!-- provider = CDN：用 <template> 包裹避免浏览器预加载扫描器触发双重加载 -->
      <template
        th:if="${theme.config?.performance?.imageProcessing?.provider != 'halo' and theme.config?.performance?.imageProcessing?.provider != 'none'}"
        id="content-template"
      >
        <div
          id="content"
          class="custom-md markdown-content onload-animation prose prose-base mb-6 max-w-none! dark:prose-invert!"
          th:classappend="| ${theme.config?.post?.contentDisplay?.content_size} ${theme.config?.post?.contentDisplay?.content_theme}|"
          th:utext="${post.content.content}"
        >
        </div>
      </template>
      <div
        th:if="${theme.config?.performance?.imageProcessing?.provider != 'halo' and theme.config?.performance?.imageProcessing?.provider != 'none'}"
        id="content-placeholder"
        class="min-h-[30vh]"
      >
        <!-- 无 JS 降级：禁用脚本时直接渲染正文（图片不拼 CDN 参数，可用性优先）。
             正常启用 JS 时 noscript 子树不产生 DOM 元素，processAndInsert 会用模板克隆整体
             replaceWith 本占位符，因此 <template> 与 <noscript> 中重复的 id="content"
             不会同时存在于最终 DOM，无 id 冲突（全库唯一查询在 fragment 作用域内）。
             onload-animation 为纯 CSS 动画，禁用 JS 也能正常淡入。 -->
        <noscript>
          <div
            id="content"
            class="custom-md markdown-content onload-animation prose prose-base mb-6 max-w-none! dark:prose-invert!"
            th:classappend="| ${theme.config?.post?.contentDisplay?.content_size} ${theme.config?.post?.contentDisplay?.content_theme}|"
            th:utext="${post.content.content}"
          >
          </div>
        </noscript>
      </div>

      <!-- 支持与分享卡片 -->
      <div
        th:if="${theme.config?.post?.actionBar?.enable != false}"
        class="onload-animation mb-6"
      >
        <div
          class="action-share-card relative overflow-hidden rounded-xl bg-(--license-block-bg) px-6 py-5 transition"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-5">
            <!-- 左侧：心形点赞按钮 + 文案 -->
            <div class="flex flex-1 items-center gap-3 min-w-0 md:gap-4">
              <button
                id="post-like-btn"
                class="btn-card group relative flex h-11 w-11 shrink-0 items-center justify-center rounded-lg active:scale-95"
                th:classappend="${theme.config?.post?.actionBar?.like == false ? ' pointer-events-none' : ''}"
                th:attr="data-post=${post.metadata.name}"
                th:data-count="${post.stats.upvote}"
                aria-label="点赞"
                th:aria-label="#{post.like}"
              >
                <span
                  id="post-like-icon"
                  class="icon-[material-symbols--favorite-outline-rounded] text-xl text-red-400 transition group-[.liked]:icon-[material-symbols--favorite-rounded] group-[.liked]:text-red-500 group-[.liked]:scale-110"
                ></span>
                <span
                  id="post-like-count"
                  class="absolute -top-1 -right-1 hidden min-w-[1.1rem] items-center justify-center rounded-full bg-red-500 px-1 text-[0.65rem] font-bold leading-4 text-white group-[.liked]:flex"
                  th:text="${post.stats.upvote > 0 ? post.stats.upvote : ''}"
                ></span>
              </button>
              <div class="flex-1 min-w-0">
                <h3
                  class="text-base font-bold text-90 transition"
                  th:text="#{post.supportTitle}"
                >
                  支持与分享
                </h3>
                <p
                  class="mt-1 text-sm leading-relaxed text-50 transition"
                  th:text="#{post.supportDesc}"
                >
                  如果这篇文章对你有帮助，欢迎分享给更多人或者给予支持！
                </p>
              </div>
            </div>
            <!-- 右侧：分享 + 打赏按钮 -->
            <div class="flex shrink-0 items-center gap-2">
              <button
                id="post-share-btn"
                th:if="${theme.config?.post?.actionBar?.share != false}"
                data-qr-src={`${basePath}/assets/qrcode.bundle.js?v=${ASSET_VERSION}`}
                type="button"
                class="btn-regular group flex h-11 w-fit items-center justify-center rounded-xl px-4 text-sm font-bold active:scale-95"
                aria-label="分享文章"
                th:aria-label="#{post.shareTitle}"
              >
                <span
                  class="icon-[tabler--share] mr-1.5 text-base transition-transform group-hover:scale-110"
                ></span>
                <span th:text="#{post.share}">分享</span>
              </button>
              <button
                id="post-reward-btn"
                th:if="${theme.config?.post?.actionBar?.reward != false}"
                type="button"
                class="btn-regular group flex h-11 w-fit items-center justify-center rounded-xl px-4 text-sm font-bold active:scale-95"
                aria-label="打赏"
                th:aria-label="#{post.rewardTitle}"
              >
                <span
                  class="icon-[material-symbols--volunteer-activism-rounded] mr-1.5 text-base transition-transform group-hover:scale-110"
                ></span>
                <span th:text="#{post.reward}">打赏</span>
              </button>
            </div>
          </div>
        </div>
      </div>
      <div
        th:if="${theme.config?.post?.license?.enable}"
        class="license-container onload-animation relative mb-6 overflow-hidden rounded-xl bg-(--license-block-bg) px-6 py-5 transition"
      >
        <div
          class="font-bold text-black/75 transition dark:text-white/75"
          th:text="${post.spec.title}"
        >
          Post title
        </div>
        <a
          data-current-post-url
          th:href="@{${post.status.permalink}}"
          th:text="${post.status.permalink}"
          href="#"
          class="link break-all text-(--primary)">https://example.com/post</a
        >
        <div class="mt-2 flex flex-wrap gap-6">
          <div>
            <div
              class="text-sm text-black/50 transition dark:text-white/50"
              th:text="#{common.author}"
            >
              作者
            </div>
            <div
              class="line-clamp-2 text-black/75 transition dark:text-white/75"
              th:text="${post.owner.displayName}"
            >
            </div>
          </div>
          <div>
            <div
              class="text-sm text-black/50 transition dark:text-white/50"
              th:text="#{common.publishedAt}"
            >
              发布于
            </div>
            <div
              class="line-clamp-2 text-black/75 transition dark:text-white/75"
              th:text="${#dates.format(post.spec.publishTime,'yyyy-MM-dd')}"
            >
            </div>
          </div>
          <div>
            <div
              class="text-sm text-black/50 transition dark:text-white/50"
              th:text="#{common.license}"
            >
              License
            </div>
            <a
              th:href="${theme.config?.post?.license?.url}"
              target="_blank"
              rel="noopener noreferrer"
              class="link line-clamp-2 text-(--primary)"
              th:text="${theme.config?.post?.license?.name}">CC BY-NC-SA 4.0</a
            >
          </div>
        </div>
        <span
          class="icon-[fa6-brands--creative-commons] pointer-events-none absolute right-6 top-1/2 -translate-y-1/2 text-[15rem] text-black/5 transition dark:text-white/5"
        ></span>
      </div>
    </div>
  </article>

  <nav
    class="mb-4 flex w-full flex-col justify-between gap-4 overflow-hidden md:flex-row"
    th:with="postCursor = ${postFinder.cursor(post.metadata.name)}"
    aria-label="Post navigation"
  >
    <a
      th:if="${postCursor.hasPrevious()}"
      class="w-full overflow-hidden font-bold active:scale-95"
      th:href="@{${postCursor.previous.status.permalink}}"
      th:title="${postCursor.previous.spec.title}"
    >
      <div
        class="btn-card flex h-15 w-full max-w-full justify-start! gap-4 rounded-2xl px-4"
      >
        <span
          class="icon-[material-symbols--chevron-left-rounded] text-2xl! font-black text-(--primary)"
        ></span>
        <span
          class="max-w-[calc(100%-3rem)] overflow-hidden overflow-ellipsis whitespace-nowrap text-black/75 transition dark:text-white/75"
          th:text="${postCursor.previous.spec.title}"></span>
      </div>
    </a>
    <div
      th:unless="${postCursor.hasPrevious()}"
      class="btn-card h-15 w-full rounded-2xl px-4 text-30"
    >
      <span th:text="#{common.noOlderPost}">没有更早的文章</span>
    </div>
    <a
      th:if="${postCursor.hasNext()}"
      class="w-full overflow-hidden font-bold active:scale-95"
      th:href="@{${postCursor.next.status.permalink}}"
      th:title="${postCursor.next.spec.title}"
    >
      <div
        class="btn-card flex h-15 w-full max-w-full justify-end! gap-4 rounded-2xl px-4"
      >
        <span
          class="max-w-[calc(100%-3rem)] overflow-hidden overflow-ellipsis whitespace-nowrap text-black/75 transition dark:text-white/75"
          th:text="${postCursor.next.spec.title}"></span>
        <span
          class="icon-[material-symbols--chevron-right-rounded] text-2xl! font-black text-(--primary)"
        ></span>
      </div>
    </a>
    <div
      th:unless="${postCursor.hasNext()}"
      class="btn-card h-15 w-full rounded-2xl px-4 text-30"
    >
      <span th:text="#{common.noNewerPost}">没有更新的文章</span>
    </div>
  </nav>

  <div
    class="card-base relative z-10 w-full px-6 pb-4 pt-6 md:px-9"
    id="comment"
    th:if="${haloCommentEnabled}"
  >
    <h2
      class="mb-2 text-base font-medium text-gray-900 dark:text-slate-50"
      th:text="#{common.comment}"
    >
      评论
    </h2>
    <Fragment
      set:html={'<halo:comment group="content.halo.run" kind="Post" th:attr="name=${post.metadata.name}" />'}
    />
  </div>

  <!-- 操作栏脚本（I27）：拆分自原 post.bundle.js（155K，含 140K qrcode 库）。
       三文件按子开关独立门控；qrcode.bundle.js 仅在首次生成分享海报时由
       post-share.js 按需注入（见 post-share.js 的 loadQRCode），文章页默认负载
       从 155K 降至 ~25K。 -->
  <script
    th:if="${theme.config?.post?.actionBar?.enable != false and theme.config?.post?.actionBar?.like != false}"
    src={`${basePath}/assets/post-like.js?v=${ASSET_VERSION}`}
    defer></script>
  <script
    th:if="${theme.config?.post?.actionBar?.enable != false and theme.config?.post?.actionBar?.share != false}"
    src={`${basePath}/assets/post-share.js?v=${ASSET_VERSION}`}
    defer></script>
  <script
    th:if="${theme.config?.post?.actionBar?.enable != false and theme.config?.post?.actionBar?.reward != false}"
    src={`${basePath}/assets/post-reward.js?v=${ASSET_VERSION}`}
    defer></script>
  <script
    is:inline
    th:if="${theme.config?.post?.summary == null or theme.config?.post?.summary?.summaryEffect == null or theme.config?.post?.summary?.summaryEffect == 'typewriter'}"
  >
    // 文章摘要打字机效果
    // （修复 I24 遗留：曾有一段完全重复的代码——var timer ×2、启动 setTimeout ×2、
    //   visibilitychange 监听 ×2，双监听器会导致打字机双循环/异常）
    (function () {
      var el = document.getElementById("summary-text");
      var caret = document.getElementById("summary-caret");
      if (!el) return;
      var text = el.getAttribute("data-text") || "";
      var i = 0;
      var speed = 40;
      var timer = null;
      function type() {
        // 页面已被换出（本脚本在 swup 容器内，容器替换后 el 脱离文档）：
        // 终止打字链，避免在游离 DOM 上空跑
        if (!el.isConnected) return;
        if (i < text.length) {
          el.textContent += text.charAt(i);
          i++;
          timer = setTimeout(type, speed);
        } else {
          if (caret) caret.style.display = "none";
        }
      }
      timer = setTimeout(type, 600);
      // I24：后台标签页暂停打字（进度保留，回前台继续）
      function onVisibilityChange() {
        if (document.hidden) {
          if (timer) {
            clearTimeout(timer);
            timer = null;
          }
        } else if (!timer && i < text.length) {
          timer = setTimeout(type, speed);
        }
      }
      document.addEventListener("visibilitychange", onVisibilityChange);
      // 换页自清理：本脚本随 SwupScriptsPlugin 在每次进文章页时重执行，
      // 若不在离开时销毁，visibilitychange 监听器会逐次累积泄漏。
      // astro:before-swap 由 @swup/astro 在换出本页前分发（换入时不存在本监听器，
      // 不会误伤新页面）；astro:after-swap 兜底（el 已脱离文档才执行，同理不误伤）。
      // 注：不能用 swup:contentReplaced——Swup v3 事件名，v4 分发 swup:{hook}，从未触发。
      function destroy() {
        if (timer) {
          clearTimeout(timer);
          timer = null;
        }
        document.removeEventListener("visibilitychange", onVisibilityChange);
        document.removeEventListener("astro:before-swap", destroy);
        document.removeEventListener("astro:after-swap", onAfterSwap);
      }
      function onAfterSwap() {
        if (!el.isConnected) destroy();
      }
      document.addEventListener("astro:before-swap", destroy);
      document.addEventListener("astro:after-swap", onAfterSwap);
    })();
  </script>
  <script
    is:inline
    th:if="${theme.config?.post?.summary != null and theme.config?.post?.summary?.summaryEffect == 'drop'}"
  >
    // 文章摘要文字下坠效果：逐字从上落下，无需出场
    (function () {
      var el = document.getElementById("summary-text");
      if (!el) return;
      var text = el.getAttribute("data-text") || "";
      if (!text) return;
      var dropDelay = 40;
      el.innerHTML = "";
      var chars = text.split("");
      chars.forEach(function (ch, i) {
        var span = document.createElement("span");
        span.textContent = ch === " " ? "\u00A0" : ch;
        span.style.display = "inline-block";
        span.style.opacity = "0";
        span.style.transform = "translateY(-1.2em)";
        span.style.transition =
          "opacity 0.1s ease-out, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1)";
        el.appendChild(span);
        setTimeout(
          function () {
            span.style.opacity = "1";
            span.style.transform = "translateY(0)";
          },
          (i + 1) * dropDelay,
        );
      });
    })();
  </script>

  <!-- CDN 图片处理：<template> 阻止预加载 → JS 加参数后插入 DOM，避免双加载 -->
  <script is:inline define:vars={{ CDN_SUFFIX_PATTERNS }}>
    (function () {
      var TEMPLATE_ID = "content-template";
      var PLACEHOLDER_ID = "content-placeholder";

      function processAndInsert() {
        var template = document.getElementById(TEMPLATE_ID);
        var placeholder = document.getElementById(PLACEHOLDER_ID);
        if (!template || !placeholder) return;

        // 读取主题图片处理配置
        var provider = "none",
          imgWidth = 0,
          customFmt = "";
        var configEl = document.getElementById("theme-config");
        if (configEl) {
          try {
            var config = JSON.parse(configEl.textContent || configEl.innerText);
            var ip =
              config &&
              config.performance &&
              config.performance.imageProcessing;
            if (ip) {
              provider = ip.provider || "none";
              imgWidth = ip.article_image_width || 0;
              customFmt = ip.custom_format || "";
            }
          } catch (e) {}
        }

        // 按宽度生成 CDN 后缀（provider 映射表与 image-suffix.ts 保持同步）
        function makeSuffix(w) {
          if (provider === "custom" && customFmt)
            return customFmt.replace("{width}", String(w));
          var pattern = CDN_SUFFIX_PATTERNS[provider] || "";
          return pattern ? pattern.replace("{width}", String(w)) : "";
        }

        var suffix = imgWidth > 0 ? makeSuffix(imgWidth) : "";

        var fragment = template.content.cloneNode(true);
        var contentEl = fragment.getElementById("content");
        if (!contentEl) return;

        // 在插入 DOM 前给内容图片加上 CDN 处理参数
        if (suffix) {
          contentEl.querySelectorAll("img").forEach(function (img) {
            var src = img.getAttribute("src");
            if (src && src.indexOf("?") === -1 && src.indexOf("!/") === -1) {
              // 仅主图加 CDN 压缩后缀（默认 1920），不加 srcset：
              // srcset 会让浏览器按 sizes+DPR 选小档位图，img.naturalWidth 变小，
              // 而灯箱（content-photoswipe）按 naturalWidth 取宽高，导致灯箱
              // 打开很小。省流量诉求由下方 I2 的 loading="lazy" 覆盖。
              img.setAttribute("src", src + suffix);
            }
          });
        }

        // I2：懒加载 + 宽高占位（width/height 属性提供 aspect-ratio 提示，
        // 避免图片加载造成 CLS；与照片页 EXIF 占位先例同思路）。
        // 正文 markdown 无宽高元数据，占位用 16:9 仅为加载前的比例提示；
        // 加载完成后按真实比例（naturalWidth/naturalHeight）修正并移除占位属性，
        // 避免固定比例与正文实际图片比例不符导致变形。
        contentEl.querySelectorAll("img").forEach(function (img) {
          if (!img.getAttribute("loading")) {
            img.setAttribute("loading", "lazy");
          }
          if (!img.getAttribute("decoding")) {
            img.setAttribute("decoding", "async");
          }
          if (!img.getAttribute("width") && !img.getAttribute("height")) {
            var w = imgWidth > 0 ? imgWidth : 800;
            img.setAttribute("width", String(w));
            img.setAttribute("height", String(Math.round((w * 9) / 16)));
            img.addEventListener("load", function () {
              if (img.naturalWidth && img.naturalHeight) {
                img.style.aspectRatio =
                  img.naturalWidth + " / " + img.naturalHeight;
                img.removeAttribute("width");
                img.removeAttribute("height");
              }
            });
          }
        });

        placeholder.replaceWith(contentEl);
        template.remove();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", processAndInsert);
      } else {
        processAndInsert();
      }

      // 注：Swup 换页后的重新处理由 SwupScriptsPlugin 重执行本脚本覆盖（每次进
      // 文章页脚本都重新跑一遍并立即 processAndInsert）。原 swup:contentReplaced
      // 监听已删除——那是 Swup v3 事件名，v4 分发 swup:{hook}（如
      // swup:content:replace），该监听从未触发，且每进一次文章页就累积一个。
    })();
  </script>
</MainGridLayout>
