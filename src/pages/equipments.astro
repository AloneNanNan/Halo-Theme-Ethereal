---
import EquipmentPagination from "../components/EquipmentPagination.astro";
import FilterTabs from "../components/control/FilterTabs.astro";
import PageHeader from "../components/control/PageHeader.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="${title + ' - ' + site.title}"
  description="#{page.equipments.description(${site.title})}"
>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <section class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
    <!-- 标题区域 -->
    <PageHeader
      containerClass="mb-6 flex flex-col gap-5 xl:flex-row xl:items-end xl:justify-between"
      titleExpr="${title}"
      title="装备管理"
      iconClass="icon-[material-symbols--devices-rounded]"
      labelExpr="#{page.equipments.subtitle}"
      label="我的装备"
      subExpr="#{page.equipments.subtitleCount(${equipments.total})}"
      subShowIfExpr="${equipments != null}"
      sub="0 个装备"
      filteredExpr="${not #lists.isEmpty(param.group)}"
    />

    <!-- 分组标签 -->
    <FilterTabs
      showIfExpr="${not #lists.isEmpty(groups)}"
      allHrefExpr="@{/equipments}"
      allActiveExpr="#lists.isEmpty(param.group)"
      eachExpr="group : ${groups}"
      tabTemplate={{
        hrefExpr: "@{/equipments(group=${group.metadata.name})}",
        activeExpr: "#lists.contains(param.group, group.metadata.name)",
        labelExpr: "${group.spec.displayName}",
        countExpr: "${group.status.equipmentCount}",
      }}
    />

    <!-- 装备卡片网格（统一分页） -->
    <div
      th:if="${equipments != null and not #lists.isEmpty(equipments.items)}"
      class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(min(220px,100%),1fr))]"
    >
      <a
        th:each="equipment, equipStat : ${equipments.items}"
        th:href="${equipment.spec.url != null and (equipment.spec.url.startsWith('http') or equipment.spec.url.startsWith('//') or equipment.spec.url.startsWith('/')) ? equipment.spec.url : null}"
        th:title="${equipment.spec.displayName}"
        target="_blank"
        rel="noopener noreferrer"
        th:style="|animation-delay: min(calc(var(--content-delay) + ${equipStat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
        class="btn-card btn-card-outline group min-h-28 items-start! justify-start! gap-4 rounded-xl p-4 text-left active:scale-95 onload-animation card-hover-lift"
      >
        <!-- 封面 -->
        <div
          th:if="${not #strings.isEmpty(equipment.spec.cover)}"
          class="w-full overflow-hidden rounded-lg bg-(--btn-regular-bg) -mt-1"
        >
          <img
            th:src="${equipment.spec.cover}"
            th:alt="${equipment.spec.displayName}"
            loading="lazy"
            class="h-36 w-full object-cover transition group-hover:scale-105"
          />
        </div>
        <div class="w-full min-w-0">
          <!-- 名称+链接 -->
          <div class="flex items-start gap-2">
            <div
              class="min-w-0 flex-1 text-base font-bold text-90 transition group-hover:text-(--primary)"
            >
              <span
                class="line-clamp-2"
                th:text="${equipment.spec.displayName}"
              >
                Equipment
              </span>
            </div>
            <span
              th:if="${not #strings.isEmpty(equipment.spec.url)}"
              class="icon-[fa6-solid--arrow-up-right-from-square] mt-0.5 shrink-0 text-sm text-30 transition group-hover:text-(--primary)"
            ></span>
          </div>
          <!-- 规格 -->
          <div
            th:if="${not #strings.isEmpty(equipment.spec.specification)}"
            class="mt-1.5 text-sm font-medium text-(--primary)"
            th:text="${equipment.spec.specification}"
          >
            Specification
          </div>
          <!-- 描述 -->
          <div
            th:if="${not #strings.isEmpty(equipment.spec.description)}"
            class="mt-1 line-clamp-2 text-sm leading-6 text-50"
            th:text="${equipment.spec.description}"
          >
            Description
          </div>
        </div>
      </a>
    </div>

    <!-- 空状态 -->
    <div
      th:if="${equipments == null or #lists.isEmpty(equipments.items)}"
      class="py-16 text-center text-50"
    >
      <span
        class="icon-[material-symbols--inventory-2-rounded] text-5xl text-30"
      ></span>
      <p class="mt-4" th:text="#{page.equipments.empty}">暂无装备</p>
    </div>
  </section>

  <EquipmentPagination context="equipments" class="mb-4 onload-animation" />
</MainGridLayout>
