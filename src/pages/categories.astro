---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PageHeader from "../components/control/PageHeader.astro";
---

<MainGridLayout
  title="|#{page.categories.title} - ${site.title}|"
  description="#{page.categories.description(${site.title})}"
>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <!-- 头部卡：新版页头（modern，含图标水印）+ 内容卡分离 -->
  <div class="card-base page-head-card onload-animation mb-4">
    <PageHeader
      containerClass=""
      titleExpr="#{page.categories.title}"
      title="分类"
      iconClass="icon-[material-symbols--folder-open-outline-rounded]"
      eyebrow="CATEGORIES"
      stats={[
        {
          valueExpr: "${#lists.size(categories)}",
          value: "0",
          labelExpr: "#{common.stat.categories}",
          label: "分类",
        },
      ]}
    />
  </div>

  <!-- 内容卡：分类网格 -->
  <section class="card-base onload-animation mb-4 px-6 py-6 md:px-9">
    <div class="grid gap-3 sm:grid-cols-2">
      <a
        th:each="category, stat : ${categories}"
        th:href="@{${category.status.permalink}}"
        th:style="|animation-delay: min(calc(var(--content-delay) + ${stat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
        class="btn-card btn-card-outline group min-h-24 justify-between! rounded-2xl px-5 py-4 text-left active:scale-95 onload-animation card-hover-lift"
      >
        <div>
          <div
            class="text-xl font-bold text-90 transition group-hover:text-(--primary)"
            th:text="${category.spec.displayName}"
          >
            Category
          </div>
          <div
            class="mt-1 text-sm text-50"
            th:if="${not #strings.isEmpty(category.spec.description)}"
            th:text="${category.spec.description}"
          >
          </div>
        </div>
        <span
          class="rounded-lg bg-(--btn-regular-bg) px-2 py-1 text-sm font-bold text-(--btn-content)"
          th:text="${category.postCount ?: 0}">0</span
        >
      </a>
    </div>
  </section>
</MainGridLayout>
