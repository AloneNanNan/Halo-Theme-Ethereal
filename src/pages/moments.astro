---
import Pagination from "../components/control/Pagination.astro";
import FilterTabs from "../components/control/FilterTabs.astro";
import PageHeader from "../components/control/PageHeader.astro";
import MomentCard from "../components/MomentCard.astro";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title="${title + ' - ' + site.title}"
  description="${title + ' - ' + site.title}"
>
  <!-- 页面 <title> 由 Layout.astro 统一输出，此处不再重复定义 -->
  <!-- 头部卡：新版页头（modern，含图标水印）+ 胶囊池分组——氛围渐变由
       卡片级 .page-head-card 承载（页头与池之间无缝）；无标签时池区不渲染 -->
  <div class="card-base page-head-card onload-animation mb-4">
    <PageHeader
      containerClass=""
      titleExpr="${title}"
      title="瞬间"
      iconClass="icon-[material-symbols--bolt-outline-rounded]"
      eyebrow="MOMENTS"
      filteredExpr="${not #lists.isEmpty(param.tag)}"
      filteredClearExpr="@{/moments}"
      stats={[
        {
          valueExpr: "${moments.total}",
          value: "0",
          labelExpr: "#{common.stat.moments}",
          label: "瞬间",
        },
      ]}
    >
      <a
        th:href="@{/moments/rss.xml}"
        data-no-swup
        target="_blank"
        rel="noopener noreferrer"
        class="act-outline group w-fit active:scale-95"
        slot="right"
      >
        <span class="icon-[material-symbols--rss-feed-rounded] text-base"
        ></span>
        <span>RSS</span>
      </a>
    </PageHeader>

    <div class="px-6 pb-5 md:px-9" th:if="${not #lists.isEmpty(tags)}">
      <div class="seg-scroll">
        <div class="seg" data-filter-seg>
          <span class="seg-thumb" aria-hidden="true"></span>
          <FilterTabs
            segmented
            showIfExpr="${not #lists.isEmpty(tags)}"
            allHrefExpr="@{/moments}"
            allActiveExpr="#lists.isEmpty(param.tag)"
            eachExpr="tag : ${tags}"
            tabTemplate={{
              hrefExpr: "@{/moments(tag=${tag.name})}",
              activeExpr: "#lists.contains(param.tag, tag.name)",
              labelExpr: "${tag.name}",
              countExpr: "${tag.momentCount}",
            }}
          />
        </div>
      </div>
    </div>
  </div>

  <!-- 卡片流：一条瞬间一张独立卡（不再套大卡）——容器只负责间距与入场错峰；
       与 PostList 同款模式：flex 容器上不能挂 th:each（会整容器复制），
       用 .contents 包装层让卡片仍是容器的 flex 子项 -->
  <div class="mb-4 flex flex-col gap-4">
    <div class="contents" th:each="moment, momentStat : ${moments.items}">
      <div
        class="onload-animation"
        th:style="|animation-delay: min(calc(var(--content-delay) + ${momentStat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
      >
        <MomentCard />
      </div>
    </div>
  </div>

  <!-- 空态：独立卡片（列表为空时才渲染） -->
  <div
    th:if="${#lists.isEmpty(moments.items)}"
    class="card-base onload-animation mb-4 px-6 py-12 text-center text-50"
  >
    <span th:text="#{page.moments.empty}">暂无瞬间</span>
  </div>

  <Pagination context="moments" class="mb-4 onload-animation" />

  <!-- 点赞脚本必须写在 Layout 内（= Swup 容器内）：换页进来时由 SwupScriptsPlugin
       重执行、重新绑定按钮（脚本靠 data-upvote-bound 幂等）。写在 </MainGridLayout>
       之后会被产出到 </html> 外面、不在容器内，换页到本页时不会执行 → 点赞点不动 -->
  <script
    src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/upvote.js?v=${ASSET_VERSION}`}
    defer
    is:inline></script>

  <!-- 卡片「复制链接」（moment-copy.js，.moment-copy-btn）：同样必须在容器内，
       换页进来时才会重新绑定（脚本靠 data-copy-bound 幂等） -->
  <script
    src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/moment-copy.js?v=${ASSET_VERSION}`}
    defer
    is:inline></script>

  <!-- 胶囊池滑块（filter-seg.js）：定位 / 点击预移动 / 滚动渐隐。
       Swup 换页后由 ScriptsPlugin 重执行（脚本内 window 单例幂等） -->
  <script
    src={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/assets/filter-seg.js?v=${ASSET_VERSION}`}
    defer
    is:inline></script>
</MainGridLayout>
