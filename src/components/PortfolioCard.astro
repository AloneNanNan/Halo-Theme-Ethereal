---
// 项目集列表卡片（列表页「推荐项目」与「全部项目」共用）。
// 依赖外层 th:each 的 project / stat（stat 仅入场动画用），th:each 经 eachExpr 落在根元素上、
// 不多出包裹层，卡片在网格里仍是网格项：
//   <PortfolioCard eachExpr="project, stat : ${projects.items}" />
// platformLabels / typeLabels 来自页面顶部 th:with，勿在本组件内重调 Finder。
//
// 尺寸口径（非整数值有意对齐，别「顺手规整」）：内边距 15/18/17px、间距统一 6px、字号
// 16/13/11px（换回 p-5 / text-lg / text-sm 会头重脚松）；封面用 aspect-[2/1] 而非固定高；
// 精选卡 = 主色描边 30% + 4% 主色底（用工具类，不然压掉 @layer utilities 的 hover 底色）；
// 悬浮反馈分三层命名 group（整卡 / group/cover / group/title），卡内不挂匿名 group——
// 否则内部 group-hover: 都退化成「悬浮整卡即触发」。
interface Props {
  /** th:each 表达式，如 "project, stat : ${projects.items}" */
  eachExpr: string;
}

const { eachExpr } = Astro.props;
---

<div
  th:each={eachExpr}
  th:style="|animation-delay: min(calc(var(--content-delay) + ${stat.index} * var(--dur-entry-step)), var(--dur-entry-max, 400ms))|"
  th:classappend="${project.featured == true ? ' border-(--primary)/30 bg-(--primary)/4' : ''}"
  class="card-base btn-card-outline flex flex-col overflow-hidden onload-animation hover:bg-(--btn-card-bg-hover) active:bg-(--btn-card-bg-active) active:scale-95 card-hover-lift"
>
  <!-- 封面：aspect-[2/1] 而非固定 h-44——封面多为 GitHub OG 图（2:1、白底、图含仓库名），
       固定 176px 高在窄卡下要裁两侧（248px 卡裁 26%）且占比过高。aspect 随卡宽等比 ⇒
       2:1 图零裁切，卡窄时封面同步变矮、正文占比自然上升。 -->
  <a
    th:if="${not #strings.isEmpty(project.cover)}"
    th:href="@{/portfolio/{slug}(slug=${project.slug})}"
    class="group/cover relative block shrink-0 overflow-hidden"
  >
    <img
      th:src="${project.cover}"
      th:alt="${project.title}"
      loading="lazy"
      class="aspect-[2/1] w-full object-cover transition group-hover/cover:scale-105"
    />
    <!-- 封面悬浮反馈：30% 黑遮罩 + 居中箭头（scale-50→100 + 淡入），只在悬浮封面时出现
         （命名 group/cover，与标题 group/title 互不干扰）。箭头 text-3xl(30px)：封面约
         307×153，再大会吃掉近 1/3 高度；遮罩盒 1em×1em 不影响布局。 -->
    <div class="pointer-events-none absolute inset-0 z-10 transition group-hover/cover:bg-black/30 group-active/cover:bg-black/50"></div>
    <div class="pointer-events-none absolute inset-0 z-20 flex items-center justify-center">
      <span class="icon-[mingcute--right-fill] scale-50 text-3xl text-white opacity-0 transition group-hover/cover:scale-100 group-hover/cover:opacity-100"></span>
    </div>
  </a>
  <!-- 正文：内边距固定 15/18/17px，无封面时不再单独补顶部内边距 —— 补的 pt 与基础值
       同量，属空操作（两个 pt 工具类互相覆盖，胜负取决于 CSS 源码顺序，故已删）。 -->
  <div class="flex grow flex-col px-[1.125rem] pt-[0.9375rem] pb-[1.0625rem]">
    <!-- 标题 + 箭头：未悬浮时 opacity-0 左偏 2px，悬浮标题时滑到位（命名 group/title，与
         封面箭头互不干扰）。箭头是 flex 子项、占位固定（不用 absolute）⇒ 悬浮不重排；
         移动端无 hover，md 以上才显示、隐藏时把占位一并让出。 -->
    <a
      th:href="@{/portfolio/{slug}(slug=${project.slug})}"
      class="group/title flex items-center gap-1 text-base leading-[1.45] font-bold text-90 transition hover:text-(--primary)"
    >
      <span class="line-clamp-2" th:text="${project.title}">
        Project Title
      </span>
      <span class="icon-[mingcute--right-fill] hidden shrink-0 -translate-x-0.5 text-lg text-(--primary) opacity-0 transition group-hover/title:translate-x-0 group-hover/title:opacity-100 md:inline"></span>
    </a>
    <!-- 推荐标记 + 平台/类型标签（在标题下方）。
         推荐标记带 th:if：两处列表都只给被标了推荐的项目显示，不再区分"推荐区恒显示" -->
    <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
      <span
        th:if="${project.featured == true}"
        class="inline-flex items-center gap-0.5 rounded-md bg-(--primary)/10 px-1.5 py-px text-[0.6875rem] leading-[1.5] font-medium text-(--primary)"
      >
        <span class="icon-[material-symbols--star-rounded] text-[0.6875rem]"></span>
        <span th:text="#{page.portfolio.featured}">推荐</span>
      </span>
      <span
        th:if="${not #strings.isEmpty(project.platform)}"
        class="inline-flex items-center rounded-md bg-(--btn-regular-bg) px-1.5 py-px text-[0.6875rem] leading-[1.5] font-medium text-(--btn-content)"
        th:text="${platformLabels[project.platform] ?: project.platform}"
      >
        Platform
      </span>
      <span
        th:if="${not #strings.isEmpty(project.type)}"
        class="inline-flex items-center rounded-md bg-(--btn-regular-bg) px-1.5 py-px text-[0.6875rem] leading-[1.5] font-medium text-(--btn-content)"
        th:text="${typeLabels[project.type] ?: project.type}"
      >
        Type
      </span>
    </div>
    <!-- 摘要 -->
    <p
      th:if="${not #strings.isEmpty(project.summary)}"
      class="mt-1.5 line-clamp-2 text-[0.8125rem] leading-[1.55] text-50"
      th:text="${project.summary}"
    >
      Summary
    </p>
    <!-- 技术栈 -->
    <div
      th:if="${not #lists.isEmpty(project.techStacks)}"
      class="mt-1.5 flex flex-wrap gap-1"
    >
      <span
        th:each="tech : ${project.techStacks}"
        class="rounded-md bg-(--btn-regular-bg) px-1.5 py-px text-[0.6875rem] leading-[1.6] font-medium text-(--btn-content)"
        th:text="${tech}"
      >
        Tech
      </span>
    </div>
    <!-- 底部元信息：上分隔线 + 左更新日期 + 右外链。间距分两段别合并：上方空
         占位条 flex-1 把整条推到卡片底部（同排卡片横线等高），其 mt-3 提供横线
         上方的最小间隙。⚠️ 不要把 mt-auto 写在横线元素上——在「同排最高的卡」上
         会算成 0，横线贴到技术栈；横线自身 pt-2.5 是下方间距，顶不了上方。 -->
    <div class="mt-3 flex-1" aria-hidden="true"></div>
    <div
      th:if="${not #strings.isEmpty(project.updateTime) or not #strings.isEmpty(project.demoUrl) or not #strings.isEmpty(project.repoUrl)}"
      class="flex items-center justify-between gap-2 border-t border-black/10 pt-2.5 text-xs text-30 dark:border-white/10"
    >
      <span
        th:if="${not #strings.isEmpty(project.updateTime)}"
        th:text="${#strings.substring(project.updateTime, 0, 10)}"
      >
        2026-01-01
      </span>
      <span class="ml-auto flex shrink-0 items-center gap-2.5">
        <a
          th:if="${not #strings.isEmpty(project.repoUrl)}"
          th:href="${project.repoUrl}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-0.5 transition hover:text-(--primary)"
        >
          <span class="icon-[material-symbols--code-rounded] text-sm"></span>
          <span th:text="#{page.portfolio.repo}">仓库</span>
        </a>
        <a
          th:if="${not #strings.isEmpty(project.demoUrl)}"
          th:href="${project.demoUrl}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-0.5 transition hover:text-(--primary)"
        >
          <span class="icon-[material-symbols--play-circle-rounded] text-sm"></span>
          <span th:text="#{page.portfolio.demo}">演示</span>
        </a>
      </span>
    </div>
  </div>
</div>
