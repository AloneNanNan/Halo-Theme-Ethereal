---
// 分类导航栏：首页 → 归档 → 各分类 → 全部分类，水平滚动 pill 样式。
// 门控：由 MainGridLayout.astro 的 wrapper div 的 th:if 控制显隐。
//
// 数据来源：
// - categoryFinder.listAll() — Halo Finder API，列出所有分类
// - postFinder.list({page: 1, size: 1}).total — 总文章数
//
// 高亮方案：液态滑块（.category-liquid）用 CSS transform 滑动覆盖层，
// pill 本身不变背景色，仅切换 text color，彻底消除 transition-colors 闪烁。
// pill z-index:1 在滑块 z-index:0 上方，pill 半透明背景（6%）让滑块颜色透出。
// 滑块是滚动区的兄弟而非子级（需横跨首页/归档/更多），不受 overflow 裁剪或 mask
// 渐隐约束，故 moveLiquid 会与滚动区可见窗口求交集：半露时只铺可见段、
// 完全滚出时隐藏，避免高亮底色溢出到相邻 pill/分隔线（issue #52）。
//
// 滚动交互（initInertiaScroll）：滚轮悬停滚动区时始终劫持为横向滚动，
// 到头后吸收（不触发页面纵向滚动）；鼠标拖拽 1:1 滚动（内容跟手），
// 越界时 translateX 沿拖拽方向视觉拉伸 + 松手回弹 + 惯性滑动；
// 液块全程跟随（滚动由 scroll 事件 rAF 驱动，拉伸/回弹随 stretch 平移，
// .is-dragging 下零过渡贴手）；拖拽期间拦截一次 click 防误触导航；
// 触摸保持原生滚动。
//
// 归档页筛选：由归档页内的分类选择器（FilterTabs）承担，导航栏只在
// 各页之间恢复 permalink、不做筛选态切换（高亮按 URL pathname 匹配，
// 归档页无分类匹配时不设高亮）。
---

<div
  class="card-base category-bar onload-animation overflow-hidden p-3"
  id="category-bar"
>
  <div class="category-bar-track flex items-center gap-2">
    <a
      th:href="@{/}"
      class="category-pill shrink-0 flex items-center justify-center rounded-xl px-3 py-1.5 text-sm active:scale-95"
      data-category-name=""
      data-no-swup
      aria-label="Home"
    >
      <span class="icon-[material-symbols--home] text-lg"></span>
    </a>

    <a
      th:href="@{/archives}"
      class="category-pill shrink-0 flex items-center gap-1.5 rounded-xl px-4 py-1.5 text-sm active:scale-95"
      data-category-name="__archive__"
      data-no-swup
    >
      <span th:text="#{page.archives.title}">归档</span>
      <span
        class="pill-count"
        th:with="totalPosts = ${postFinder.list({page: 1, size: 1}).total}"
        th:text="${totalPosts}">0</span
      >
    </a>

    <div class="category-divider shrink-0" aria-hidden="true"></div>

    <!-- 拉伸层：越界橡皮筋仅作用于「液态滑块 + 可滚动 pill 区」，
         Home/归档/更多/分隔线始终静止（见 initInertiaScroll 注释）。
         三层分离保证各司其职，互不干扰：
         .category-stretch-area —— 不动基座：液块挂在此（absolute 定位基准），
            真实 rect 反馈滚动/拉伸/回弹的视觉位置，自动跟随、无补偿；
         .category-clip —— 不动裁剪窗（overflow-hidden）：拉伸中内容滑出
            滚动框即被裁掉，不会滑入固定 pill 区域（pill 底色因此无需变换）；
         .category-stretch —— transform 载体：橡皮筋平移仅作用于内容 -->
    <div
      class="category-stretch-area relative flex min-w-0 flex-1 items-center"
    >
      <span class="category-liquid" aria-hidden="true"></span>
      <div class="category-clip relative flex min-w-0 flex-1 overflow-hidden">
        <div class="category-stretch relative flex w-full min-w-0 items-center">
          <div class="category-scroll overflow-x-auto">
            <div class="category-scroll-inner flex items-center gap-2">
              <div
                class="contents"
                th:each="category : ${categoryFinder.listAll()}"
              >
                <a
                  th:href="@{${category.status.permalink}}"
                  class="category-pill shrink-0 flex items-center gap-1.5 rounded-xl px-4 py-1.5 text-sm active:scale-95"
                  th:attr="data-category-name=${category.spec.displayName}, data-category-slug=${category.spec.slug}"
                  data-no-swup
                >
                  <span th:text="${category.spec.displayName}">Category</span>
                  <span class="pill-count" th:text="${category.postCount ?: 0}"
                    >0</span
                  >
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="category-divider shrink-0" aria-hidden="true"></div>

    <a
      th:href="@{/categories}"
      class="category-pill shrink-0 flex items-center gap-1 rounded-xl px-3 py-1.5 text-sm active:scale-95"
      data-category-name="__categories__"
      data-no-swup
      aria-label="More"
    >
      <span th:text="#{common.more}">更多</span>
      <span class="icon-[material-symbols--chevron-right-rounded] text-sm"
      ></span>
    </a>
  </div>
</div>

<style is:global>
  .category-bar {
    position: relative;
  }

  .category-bar-track {
    isolation: isolate;
    position: relative;
  }

  .category-liquid {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--primary);
    border-radius: 0.75rem;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
    z-index: 0;
    pointer-events: none;
    opacity: 1;
  }

  .category-scroll {
    position: relative;
    scrollbar-width: none;
    -ms-overflow-style: none;
    --mask-fade: 1.5rem;
  }

  .category-scroll::-webkit-scrollbar {
    display: none;
  }

  .category-scroll-inner {
    width: max-content;
  }

  /* 滚轮/拖拽滚动交互（见脚本 initInertiaScroll） */
  .category-scroll {
    cursor: grab;
  }

  .category-bar.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  /* 拖拽期间液块零过渡：滚动/裁剪边缘进出均瞬时贴合、不触发 opacity 过渡，
     避免 clip 早退与恢复交替时的闪烁（拖拽结束移除 is-dragging 恢复正常过渡） */
  .category-bar.is-dragging .category-liquid {
    transition:
      transform 0s,
      width 0s,
      opacity 0s;
  }

  .category-bar.is-dragging .category-pill {
    pointer-events: none;
  }

  .category-stretch.category-stretch-spring {
    /* 回弹不再走 CSS transition：由 startSpringTrack 用 JS rAF 逐帧推进。
       若交给合成器插值，rAF 内读取的 rect 落后一帧，液块与 padding 动画
       存在一帧跟随滞后（静止 pill 高亮能被看出偏移）。标记类仅作 JS 状态 */
  }

  .category-scroll.can-scroll-left {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 calc(var(--mask-fade) + 0.5rem)
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 calc(var(--mask-fade) + 0.5rem)
    );
  }

  .category-scroll.can-scroll-right {
    -webkit-mask-image: linear-gradient(
      to right,
      #000 calc(100% - var(--mask-fade) - 0.5rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      #000 calc(100% - var(--mask-fade) - 0.5rem),
      transparent 100%
    );
  }

  .category-scroll.can-scroll-left.can-scroll-right {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 calc(var(--mask-fade) + 0.5rem),
      #000 calc(100% - var(--mask-fade) - 0.5rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 calc(var(--mask-fade) + 0.5rem),
      #000 calc(100% - var(--mask-fade) - 0.5rem),
      transparent 100%
    );
  }

  .category-pill {
    z-index: 1;
    border: none;
    border-radius: 0.75rem;
    color: var(--btn-content);
    background: color-mix(in srgb, var(--btn-content) 6%, transparent);
    font-weight: 500;
    gap: 0.375rem;
    text-decoration: none;
    position: relative;
    transition: color 0.2s ease;
    /* 框不可点击：点击命中仅限内层文字（配合下方 span 规则），
       空白区域全部让给拖拽（pointerdown 在 bar 上），加大可拖动范围 */
    pointer-events: none;
  }

  /* 仅文字等主体内容可点击；数字徽章（.pill-count）不可点击，让给拖拽 */
  .category-pill > span:not(.pill-count) {
    pointer-events: auto;
  }

  .category-pill:has(> span:hover) {
    color: var(--primary);
  }

  .category-pill:has(> span:active) {
    transform: scale(0.95);
  }

  .category-pill[data-active] {
    color: white;
    background: transparent;
    border-color: transparent;
  }

  .category-pill[data-active] .pill-count {
    background: rgba(255, 255, 255, 0.2);
    opacity: 0.9;
  }

  /* 激活态 hover：文字保持白色（否则会被通用 :has(hover) 染成主色，与滑块底色同色不可读） */
  .category-pill[data-active]:has(> span:hover) {
    color: white;
    opacity: 0.9;
    border-color: transparent;
  }

  .category-pill[data-soft-active] {
    color: color-mix(in srgb, var(--primary) 90%, var(--btn-content));
    font-weight: 600;
  }

  .category-pill[data-soft-active]:has(> span:hover) {
    color: color-mix(in srgb, var(--primary) 100%, var(--btn-content));
  }

  .category-pill[data-category-name=""] {
    color: var(--primary);
  }

  .category-pill[data-category-name=""][data-active],
  .category-pill[data-category-name=""][data-active]:has(> span:hover) {
    color: white;
  }

  .category-pill .pill-count {
    font-size: 0.7rem;
    font-weight: 600;
    opacity: 0.5;
    padding: 0.05rem 0.35rem;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--btn-content) 10%, transparent);
  }

  .category-divider {
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
    opacity: 0.5;
  }

  .category-pill:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  @media (width <= 767px) {
    .category-scroll.can-scroll-left,
    .category-scroll.can-scroll-right,
    .category-scroll.can-scroll-left.can-scroll-right {
      mask-image: none;
    }
  }
</style>

<script>
  // @ts-nocheck
  (function () {
    if (window.__categoryBarBound) return;
    window.__categoryBarBound = true;

    var bar = document.getElementById("category-bar");
    if (!bar) return;

    var scroll = bar.querySelector(".category-scroll");
    var liquid = bar.querySelector(".category-liquid");
    // 拉伸层（橡皮筋作用域）：液态滑块 + 可滚动 pill 区；固定 pill 不在其内
    var stretch = bar.querySelector(".category-stretch");
    // 液块定位基座（.category-stretch-area，不随拉伸 transform 平移）：
    // 以其 rect 为基准，拉伸/滚动/回弹中的视觉位置由每帧 rect 差值天然反馈，
    // 液块挂基座层（裁剪窗之外）——可跨出滚动框盖固定 pill；
    // 滚动内容则由 .category-clip（同样不动）在溢出时裁剪
    var area = bar.querySelector(".category-stretch-area");
    // 可见窗口必须是静态裁剪窗：.category-scroll 是 .category-stretch 的子级，
    // 越界拉伸时随 transform 平移（rect 与 pill 同步移动，交集恒为"完整可见"），
    // 液块将按全宽滑出基座、被固定 pill 覆盖（issue #52 修复回归）
    var clip = bar.querySelector(".category-clip");

    function pathOf(href) {
      try {
        return new URL(href, location.origin).pathname;
      } catch (e) {
        return href;
      }
    }

    // getBoundingClientRect 定位，滚动期间 rAF 跟随。
    // 滑块位于滚动区外（无 overflow 裁剪），须与滚动窗口求交集：
    // 半露只铺可见段、完全滚出隐藏，防止底色溢出相邻 pill/分隔线。
    // 拖拽期间保持跟随：滚动由 scroll 事件驱动（scheduleLiquidSync），
    // 拉伸/回弹是 stretch 自身 transform，液块作为子级天然同步平移
    function moveLiquid(el, animate) {
      if (!liquid || !area || !el) return;
      // 定位基准为不动基座（liquid 的 absolute 容器）：elRect 含拉伸/滚动
      // 的实时视觉位置（transform 子树内的 getBoundingClientRect 反馈），
      // 差值即正确坐标——液块跟随滚动/拉伸/回弹，无需逐帧补偿
      var baseRect = area.getBoundingClientRect();
      var elRect = el.getBoundingClientRect();
      var x = elRect.left - baseRect.left;
      var w = elRect.width;
      if (scroll.contains(el)) {
        // 可见窗口取静态裁剪窗（.category-clip）而非 scroll 自身：
        // 拉伸/回弹期间 scroll 随 transform 平移，其 rect 与 pill 同步移动，
        // 交集永远"完整可见"——半露不缩、滑出不下架，直至被钳制卡死。
        // clip 不动（overflow-hidden 是真视口）：半露只铺可见段、完全滚出隐藏。
        // 非拉伸（transform 为空）时两者 rect 一致，行为等价。
        var viewRect = (clip || scroll).getBoundingClientRect();
        var visibleLeft = Math.max(elRect.left, viewRect.left);
        var visibleRight = Math.min(elRect.right, viewRect.right);
        if (visibleRight <= visibleLeft) {
          liquid.style.opacity = "0";
          return;
        }
        x = visibleLeft - baseRect.left;
        w = visibleRight - visibleLeft;
        // 滚动区内的 pill：仅覆盖可见段，钳制在基座内
        x = Math.max(0, Math.min(x, baseRect.width - w));
      } else {
        // 固定 pill（home/更多）位于基座之外：不钳制，允许液块“跨出”
        // 覆盖到位——否则会停在基座左/右缘（路上）
      }
      if (animate) {
        liquid.style.opacity = "";
        liquid.style.width = w + "px";
        liquid.style.transform = "translateX(" + x + "px)";
      } else {
        liquid.style.transition = "none";
        liquid.style.width = w + "px";
        liquid.style.transform = "translateX(" + x + "px)";
        void liquid.offsetWidth;
        liquid.style.transition = "";
        // opacity 恢复放在 reflow 之后：过渡重启用（CSS 的 opacity 0.2s），
        // 下滑出视野再滚回的边缘场景按目标位置 0 → 1 淡入；宽度/位移仍为无动画瞬定位
        liquid.style.opacity = "";
      }
    }

    function moveToActive(animate) {
      var act =
        bar.querySelector(".category-pill[data-active]") ||
        bar.querySelector(".category-pill[data-soft-active]");
      if (act) {
        moveLiquid(act, animate);
      } else if (liquid) {
        liquid.style.opacity = "0";
      }
    }

    function updateScrollMask() {
      if (!scroll) return;
      var hasOverflow = scroll.scrollWidth > scroll.clientWidth + 1;
      var atStart = scroll.scrollLeft <= 1;
      var atEnd =
        scroll.scrollLeft + scroll.clientWidth >= scroll.scrollWidth - 1;
      scroll.classList.toggle("can-scroll-left", hasOverflow && !atStart);
      scroll.classList.toggle("can-scroll-right", hasOverflow && !atEnd);
    }

    function setActiveCategory(currentUrl) {
      currentUrl = currentUrl || new URL(window.location.href);
      var path = currentUrl.pathname.replace(/\/+$/, "") || "/";
      var isHome = path === "/" || path === "";
      var isCategories = path === "/categories";

      var targetName = null;

      if (isHome) {
        targetName = "";
      } else if (isCategories) {
        targetName = "__categories__";
      } else {
        var pills = bar.querySelectorAll(".category-pill");
        for (var i = 0; i < pills.length; i++) {
          var catName = pills[i].getAttribute("data-category-name");
          if (catName && catName !== "" && catName !== "__categories__") {
            try {
              var pillUrl = new URL(pills[i].href, window.location.origin);
              if (pillUrl.pathname.replace(/\/+$/, "") === path) {
                targetName = catName;
                break;
              }
            } catch (e) {}
          }
        }
        // 归档页（/archives 及其 query）：高亮由页面内分类选择器承担，
        // 导航栏在归档页不设高亮（path 不匹配任何分类 pill）
      }

      var postCategory = (
        bar.getAttribute("data-current-post-category") || ""
      ).trim();
      var targetSoftName = !targetName && postCategory ? postCategory : null;

      var currentActive = bar.querySelector(".category-pill[data-active]");
      var currentActiveName = currentActive
        ? currentActive.getAttribute("data-category-name")
        : undefined;
      var currentSoftActive = bar.querySelector(
        ".category-pill[data-soft-active]",
      );
      // 与 targetSoftName（无 soft 目标时为 null）对齐，避免 undefined !== null
      // 使幂等判断恒失败——activate 的目标一致跳过依赖此处相等（问题：闪烁）
      var currentSoftName = currentSoftActive
        ? currentSoftActive.getAttribute("data-category-name")
        : null;

      if (
        currentActiveName === targetName &&
        currentSoftName === targetSoftName
      )
        return false;

      var allPills = bar.querySelectorAll(".category-pill");
      allPills.forEach(function (pill) {
        var name = pill.getAttribute("data-category-name");
        var shouldBeActive = name === targetName;
        var shouldBeSoft = !targetName && name === targetSoftName;

        if (shouldBeActive) {
          pill.setAttribute("data-active", "");
        } else {
          pill.removeAttribute("data-active");
        }
        if (shouldBeSoft) {
          pill.setAttribute("data-soft-active", "");
        } else {
          pill.removeAttribute("data-soft-active");
        }
      });
      return true;
    }

    function scrollPillIntoView(smooth) {
      if (!scroll) return;
      var activePill =
        scroll.querySelector(".category-pill[data-active]") ||
        scroll.querySelector(".category-pill[data-soft-active]");
      if (!activePill) return;
      if (scroll.scrollWidth <= scroll.clientWidth) return;
      var left =
        activePill.offsetLeft -
        (scroll.clientWidth - activePill.offsetWidth) / 2;
      left = Math.max(
        0,
        Math.min(left, scroll.scrollWidth - scroll.clientWidth),
      );
      scroll.scrollTo({ left: left, behavior: smooth ? "smooth" : "auto" });
    }

    // lqbby.com 同款：rAF 节流，滚动期间滑块无动画跟随
    var liquidRaf = 0;
    function scheduleLiquidSync() {
      if (liquidRaf) return;
      liquidRaf = requestAnimationFrame(function () {
        liquidRaf = 0;
        moveToActive(false);
      });
    }

    function updateCategoryBar(animate) {
      var swupContainer = document.getElementById("swup-container");
      if (swupContainer) {
        var postCategory =
          swupContainer.getAttribute("data-current-post-category") || "";
        bar.setAttribute("data-current-post-category", postCategory);
      }
      setActiveCategory();
      moveToActive(animate);
      scrollPillIntoView(true);
      updateScrollMask();
    }

    // 跨页/首载两段式：先清掉旧高亮并褪去液块（数据与视觉都在旧位置消失），
    // 下一帧布局稳定后在正确位置瞬现高亮——杜绝液块从旧位置“滑经”错误路径的错位观感。
    // 但若当前已高亮的 pill 与 URL 推断一致（同页 pick 点击已预置高亮并动画定位），
    // 则跳过清→现——否则 Swup 的 page:view 会把刚播好的移动动画截断成
    // 瞬隐再瞬现（闪烁且显得“无动画”）。
    function activateCategoryBarAfterFade() {
      var hasActivePill = bar.querySelector(
        ".category-pill[data-active], .category-pill[data-soft-active]",
      );
      if (hasActivePill && setActiveCategory() === false) {
        // 目标态一致（同页 pill 点击已预置高亮并动画定位）：
        // 仅同步滚动与遮罩，不做清→现两段式（防截断动画/闪烁）
        scrollPillIntoView(true);
        updateScrollMask();
        return;
      }
      var allPills = bar.querySelectorAll(".category-pill");
      allPills.forEach(function (p) {
        p.removeAttribute("data-active");
        p.removeAttribute("data-soft-active");
      });
      if (liquid) {
        liquid.style.transition = "none";
        liquid.style.opacity = "0";
      }
      requestAnimationFrame(function () {
        setActiveCategory();
        // moveToActive 内部决定液块可见性：有目标则显（opacity 复位）、无目标则隐藏
        moveToActive(false);
        scrollPillIntoView(true);
        updateScrollMask();
        if (liquid) {
          void liquid.offsetWidth;
          liquid.style.transition = "";
        }
      });
    }

    function initScrollFeatures() {
      if (!scroll) return;
      if (scroll.getAttribute("data-features-bound")) {
        updateScrollMask();
        return;
      }
      scroll.setAttribute("data-features-bound", "true");
      scroll.addEventListener(
        "scroll",
        function () {
          updateScrollMask();
          scheduleLiquidSync();
        },
        { passive: true },
      );
      initInertiaScroll();
      updateScrollMask();
    }

    // 滚轮 / 拖拽 / 惯性 / 回弹。仅鼠标拖拽（触摸保持原生滚动），
    // 拖拽越过边界时用 .category-stretch（液态滑块 + 可滚动 pill 区）整体
    // translateX 做视觉拉伸，松手弹回；固定 pill（Home/归档/更多/分隔线）
    // 不在拉伸层内，保持静止。
    var scrollInFlight = false;

    function stopScrollAnimation() {
      scrollInFlight = false;
    }

    function settleScroll() {
      updateScrollMask();
      scheduleLiquidSync();
    }

    function startMomentum(vel) {
      if (Math.abs(vel) < 0.05) return;
      scrollInFlight = true;
      var pos = scroll.scrollLeft;
      var lastT = performance.now();

      function step(now) {
        if (!scrollInFlight) return;
        var dt = Math.min(now - lastT, 32);
        lastT = now;
        var max = scroll.scrollWidth - scroll.clientWidth;
        pos += vel * dt;
        var target = Math.max(0, Math.min(pos, max));
        if (pos !== target) {
          // 撞边界：速度折返衰减（回弹）
          vel = -vel * 0.35;
          pos = target;
          if (Math.abs(vel) < 0.05) {
            scroll.scrollLeft = target;
            scrollInFlight = false;
            settleScroll();
            return;
          }
        } else {
          vel *= 0.945;
          if (Math.abs(vel) < 0.05) {
            scroll.scrollLeft = pos;
            scrollInFlight = false;
            settleScroll();
            return;
          }
        }
        scroll.scrollLeft = Math.max(0, Math.min(pos, max));
        settleScroll();
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    function initInertiaScroll() {
      var suppressClick = false;

      scroll.addEventListener(
        "wheel",
        function (e) {
          if (scroll.scrollWidth <= scroll.clientWidth + 1) return;
          var delta =
            Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
          if (!delta) return;
          // deltaMode：0=像素 1=行 2=页（Firefox 等以行/页为单位），
          // 统一换算成像素后再累加，避免物理滚轮“几乎不动”
          if (e.deltaMode === 1) delta *= 16;
          else if (e.deltaMode === 2) delta *= 100;
          // 悬停条内始终劫持：中部横向滚动，到头后吸收（不触发页面纵向滚动），
          // 想滚页面把指针移出滚动区即可
          e.preventDefault();
          scroll.scrollLeft += delta;
        },
        { passive: false },
      );

      // 拖拽松手后拦截一次 click，防止误触 pill 导航（捕获层级在 bar，覆盖整条框）
      bar.addEventListener(
        "click",
        function (e) {
          if (!suppressClick) return;
          suppressClick = false;
          e.preventDefault();
          e.stopPropagation();
        },
        true,
      );

      // 回弹跟踪：弹簧期间 stretch 的 translateX 逐帧插值，液块必须同帧跟随
      // 才不偏离。改用 JS rAF 推进回弹（不依赖 CSS transition——合成器插值会使
      // rAF 内 rect 读取滞后一帧，露 11px 级偏移），每帧：推进 over → 写 stretch
      // transform → moveToActive(false) 重算液块（同帧主线程值，零滞后）。
      // 缓动近似原 CSS 曲线 cubic-bezier(0.22,1,0.36,1)（尾段极缓 → easeOutQuint）
      var springRaf = 0;
      var SPRING_DURATION = 350;
      var SPRING_EASE_OUT_WEIGHT = 5;
      function stopSpringTrack() {
        if (springRaf) {
          cancelAnimationFrame(springRaf);
          springRaf = 0;
        }
      }
      function finishSpringTrack() {
        stretch.classList.remove("category-stretch-spring");
        stretch.style.transform = "";
        moveToActive(false);
      }
      function startSpringTrack(from) {
        stopSpringTrack();
        var startedAt = 0;
        function step(now) {
          if (!startedAt) startedAt = now;
          if (!stretch.classList.contains("category-stretch-spring")) return;
          var k = Math.min(1, (now - startedAt) / SPRING_DURATION);
          var eased = 1 - Math.pow(1 - k, SPRING_EASE_OUT_WEIGHT);
          if (k >= 1) {
            finishSpringTrack();
            stopSpringTrack();
            return;
          }
          stretch.style.transform = "translateX(" + from * (1 - eased) + "px)";
          moveToActive(false);
          springRaf = requestAnimationFrame(step);
        }
        springRaf = requestAnimationFrame(step);
      }

      // 拉伸层回弹动画结束后清理过渡类与残留 transform，恢复高亮显示：
      // 拖拽期间高亮处于隐藏态，回弹完成后以最终激活 pill 重新定位淡入显示
      stretch.addEventListener("transitionend", function (e) {
        // 只处理回弹自身（stretch 的 transform）；液块的 opacity/width/transform
        // 过渡结束也会冒泡到 stretch，需过滤防止重复恢复
        if (e.target !== stretch) return;
        stopSpringTrack();
        stretch.classList.remove("category-stretch-spring");
        if (stretch.style.transform === "translateX(0px)") {
          stretch.style.transform = "";
        }
        moveToActive(false);
      });

      // 兜底：全局拦截 bar 内的原生拖拽（文本/链接 ghost），防止打断拖拽跟手
      document.addEventListener(
        "dragstart",
        function (e) {
          var target = e.target;
          if (target && target.closest && target.closest("#category-bar")) {
            e.preventDefault();
          }
        },
        true,
      );

      // 拖拽起点覆盖整条 bar（pill 框已 pointer-events:none，空白区天然让给拖拽；
      // 文字上也允许，>6px 位移后 beginDrag 并抑制 click）
      // preventDefault 阻止按住文字拖动时浏览器启动原生链接/文本拖拽（drag 幽灵），
      // 否则 pointermove 流会被 drag 事件打断造成“拖动不跟手”。
      // 不设“溢出才可拖”早退：无溢出（分类内容未超容器宽，如宽屏归档页）时
      // scrollPos 恒被钳制为 0，位移全部转为整条拉伸回弹——拖拽始终有反馈。
      bar.addEventListener("pointerdown", function (e) {
        if (e.pointerType !== "mouse" || e.button !== 0) return;
        e.preventDefault();
        stopScrollAnimation();
        var max = scroll.scrollWidth - scroll.clientWidth;
        var pointerId = e.pointerId;
        var dragging = false;
        // 增量差值跟踪（不依赖起点绝对坐标）：指针拖出窗口后文档级事件丢失，
        // 再回来（甚至在别处重新进入）时按每步位移增量续算，方向不会因
        // clientX 跳变而反转；越界拉伸值基于未钳制的虚拟位置 scrollPos。
        var firstX = e.clientX;
        var lastX = e.clientX;
        var scrollPos = scroll.scrollLeft;
        var history = [];

        function beginDrag() {
          dragging = true;
          suppressClick = true;
          bar.classList.add("is-dragging");
          stretch.classList.remove("category-stretch-spring");
          stopSpringTrack();
          if (scroll.setPointerCapture) {
            try {
              scroll.setPointerCapture(pointerId);
            } catch (err) {}
          }
        }

        function onMove(ev) {
          if (!dragging) {
            if (Math.abs(ev.clientX - firstX) <= 6) return;
            beginDrag();
          }
          // 增量：每个事件的位移只依赖本事件与上一事件的差值
          var delta = ev.clientX - lastX;
          lastX = ev.clientX;
          ev.preventDefault();
          scrollPos -= delta; // 向右拖（delta>0）→ 虚拟位置减小 → 内容右移
          var target = Math.max(0, Math.min(scrollPos, max));
          // 越界拉伸：offset 方向与拖拽方向一致（content 随手势），
          // 故取 target - scrollPos（越过边界时非零，符号即拖拽方向）。
          // 拉伸仅作用于拉伸层（液态滑块 + 可滚动 pill 区），
          // 内容与高亮同步移动；Home/归档/更多等固定 pill 不被拉出。
          var overshoot = (target - scrollPos) * 0.35;
          scroll.scrollLeft = target;
          stretch.style.transform = overshoot
            ? "translateX(" + overshoot + "px)"
            : "";
          // scroll 事件按帧批量派发，这里直接调度 rAF，保证液块跟手
          scheduleLiquidSync();
          history.push({ x: ev.clientX, t: performance.now() });
          if (history.length > 6) history.shift();
        }

        function cleanup() {
          document.removeEventListener("pointermove", onMove);
          document.removeEventListener("pointerup", onUp);
          document.removeEventListener("pointercancel", onCancel);
          window.removeEventListener("blur", onCancel);
          bar.classList.remove("is-dragging");
          if (scroll.hasPointerCapture && scroll.hasPointerCapture(pointerId)) {
            scroll.releasePointerCapture(pointerId);
          }
        }

        function endDrag(momentum) {
          if (!dragging) {
            suppressClick = false;
            cleanup();
            return;
          }
          var current = stretch.style.transform;
          var overshoot = /translateX\(([-\d.]+)px\)/.exec(current)
            ? parseFloat(RegExp.$1)
            : 0;
          cleanup();
          // 边界拉伸回弹（作用于拉伸层）；回弹期间液块随 stretch 平移
          if (overshoot) {
            stretch.classList.add("category-stretch-spring");
            stretch.style.transform = "translateX(" + overshoot + "px)";
            startSpringTrack(overshoot);
          } else {
            // 无拉伸：最终贴合一次（滚动事件已驱动跟随，此处收敛兜底）
            moveToActive(false);
          }
          var vel = 0;
          if (momentum && history.length > 1) {
            var first = history[0];
            var last = history[history.length - 1];
            var dt = last.t - first.t;
            if (dt > 0) vel = (first.x - last.x) / dt;
          }
          startMomentum(vel);
        }

        function onUp() {
          endDrag(true);
        }
        function onCancel() {
          endDrag(false);
        }

        // 拖动期间用文档级监听：指针滑出窗口/元素外依然收到事件，
        // pointercancel/blur（窗口失焦，如拖到另一个显示器时）兜底结束
        document.addEventListener("pointermove", onMove, { passive: false });
        document.addEventListener("pointerup", onUp);
        document.addEventListener("pointercancel", onCancel);
        window.addEventListener("blur", onCancel);
      });
    }

    function init() {
      initScrollFeatures();
      activateCategoryBarAfterFade();

      bar.addEventListener("click", function (e) {
        var pill = e.target.closest(".category-pill");
        if (!pill) return;
        if (
          e.defaultPrevented ||
          e.button !== 0 ||
          e.metaKey ||
          e.ctrlKey ||
          e.shiftKey ||
          e.altKey
        )
          return;
        var href = pill.getAttribute("href");
        if (!href) return;
        var targetUrl = new URL(href, window.location.href);
        if (targetUrl.origin !== window.location.origin) return;

        e.preventDefault();
        setActiveCategory(targetUrl);
        moveLiquid(pill, true);
        scrollPillIntoView(true);

        var targetSearch = targetUrl.search || "";
        if (
          pathOf(href) === location.pathname &&
          targetSearch === location.search
        )
          return;
        if (window.swup) window.swup.navigate(href);
        else location.href = href;
      });

      // 窗口尺寸变化时重算：液块定位基于 getBoundingClientRect 瞬时像素
      // （pill 尺寸、滚动区宽均随视口变化），拖拽/滚动期间无需处理
      var resizeRaf = 0;
      window.addEventListener("resize", function () {
        if (resizeRaf) return;
        resizeRaf = requestAnimationFrame(function () {
          resizeRaf = 0;
          moveToActive(false);
          updateScrollMask();
        });
      });

      function onSwupPageView() {
        activateCategoryBarAfterFade();
        initScrollFeatures();
      }
      if (window.swup && window.swup.hooks) {
        window.swup.hooks.on("page:view", onSwupPageView);
      } else {
        document.addEventListener("astro:page-load", onSwupPageView);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
