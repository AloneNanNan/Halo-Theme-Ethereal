---
// 分组/筛选标签行（容器 + 「全部」tab + 动态/静态 tab 列表）。
//
// 动态模式：eachExpr 传 th:each 源（如 `group : ${groups}`），tab 由 tabTemplate 描述，
//   组件内部用 `<div class="contents" th:each=...>` 包裹（组件标签上的 th:each 不会
//   转发到根元素，故不能直接放在 FilterTab 上）。
// 静态模式：items 数组逐项渲染（skills/timeline 的显式分类）。
// 「全部」tab 默认文案为 `#{common.all}`，label/计数/激活判定均可按页面覆盖。
// 各字段表达式串约定见 FilterTab.astro。
//
// segmented 胶囊池模式：只输出条目（外层换成 display:contents 透传布局，
// class prop 忽略），池外壳 .seg-scroll/.seg/.seg-thumb 由页面手写——
// 这样 archives 的「未分类」这类池外追加条目能共用同一条轨道。
// 池式样式见 components.css 的 .seg-* 段，滑块脚本见 src/scripts/assets/filter-seg.ts。
import FilterTab from "./FilterTab.astro";

interface TabItem {
  hrefExpr?: string;
  activeExpr?: string;
  labelExpr?: string;
  countExpr?: string;
  showIfExpr?: string;
  withExpr?: string;
  countShowIfExpr?: string;
  label?: string;
}

interface Props {
  showIfExpr?: string;
  class?: string;
  size?: "sm" | "lg";
  countClass?: string;
  segmented?: boolean;
  allHrefExpr: string;
  allActiveExpr: string;
  allLabelExpr?: string;
  allLabel?: string;
  allCountExpr?: string;
  allCountShowIfExpr?: string;
  eachExpr?: string;
  tabTemplate?: TabItem;
  items?: TabItem[];
}

const {
  showIfExpr,
  size = "sm",
  countClass,
  segmented = false,
  allHrefExpr,
  allActiveExpr,
  allLabelExpr = "#{common.all}",
  allLabel = "全部",
  allCountExpr,
  allCountShowIfExpr,
  eachExpr,
  tabTemplate,
  items = [],
  class: className = "mb-6 flex flex-wrap gap-2",
} = Astro.props;
---

<div th:if={showIfExpr} class={segmented ? "contents" : className}>
  <FilterTab
    segmented={segmented}
    hrefExpr={allHrefExpr}
    activeExpr={allActiveExpr}
    labelExpr={allLabelExpr}
    label={allLabel}
    countExpr={allCountExpr}
    countShowIfExpr={allCountShowIfExpr}
    size={size}
    countClass={countClass}
  />
  {
    eachExpr && tabTemplate ? (
      <div class="contents" th:each={eachExpr}>
        <FilterTab
          {...tabTemplate}
          segmented={segmented}
          size={size}
          countClass={countClass}
        />
      </div>
    ) : (
      items.map((item) => (
        <FilterTab
          {...item}
          segmented={segmented}
          size={size}
          countClass={countClass}
        />
      ))
    )
  }
</div>
