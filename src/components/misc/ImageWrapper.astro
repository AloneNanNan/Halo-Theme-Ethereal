---
interface Props {
  id?: string;
  src: string;
  class?: string;
  alt?: string;
  position?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  /** 可选：srcset 属性值（如 MainGridLayout 传入的 bannerSrcsetExpr 结果），原样输出到 th:srcset */
  srcset?: string;
  /** 可选：sizes 属性值，如 "100vw"（全宽 Banner）、"(min-width: 1024px) 256px, 192px"（头像） */
  sizes?: string;
}

const {
  id,
  src,
  alt = "",
  position = "center",
  loading = "lazy",
  fetchpriority = "auto",
  srcset,
  sizes,
} = Astro.props;
const className = Astro.props.class;
const imageStyle = `object-position: ${position}`;
---

<div id={id} class:list={[className, "overflow-hidden relative"]}>
  <div class="pointer-events-none absolute inset-0 bg-opacity-50 transition dark:bg-black/10"></div>
  <img
    th:src={src}
    th:srcset={srcset}
    sizes={sizes}
    th:alt={alt}
    th:style={`|object-position: ${position}|`}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
    class="h-full w-full object-cover"
    style={imageStyle}
    alt=""
  />
</div>
