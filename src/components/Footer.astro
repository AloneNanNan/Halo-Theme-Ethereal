---
const currentYear = new Date().getFullYear();
---

<div
  class="mx-8 my-10 border-t border-dashed border-(--primary)/15 transition dark:border-(--primary)/20 md:mx-32"
>
</div>

<!-- 页脚友情链接卡片墙：位于页脚分隔线之下、版权信息之上。数据来自 Links 插件（PluginLinks），
     插件未安装或未开启时整块跳过。
     「仅在首页显示」（is_home_only，默认关闭）不用 SSR 变量判定，而是挂 is-home-only
     class 交给下面的 CSS 按 body.is-home 控制显隐——body.is-home 服务端有首帧初值、
     运行期由 syncHomeClass 在每次 Swup page:view 重算，所以无刷新换页也准确，
     且不会出现"服务端判成首页、客户端已切到文章页"的首帧闪错。

     排序：直接沿用插件 linkFinder.groupBy() 的返回顺序，不在主题侧重新排序——
     排序规则只存在于插件一处（组内与分组均按 spec.priority → 创建时间 → 名称 升序），
     主题不复制一份，插件升级也不会与主题失配。
     后台「链接管理」里的展示顺序能否原样带到前台，以插件自身实现为准。 -->

<!-- 两个已经踩过的 SpEL 坑，改动这里时请一并留意：
       1. SpEL 不支持范围下标（方括号里写起止索引那种切片写法），下标只接受单个 Integer，
          写错在「解析期」就抛 SpelParseException，与三元分支实际是否走到无关；
          列表切片一律用 List.subList(from, to)（含头不含尾）。
       2. #aggregates.sum(...) 返回 BigDecimal，且集合为空时返回 null（不是 0），
          所以 hbfTotal 必须自己做空集合兜底；它对 null 容器 / 含 null 元素的集合
          还会直接抛 IllegalArgumentException。 -->
<!-- hbfValidGroups：url 过滤条件只在这里写一遍（网址为空 / 非 http、//、/ 开头的整条剔除），
     后面的总数、截断偏移、卡片渲染全部基于它，口径天然一致。
     hbfMaxItems：#strings.isEmpty 对 null / 空串都成立，避免清空输入框后拿 "" 去转数字。 -->
<div
  th:if="${pluginFinder.available('PluginLinks') && (theme.config?.footer?.friendLinks?.enable_friend_links == true)}"
  class="hbf-root w-full"
  th:classappend="${theme.config?.footer?.friendLinks?.is_home_only == true ? ' hbf-home-only' : ''}"
  th:with="
    hbfValidGroups = ${linkFinder.groupBy().![links.?[spec.url != null and (spec.url.startsWith('http') or spec.url.startsWith('//') or spec.url.startsWith('/'))]]},
    hbfTotal = ${#lists.isEmpty(hbfValidGroups) ? 0 : #aggregates.sum(hbfValidGroups.![size()])},
    hbfMaxItems = ${#strings.isEmpty(theme.config?.footer?.friendLinks?.max_items) ? 0 : #conversions.convert(theme.config?.footer?.friendLinks?.max_items, 'java.lang.Integer')}"
>
  <div class="hbf-head">
    <!-- 标题图标：与侧边栏「作者信息 → 社交媒体」按钮同款风格。
         社交按钮是 .btn-regular size-10 rounded-lg（淡色底 + 主题色图标），
         这里复用同两个变量 --btn-regular-bg / --btn-content，
         因此颜色与侧边栏天然一致，且深色模式由 :root.dark 自动切换。
         用内联 SVG + fill="currentColor"：Ethereal 不加载图标字体，
         <i class="fa ..."> 之类的写法在本主题永远不会显示。 -->
    <span class="hbf-head-icon" aria-hidden="true">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
      >
        <path
          fill="currentColor"
          d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
        ></path>
      </svg>
    </span>
    <span class="hbf-title" th:text="#{footer.friendLinks.title}">友情链接</span
    >
    <!-- 申请按钮：固定跳转官方 Links 插件的 /links 路由，文案复用友链页的 i18n 词条；
         show_apply_btn 缺省视为开启（与主题其它可选开关的 != false 口径一致） -->
    <a
      class="hbf-apply"
      th:if="${theme.config?.footer?.friendLinks?.show_apply_btn != false}"
      th:href="@{/links}"
      th:title="#{page.links.applyTitle}"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M12 5v14"></path>
        <path d="M5 12h14"></path>
      </svg>
      <span th:text="#{page.links.applyTitle}">申请友链</span>
    </a>
    <span class="hbf-count" th:text="${hbfTotal}">0</span>
  </div>
  <div class="hbf-list" th:if="${hbfTotal > 0}">
    <!-- hbfOffset：前面所有分组的有效链接数之和，把 max_items 当成跨分组的全局上限；
         切片只能用 subList(from, to)，原因见上方「SpEL 两个坑」注释。 -->
    <span
      th:each="hbfValidLinks, hbfGroupStat : ${hbfValidGroups}"
      th:remove="tag"
      th:with="hbfOffset = ${hbfGroupStat.index == 0 ? 0 : #aggregates.sum(hbfValidGroups.subList(0, hbfGroupStat.index).![size()])}"
    >
      <a
        th:each="hbfLink, hbfStat : ${hbfValidLinks}"
        th:if="${hbfMaxItems == 0 or (hbfOffset + hbfStat.index) < hbfMaxItems}"
        th:href="${hbfLink.spec.url}"
        target="_blank"
        rel="noopener noreferrer"
        th:title="${not #strings.isEmpty(hbfLink.spec.description) ? hbfLink.spec.description : hbfLink.spec.displayName}"
        class="hbf-item"
      >
        <img
          th:if="${hbfLink.spec.logo != null and (hbfLink.spec.logo.startsWith('http') or hbfLink.spec.logo.startsWith('//') or hbfLink.spec.logo.startsWith('/'))}"
          th:src="${hbfLink.spec.logo}"
          alt=""
          loading="lazy"
          decoding="async"
          class="hbf-logo"
        />
        <span
          th:unless="${hbfLink.spec.logo != null and (hbfLink.spec.logo.startsWith('http') or hbfLink.spec.logo.startsWith('//') or hbfLink.spec.logo.startsWith('/'))}"
          class="hbf-logo-ph"
        >
          <span class="icon-[material-symbols--link-rounded] text-xs"></span>
        </span>
        <span class="hbf-name" th:text="${hbfLink.spec.displayName}">Link</span>
      </a>
    </span>
  </div>
  <div class="hbf-more" th:if="${hbfMaxItems > 0 and hbfTotal > hbfMaxItems}">
    <a
      class="hbf-more-btn"
      th:href="@{/links}"
      th:title="#{footer.friendLinks.moreTitle(${hbfTotal})}"
      th:aria-label="#{footer.friendLinks.moreAria}"
    >
      <span class="hbf-more-icon" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </span>
    </a>
  </div>
</div>
<footer
  class="mb-12 flex flex-col items-center justify-center rounded-2xl px-6 text-center text-sm text-50 transition"
>
  <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
    <span
      >&copy; <span id="copyright-year">{currentYear}</span>
      <span th:text="${site.title}">Ethereal</span>.
      <span th:text="#{footer.rights}">All Rights Reserved.</span></span
    >
    <span class="whitespace-nowrap">
      <span
        th:if="${theme.config?.footer?.displayLinks?.enable_privacy != null ? theme.config?.footer?.displayLinks?.enable_privacy : false}"
        th:remove="tag"
        >/&nbsp;<a
          class="link font-medium text-(--primary)"
          th:href="@{${theme.config?.footer?.displayLinks?.privacy_url != null ? theme.config?.footer?.displayLinks?.privacy_url : '/privacy'}}"
          th:text="#{common.privacyPolicy}">隐私政策</a
        ></span
      >
      <span
        th:if="${pluginFinder.available('PluginFeed') && (theme.config?.footer?.displayLinks?.enable_rss == null || theme.config?.footer?.displayLinks?.enable_rss)}"
        th:remove="tag"
        >&nbsp;/&nbsp;<a
          class="link font-medium text-(--primary)"
          target="_blank"
          th:href="@{/rss.xml}">RSS</a
        ></span
      >
      <span
        th:if="${pluginFinder.available('PluginSitemap') && (theme.config?.footer?.displayLinks?.enable_sitemap == null || theme.config?.footer?.displayLinks?.enable_sitemap)}"
        th:remove="tag"
        >&nbsp;/&nbsp;<a
          class="link font-medium text-(--primary)"
          target="_blank"
          th:href="@{/sitemap.xml}">Sitemap</a
        ></span
      >
    </span>
  </div>
  <!-- 自定义页脚链接 -->
  <div
    th:if="${theme.config?.footer?.customLinks != null && not #lists.isEmpty(theme.config?.footer?.customLinks?.items)}"
    class="mt-1.5 flex flex-wrap items-center justify-center gap-x-2 gap-y-1"
  >
    <span
      th:each="link, stat : ${theme.config?.footer?.customLinks?.items}"
      th:remove="tag"
    >
      <span
        th:if="${not #strings.isEmpty(link.html)}"
        th:remove="tag"
        th:utext="${link.html}"></span>
      <span th:unless="${not #strings.isEmpty(link.html)}" th:remove="tag">
        <span th:if="${not stat.first}"> / </span>
        <a
          th:if="${not #strings.isEmpty(link.url)}"
          class="link font-medium text-(--primary)"
          target="_blank"
          th:href="${link.url}"
          th:text="${link.name}">Link</a
        >
        <span
          th:unless="${not #strings.isEmpty(link.url)}"
          class="link font-medium text-(--primary)"
          th:text="${link.name}">Link</span
        >
      </span>
    </span>
  </div>
  <div
    class="mt-2 flex flex-wrap items-center justify-center gap-x-4 gap-y-2"
    th:if="${not #strings.isEmpty(theme.config?.footer?.beian?.icp_text) or not #strings.isEmpty(theme.config?.footer?.beian?.gongan_text)}"
  >
    <a
      th:if="${not #strings.isEmpty(theme.config?.footer?.beian?.icp_text)}"
      class="inline-flex items-center gap-1 link font-medium text-(--primary)"
      th:href="${theme.config?.footer?.beian?.icp_link}"
      target="_blank"
    >
      <span class="icon-[material-symbols--verified-outline-rounded] h-4 w-4"
      ></span>
      <span class="text-sm" th:text="${theme.config?.footer?.beian?.icp_text}"
      ></span>
    </a>
    <a
      th:if="${not #strings.isEmpty(theme.config?.footer?.beian?.gongan_text)}"
      class="inline-flex items-center gap-1 link font-medium text-(--primary)"
      th:href="${theme.config?.footer?.beian?.gongan_link}"
      target="_blank"
    >
      <img
        src={`/themes/Ethereal/assets/images/ghs.png?v=${ASSET_VERSION}`}
        alt="公安备案图标"
        loading="lazy"
        decoding="async"
        width="16"
        height="16"
        class="inline-block h-4 w-4"
      />
      <span
        class="text-sm"
        th:text="${theme.config?.footer?.beian?.gongan_text}"></span>
    </a>
  </div>
  <div
    th:if="${theme.config?.footer?.displayLinks?.enable_theme_credit == null || theme.config?.footer?.displayLinks?.enable_theme_credit}"
    class="mt-2"
  >
    <span th:text="#{footer.poweredBy}">Powered by</span>{" "}
    <a
      class="link font-medium text-(--primary)"
      target="_blank"
      href="https://www.halo.run">Halo</a
    >{" "}&{" "}
    <a
      class="link font-medium text-(--primary)"
      target="_blank"
      href="https://github.com/AloneNanNan/halo-theme-ethereal">Ethereal</a
    >
  </div>
</footer>

<style is:global>
  /* ===== 页脚友情链接卡片墙（.hbf- 前缀，全部复用主题变量，深浅色自动适配） ===== */
  .hbf-root {
    display: block;
    width: 100%;
    min-width: 0;
    margin-top: 1.25rem;
    /* 与页脚内部行距（mt-2）一致，卡片墙融入页脚的行节奏 */
    margin-bottom: 0.5rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .hbf-root[hidden] {
    display: none;
  }

  /* ---- 「仅在首页显示」：由 body.is-home 单一控制 ----
     body.is-home 由服务端输出首帧初值（Astro isHomePage），运行期每个 Swup
     page:view 由 syncHomeClass 按路径重算（见 utils/banner-sync.ts），
     因此首帧与无刷新换页都准确。非首页时卡片墙整块不显示。 */
  body:not(.is-home) .hbf-root.hbf-home-only {
    display: none;
  }

  /* ---- 标题行 ---- */
  .hbf-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }
  .hbf-title {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--deep-text);
  }
  /* 标题图标：复用 --btn-regular-bg / --btn-content，与侧边栏社交按钮同款
     （同为淡色圆角方块 + 主题色图标），深色模式由 :root.dark 自动切换。 */
  .hbf-head-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.375rem;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    transition: background-color 0.2s ease;
  }
  .hbf-head-icon svg {
    display: block;
    width: 1rem;
    height: 1rem;
  }
  .hbf-apply {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    height: 1.375rem;
    padding: 0 0.5rem;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--primary) 14%, transparent);
    color: var(--primary);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .hbf-apply:hover {
    background: color-mix(in oklab, var(--primary) 24%, transparent);
  }
  .hbf-apply:active {
    transform: scale(0.96);
  }
  .hbf-apply svg {
    width: 0.6875rem;
    height: 0.6875rem;
  }
  .hbf-count {
    padding: 0.05rem 0.4rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 700;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
  }

  /* ---- 卡片列表 ---- */
  .hbf-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.875rem;
    width: 100%;
  }
  .hbf-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 14rem;
    height: 2rem;
    padding: 0 0.625rem;
    border: 1px solid color-mix(in oklab, var(--primary) 15%, transparent);
    border-radius: 0.625rem;
    background: var(--card-bg);
    color: var(--deep-text);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .hbf-item:hover {
    background: var(--btn-card-bg-hover);
    border-color: color-mix(in oklab, var(--primary) 40%, transparent);
    color: var(--primary);
  }
  /* 悬浮位移接入主题 card-hover-lift 开关（后台「样式开关」+ 访客面板），
     颜色/描边反馈保留恒定，不受该开关影响 */
  @media (min-width: 768px) {
    body.card-hover-lift-enabled .hbf-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 14px
        color-mix(in oklab, var(--primary) 18%, transparent);
    }
  }
  .hbf-logo,
  .hbf-logo-ph {
    flex: 0 0 auto;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 0.375rem;
    background: var(--btn-regular-bg);
  }
  .hbf-logo {
    display: block;
    object-fit: cover;
  }
  .hbf-logo-ph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
  }
  .hbf-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- 「更多」：被 max_items 截断时显示在卡片下方，跳转完整友链页 ---- */
  .hbf-more {
    margin-top: 0.75rem;
    text-align: center;
  }
  .hbf-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.5rem;
    height: 1.75rem;
    padding: 0;
    border: 1px dashed color-mix(in oklab, var(--primary) 32%, transparent);
    border-radius: 9999px;
    background: transparent;
    color: color-mix(in oklab, var(--primary) 80%, var(--deep-text));
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .hbf-more-btn:hover {
    background: color-mix(in oklab, var(--primary) 10%, transparent);
    border-color: color-mix(in oklab, var(--primary) 55%, transparent);
    color: var(--primary);
  }
  .hbf-more-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
  }
  .hbf-more-icon svg {
    width: 100%;
    height: 100%;
  }

  /* ---- 键盘焦点可见性：与主题其它交互元素一致（photos 页同款 outline） ---- */
  .hbf-item:focus-visible,
  .hbf-apply:focus-visible,
  .hbf-more-btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
