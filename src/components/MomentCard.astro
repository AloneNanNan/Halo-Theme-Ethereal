---
// 瞬间卡片：moments 列表（variant="list"，带「更多」）/ moment 详情（"detail"，带「返回」）共用。
// 外壳 card-base + card-hover-lift；勿挂 .btn-card-outline（主题色细描边条目卡语言，
// 会被「卡片边框与阴影」开关排除，表现为自己加了边框）。
//
// 约定（改动前必读）：
// - 依赖外层 Thymeleaf 变量 moment（两页同名）；根元素 th:with 出 content 供 MomentMedia 读取。
// - 缩进轨道：正文/媒体/操作栏统一 md:ml-[4.25rem]（头像 3.25rem + 间距 1rem），移动端归零。
// - 脚本钩子（样式见 components.css）：点赞 .moment-upvote-btn / .moment-upvote-count
//   （已投高亮 .is-upvoted，含禁用点击）；复制 .moment-copy-btn + data-copy-path
//   （moment-copy.js 绑定）；水印 .moment-card-watermark（右下角 bolt，参数可调）。
// - 正文 id="content" 只在详情页输出（TOC 扫描 #content；列表页重复 id 非法）。
import MomentMedia from "./MomentMedia.astro";

interface Props {
  /** list = 列表卡片（含「更多」入口）；detail = 详情页卡片（含「返回列表」） */
  variant?: "list" | "detail";
}

const { variant = "list" } = Astro.props;
const isDetail = variant === "detail";

// 作者名 / 评论数表达式：详情与列表两套标记共用，改这里即可
const nameTextExpr =
  "${moment.owner != null ? moment.owner.displayName : #messages.msg('page.moments.title')}";
const commentCountExpr =
  "${moment.stats != null ? moment.stats.approvedComment : 0}";
---

<article
  class="moment-card card-base card-hover-lift relative p-5 md:p-6"
  th:with="content=${moment.spec.content}"
>
  <!-- 头部：头像 + 作者 / 时间 / 标签。
       昵称 / 时间与头像两端对齐：信息列 min-h-[3.25rem] + justify-between
       （昵称行上沿对齐头像上沿、时间行下沿对齐头像下沿）。 -->
  <div class="flex items-start gap-4">
    <div class="shrink-0">
      <img
        alt=""
        loading="lazy"
        th:if="${moment.owner != null and not #strings.isEmpty(moment.owner.avatar)}"
        th:src="${moment.owner.avatar}"
        th:alt="${moment.owner.displayName}"
        class="h-13 w-13 rounded-xl bg-(--btn-regular-bg) object-cover"
      />
    </div>
    <div
      th:unless="${moment.owner != null and not #strings.isEmpty(moment.owner.avatar)}"
      aria-hidden="true"
      class="flex h-13 w-13 shrink-0 items-center justify-center rounded-xl bg-(--btn-regular-bg) text-(--primary)"
    >
      <span class="icon-[material-symbols--account-circle] text-3xl"></span>
    </div>
    <div class="flex min-h-[3.25rem] min-w-0 flex-1 flex-col justify-between">
      <div class="flex min-w-0 items-center gap-2">
        {
          isDetail ? (
            <h1
              class="truncate text-base font-bold text-(--primary)"
              th:text={nameTextExpr}
            >
              Moment
            </h1>
          ) : (
            <div
              class="truncate text-base font-bold text-(--primary)"
              th:text={nameTextExpr}
            >
              Ethereal
            </div>
          )
        }
        <!-- 复制链接：链环图标，默认隐藏、卡片 hover / 键盘聚焦渐现（.moment-copy-btn，
             见 components.css）；-my-2 抵消按钮高度，昵称行不被撑高 -->
        <button
          type="button"
          class="moment-copy-btn -my-2 ml-auto flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-50 transition hover:bg-(--btn-regular-bg) hover:text-(--primary) active:scale-95"
          th:title="#{common.copy}"
          th:aria-label="#{common.copy}"
          th:data-copy-path="@{/moments/{name}(name=${moment.metadata.name})}"
        >
          <span class="moment-copy-icon" aria-hidden="true">
            <svg
              class="h-[1.05rem] w-[1.05rem]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
              ></path>
              <path
                d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
              ></path>
            </svg>
          </span>
          <span class="moment-copy-check" aria-hidden="true">
            <svg
              class="h-[1.05rem] w-[1.05rem]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m20 6-11 11-5-5"></path>
            </svg>
          </span>
        </button>
      </div>
      <div class="mt-1.5 flex flex-wrap items-center gap-2">
        <time
          class="inline-flex items-center gap-1 text-sm text-50"
          th:datetime="${moment.spec.releaseTime}"
          th:title="${moment.spec.releaseTime != null ? #dates.format(moment.spec.releaseTime, 'yyyy-MM-dd HH:mm') : null}"
        >
          <span class="icon-[material-symbols--schedule-rounded] text-[0.95rem]"
          ></span>
          <span
            th:text="${moment.spec.releaseTime != null ? #dates.format(moment.spec.releaseTime, 'MM-dd HH:mm') : ''}"
            >09-21 14:30</span
          >
        </time>
        <span class="contents" th:if="${not #lists.isEmpty(moment.spec.tags)}">
          <a
            class="rounded-full bg-(--btn-regular-bg) px-2 py-0.5 text-xs font-semibold text-(--btn-content) transition hover:bg-(--btn-regular-bg-hover)"
            th:each="tagName : ${moment.spec.tags}"
            th:href="@{/moments(tag=${tagName})}"
            th:text="${'#' + tagName}">#Tag</a
          >
        </span>
      </div>
    </div>
  </div>

  <!-- 缩进轨道：正文 / 媒体 / 操作栏对齐作者名（移动端归零） -->
  <div class="mt-3.5 md:ml-[4.25rem]">
    <div
      th:if="${content != null and not #strings.isEmpty(content.html)}"
      id={isDetail ? "content" : undefined}
      class="moment-feed-content custom-md markdown-content prose prose-base max-w-none! text-75 dark:prose-invert!"
      th:utext="${content.html}"
    >
    </div>

    <MomentMedia />

    <footer class="mt-3.5 flex flex-wrap items-center gap-2 text-sm">
      <!-- 点赞：保留原脚本钩子（upvote.js 乐观更新 + 失败回滚 + .is-upvoted 高亮） -->
      <button
        type="button"
        class="moment-action moment-upvote-btn"
        th:aria-label="#{page.moments.upvote}"
        th:attr="data-moment=${moment.metadata.name}"
        th:data-count="${moment.stats != null ? moment.stats.upvote : 0}"
      >
        <span
          class="icon-[material-symbols--thumb-up-outline-rounded] text-base"
        ></span>
        <span
          class="moment-upvote-count"
          th:text="${moment.stats != null ? moment.stats.upvote : 0}">0</span
        >
      </button>

      <!-- 评论：详情页滚到本页 #comment；列表页跳详情页后定位。链接必须由 @{} 生成
           （勿手拼 '/moments/…'，子路径部署会跳错）再拼片段；th:href 会覆盖同元素的
           href，所以只在列表页给出——技巧是给 th: 属性传 undefined，Astro 会省略该
           属性，于是同一段标记能同时满足两种形态 -->
      <a
        class="moment-action"
        href="#comment"
        th:with={isDetail
          ? undefined
          : "momentUrl=@{/moments/{name}(name=${moment.metadata.name})}"}
        th:href={isDetail ? undefined : "${momentUrl + '#comment'}"}
      >
        <span
          class="icon-[material-symbols--chat-bubble-outline-rounded] text-base"
        ></span>
        <span th:text={commentCountExpr}>0</span>
      </a>

      {
        isDetail ? (
          <a class="moment-action" th:href="@{/moments}">
            <span class="icon-[material-symbols--chevron-left-rounded] text-base" />
            <span th:text="#{common.back}">返回</span>
          </a>
        ) : (
          <a
            class="moment-action"
            th:href="@{/moments/{name}(name=${moment.metadata.name})}"
          >
            <span th:text="#{common.more}">更多</span>
            <span class="icon-[material-symbols--chevron-right-rounded] text-base" />
          </a>
        )
      }
    </footer>
  </div>

  <!-- 右下角 bolt 水印：与页头水印同族，参数可调（components.css） -->
  <span
    class="moment-card-watermark icon-[material-symbols--bolt-outline-rounded]"
    aria-hidden="true"></span>
</article>
