---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<WidgetLayout
  id="announcement"
  name="公告"
  nameKey="widget.announcement.title"
  class={className}
>
  <div
    class="px-3"
    th:with="content = ${theme.config?.sidebar?.announcement?.content ?: '欢迎来到我的博客！这是一则示例公告。'}"
  >
    <!-- 内容：后台「内容支持 HTML」开启时按 HTML 渲染（th:utext），否则按纯文本转义渲染（th:text）；
         两属性同元素互斥，故用 th:if / th:unless 双份渲染，默认关闭（纯文本） -->
    <!-- 呈现为HTML 模式：内容区自适应内容高度（HTML 自身决定展示高度），
         仅以「内容最大高度(px)」作上限（默认 640），超出部分内部滚动；
         断词避免长 URL 横向溢出；纯文本模式维持原有不设限行为 -->
    <div
      th:if="${theme.config?.sidebar?.announcement?.enable_html == true}"
      class="mb-3 overflow-y-auto overflow-x-hidden break-words leading-relaxed text-neutral-600 dark:text-neutral-300"
      th:style="|max-height: ${theme.config?.sidebar?.announcement?.content_height ?: 640}px|"
      th:utext="${content}"
    >
    </div>
    <div
      th:unless="${theme.config?.sidebar?.announcement?.enable_html == true}"
      class="mb-3 leading-relaxed text-neutral-600 dark:text-neutral-300"
      th:text="${content}"
    >
      欢迎来到我的博客！这是一则示例公告。
    </div>

    <div class="flex items-center justify-between gap-3">
      <a
        th:if="${theme.config?.sidebar?.announcement?.link?.enable != false}"
        th:href="${theme.config?.sidebar?.announcement?.link?.url}"
        th:target="${theme.config?.sidebar?.announcement?.link?.external != false ? '_blank' : '_self'}"
        th:attr="rel=${theme.config?.sidebar?.announcement?.link?.external != false ? 'noopener noreferrer' : ''}"
        class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
        th:text="${theme.config?.sidebar?.announcement?.link?.text ?: '了解更多'}"
      >
      </a>

      <button
        th:if="${theme.config?.sidebar?.announcement?.closable != false}"
        type="button"
        class="announcement-close-btn btn-regular group rounded-lg h-8 w-8 text-sm transition-all active:scale-95"
        th:attr="aria-label=#{widget.announcement.closeLabel}"
        aria-label="关闭公告"
      >
        <span
          class="icon-[fa6-solid--xmark] text-sm transition-all duration-300 group-hover:rotate-90 group-hover:text-(--primary)"
        ></span>
      </button>
    </div>
  </div>
</WidgetLayout>

<script is:inline>
  (function () {
    // sessionStorage：当前标签页/会话内保持关闭，重新进入网站后恢复显示
    var KEY = "ethereal-announcement-closed-v1";

    function apply() {
      try {
        if (sessionStorage.getItem(KEY) === "1") {
          // 两栏/三栏布局下公告可能同时渲染两份（左侧兜底 + 右侧主显），
          // querySelector 只命中第一份（PC 上是被 xl:!hidden 隐藏的左侧），
          // 导致点击关闭后可见的那份不消失——必须隐藏全部实例。
          document
            .querySelectorAll('widget-layout[data-id="announcement"]')
            .forEach(function (el) {
              if (el.parentElement) el.parentElement.style.display = "none";
            });
        }
      } catch (e) {}
    }

    apply();

    // 脚本可能被 Swup 重复执行，全局标记保证只注册一次监听
    if (window.__annInit) return;
    window.__annInit = true;

    document.addEventListener("click", function (e) {
      if (!e.target.closest(".announcement-close-btn")) return;
      try {
        sessionStorage.setItem(KEY, "1");
      } catch (e) {}
      apply();
    });

    // 换页后重新应用：由 SwupScriptsPlugin 重执行本脚本时自动覆盖；
    // 原 swup:contentReplaced 监听删除（v3 事件名从未触发）。
  })();
</script>
