---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
}

const className = Astro.props.class;
---

<WidgetLayout
  name="一言"
  nameKey="widget.hitokoto.title"
  id="hitokoto"
  class={className}
>
  <style>
    .hitokoto-card {
      line-height: 1.6;
      max-width: 100%;
      box-sizing: border-box;
    }

    .hitokoto-main-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .hitokoto-text {
      flex: 1;
      min-width: 0;
      font-size: 14px;
      color: var(--deep-text);
      word-break: break-word;
      margin: 0;
      transition: opacity 0.3s ease;
    }

    .hitokoto-refresh {
      flex-shrink: 0;
      width: 26px;
      height: 26px;
      border: none;
      background: transparent;
      cursor: pointer;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--deep-text);
      opacity: 0.4;
      transition:
        color 0.2s,
        background 0.2s,
        opacity 0.2s;
      padding: 0;
      margin-top: 1px;
      font-size: 15px;
    }

    .hitokoto-refresh:hover {
      opacity: 0.7;
      background: rgba(128, 128, 128, 0.1);
    }

    .hitokoto-refresh:active {
      transform: scale(0.9);
    }

    .hitokoto-refresh .iconify-spin {
      transition: transform 0.4s ease;
    }

    .hitokoto-refresh.spinning .iconify-spin {
      transform: rotate(360deg);
    }

    .hitokoto-author-row {
      margin-top: 6px;
    }

    .hitokoto-author {
      font-size: 12px;
      color: var(--deep-text);
      opacity: 0.5;
      display: block;
      text-align: right;
    }

    .hitokoto-author::before {
      content: "—— ";
    }

    .hitokoto-loading .hitokoto-text {
      opacity: 0.5;
    }
  </style>

  <div
    class="hitokoto-card px-3"
    id="hitokotoCard"
    th:attr="data-api=${widget.api},
      data-fallback-text=${widget.fallback_text},
      data-fallback-source=${widget.fallback_source}"
  >
    <div class="hitokoto-main-row">
      <p
        class="hitokoto-text"
        id="hitokotoText"
        th:text="#{widget.hitokoto.loading}"
      >
        加载中...
      </p>
      <button
        class="hitokoto-refresh"
        id="hitokotoRefresh"
        title="换一句"
        aria-label="换一句"
        th:title="#{widget.hitokoto.refresh}"
        th:aria-label="#{widget.hitokoto.refresh}"
      >
        <span class="icon-[material-symbols--refresh-rounded] iconify-spin"
        ></span>
      </button>
    </div>
    <div class="hitokoto-author-row">
      <span class="hitokoto-author" id="hitokotoAuthor"></span>
    </div>
  </div>
</WidgetLayout>

<script is:inline>
  (function () {
    var hitokotoBound = false;

    function getCachedData(key) {
      try {
        var raw = sessionStorage.getItem(key);
        if (raw) return JSON.parse(raw);
      } catch (e) {}
      return null;
    }

    function setCachedData(key, data) {
      try {
        sessionStorage.setItem(key, JSON.stringify(data));
      } catch (e) {}
    }

    function initHitokoto() {
      var card = document.getElementById("hitokotoCard");
      if (!card) return;

      var textEl = document.getElementById("hitokotoText");
      var authorEl = document.getElementById("hitokotoAuthor");
      var refreshBtn = document.getElementById("hitokotoRefresh");

      // 读取后台配置：留空则使用内置默认
      var API = card.getAttribute("data-api") || "https://v1.hitokoto.cn/";
      var fallbackText =
        card.getAttribute("data-fallback-text") || "世界很大，开心第一。";
      var fallbackSource =
        card.getAttribute("data-fallback-source") || "楠南NanNan";

      // 缓存按 API 区分，避免更换 API 后读到旧缓存
      var CACHE_KEY = "hitokoto_cache_" + encodeURIComponent(API);

      function fetchHitokoto() {
        return fetch(API, { signal: AbortSignal.timeout(5000) })
          .then(function (resp) {
            if (!resp.ok) throw new Error("Network response was not ok.");
            var contentType = resp.headers.get("content-type") || "";
            // JSON 响应：兼容 hitokoto 标准字段与常见自定义字段
            if (contentType.indexOf("application/json") !== -1) {
              return resp.json().then(function (data) {
                return {
                  content:
                    data.hitokoto ||
                    data.content ||
                    data.sentence ||
                    data.text ||
                    "",
                  author:
                    data.from ||
                    data.author ||
                    data.source ||
                    data.from_who ||
                    "",
                };
              });
            }
            // 纯文本响应
            return resp.text().then(function (text) {
              return { content: text.trim(), author: "" };
            });
          })
          .catch(function (e) {
            console.warn("一言获取失败，使用默认句子", e.message);
            return {
              content: fallbackText,
              author: fallbackSource,
            };
          });
      }

      function updateCard(data) {
        textEl.textContent = data.content;
        authorEl.textContent = data.author || "";
        card.classList.remove("hitokoto-loading");
      }

      function refresh() {
        card.classList.add("hitokoto-loading");
        refreshBtn.classList.add("spinning");
        fetchHitokoto().then(function (data) {
          setCachedData(CACHE_KEY, data);
          updateCard(data);
          setTimeout(function () {
            refreshBtn.classList.remove("spinning");
          }, 400);
        });
      }

      // 只绑定一次 click 事件
      if (!hitokotoBound) {
        hitokotoBound = true;
        refreshBtn.addEventListener("click", refresh);
      }

      // 优先使用缓存数据，无缓存时才请求
      var cached = getCachedData(CACHE_KEY);
      if (cached) {
        updateCard(cached);
      } else {
        refresh();
      }
    }

    // 初始化
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initHitokoto);
    } else {
      initHitokoto();
    }

    // 换页后重新初始化：由 SwupScriptsPlugin 重执行本脚本时自动覆盖；
    // 原 swup:contentReplaced 监听删除（v3 事件名从未触发）。
  })();
</script>
