---
// 站点日历小组件：日/月/年三视图 + 年度热力图 + 当月/单日文章列表。
// 数据由 postFinder.listAll() 在渲染期写成 data-* 行，客户端一次性读入；体积代价见 AGENTS.md 6.3。
// 视图状态随侧栏常驻而跨页保留，勿加 swup 重初始化（脚本只跑一次）。
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
  style?: string;
}
const { class: className, style } = Astro.props;
---

<WidgetLayout
  name="站点日历"
  nameKey="widget.calendar.title"
  id="calendar"
  class={["relative", className].filter(Boolean).join(" ")}
  style={style}
>
  <!-- 数据源容器：th:each 放在内层 .contents（不产生盒子）逐篇复制，外层只有一份。
       ⚠️ 可见性必须用 visible?.name()，写成字符串比较会恒假、数据源整块为空（见 AGENTS.md 6.3） -->
  <div class="calendar-posts-src hidden">
    <div
      class="contents"
      th:each="post : ${postFinder.listAll()}"
      th:if="${post.spec.publish == true and post.spec.visible?.name() == 'PUBLIC' and post.status?.hideFromList != true and post.spec.publishTime != null}"
      th:attr="data-title=${post.spec.title}, data-permalink=${post.status.permalink}, data-date=${#dates.format(post.spec.publishTime, 'yyyy-MM-dd')}"
    ></div>
  </div>

  <!-- 回今天按钮放在卡片标题行右侧：留在日历头部会把居中的标题挤偏。
       初始 hidden 防闪，显隐由脚本按视图与月份切换 -->
  <button
    type="button"
    class="cal-reset btn-regular absolute right-2.5 top-4 h-7 w-7 rounded-md active:scale-90 will-change-transform hidden"
    th:aria-label="#{widget.calendar.backToToday}"
    aria-label="Back to today"
  >
    <span class="icon-[fa6-solid--arrow-rotate-left] text-[0.875rem] text-(--btn-content)"></span>
  </button>

  <div class="calendar-container">
    <!-- 导航行：上/下月 + 居中标题（点击逐层切换 日→月→年）。
         左右只剩等宽的翻页按钮，标题才可能真正居中 -->
    <div class="mb-2 flex items-center justify-between">
      <button
        type="button"
        class="btn-plain cal-prev h-9 w-9 flex items-center justify-center rounded-lg transition active:scale-95"
        th:aria-label="#{widget.calendar.prevMonth}"
        aria-label="Previous month"
      >
        <span class="icon-[material-symbols--keyboard-arrow-left] text-xl" />
      </button>
      <!-- 视图标题兼作「日→月→年」切换入口：用 button 换取键盘可达（div 无法聚焦） -->
      <button
        type="button"
        class="cal-month-display btn-plain rounded-lg px-3 py-1 text-lg font-bold text-neutral-900 transition select-none hover:text-(--primary) active:scale-95 dark:text-neutral-100"
      >
        <span th:text="#{widget.calendar.year}">Year</span>
      </button>
      <button
        type="button"
        class="btn-plain cal-next h-9 w-9 flex items-center justify-center rounded-lg transition active:scale-95"
        th:aria-label="#{widget.calendar.nextMonth}"
        aria-label="Next month"
      >
        <span class="icon-[material-symbols--keyboard-arrow-right] text-xl" />
      </button>
    </div>

    <!-- 日视图：星期表头 + 日历格子（客户端脚本填充） -->
    <div class="cal-view cal-view-day">
      <div class="cal-weekdays mb-2 grid grid-cols-7 gap-1"></div>
      <div class="cal-grid pb-1 grid grid-cols-7 gap-1"></div>
    </div>

    <!-- 年度文章热力图：12 月 × 4 周；格子/提示由脚本填充；showHeatmap 关闭时整块不渲染 -->
    <div
      class="cal-heatmap mb-2"
      th:if="${theme.config?.sidebar?.calendar?.showHeatmap != false}"
    >
      <div
        class="cal-heatmap-months mb-1 grid gap-0.5"
        style="grid-template-columns: repeat(12, 1fr);"
      ></div>
      <div
        class="cal-heatmap-grid grid"
        style="grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(4, 1fr); row-gap: 0.125rem;"
      ></div>
    </div>

    <!-- 月视图 / 年视图（客户端脚本填充） -->
    <div
      class="cal-view cal-view-month grid grid-cols-3 gap-2"
      style="display: none;"
    ></div>
    <div
      class="cal-view cal-view-year grid grid-cols-3 gap-2"
      style="display: none;"
    ></div>

    <!-- 当月/单日文章列表（客户端脚本填充；空月份时整块由脚本隐藏） -->
    <div class="cal-posts mt-3 hidden">
      <div class="cal-posts-divider mb-2 border-t border-neutral-200 dark:border-neutral-700"></div>
      <div class="cal-posts-list flex max-h-48 flex-col gap-1 overflow-y-auto custom-scrollbar"></div>
    </div>
  </div>
</WidgetLayout>

<script is:inline>
  (function () {
    // 实例作用域：脚本 is:inline、每实例各跑一份，重复配置（如左栏 + 右栏）时只操作本实例——
    // currentScript 取本实例所在条目容器再查元素，否则 querySelector 永远命中文档第一个实例
    var widgetRoot =
      (document.currentScript && document.currentScript.parentElement) ||
      document;
    var card = widgetRoot.querySelector('[data-id="calendar"]');
    if (!card) return;
    // Swup 换页会把新文档里的内联脚本重跑一遍，而侧栏不随换页重建：
    // 认到同一个卡片就退出，否则月份/视图状态会被重置回今天
    // （标记在初始化末尾才写，中途抛异常时下次重跑还能补一次）
    if (card.dataset.calReady === "true") return;

    var t =
      window.__etherealI18n ||
      function (_key, fb) {
        return fb;
      };
    var monthNames = [
      "january",
      "february",
      "march",
      "april",
      "may",
      "june",
      "july",
      "august",
      "september",
      "october",
      "november",
      "december",
    ].map(function (m, i) {
      return t(
        "widget.calendar." + m,
        [
          "January",
          "February",
          "March",
          "April",
          "May",
          "June",
          "July",
          "August",
          "September",
          "October",
          "November",
          "December",
        ][i],
      );
    });
    var weekDays = [
      "sunday",
      "monday",
      "tuesday",
      "wednesday",
      "thursday",
      "friday",
      "saturday",
    ].map(function (d, i) {
      return t(
        "widget.calendar." + d,
        ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"][i],
      );
    });
    var yearText = t("widget.calendar.year", "Year");
    var heatmapWeekTemplate = t(
      "widget.calendar.heatmapWeek",
      "Week {1} of {0}, {2} posts",
    );
    var emptyText = t("widget.calendar.empty", "No posts yet");
    // 只有 zh 语系用「YYYY年M月」，其余「Month YYYY」；判据取具体语系，不能用「非 en」
    var langTag = window.__etherealLangTag
      ? window.__etherealLangTag(document.documentElement.lang)
      : document.documentElement.lang;
    var isCJK = /^zh/i.test(langTag);

    var q = function (sel) {
      return card.querySelector(sel);
    };
    var qq = function (sel) {
      return card.querySelectorAll(sel);
    };

    // ---- 数据：读服务端内嵌的 data-* 行后即丢弃容器，不留几千个空节点 ----
    var posts = [];
    qq(".calendar-posts-src [data-date]").forEach(function (el) {
      posts.push({
        title: el.getAttribute("data-title") || "",
        permalink: el.getAttribute("data-permalink") || "",
        date: el.getAttribute("data-date") || "",
      });
    });
    var srcEl = q(".calendar-posts-src");
    if (srcEl) srcEl.remove();

    var postsByDate = {};
    var postsByMonth = {};
    var yearSet = {};
    posts.forEach(function (p) {
      if (!p.date) return;
      (postsByDate[p.date] = postsByDate[p.date] || []).push(p);
      (postsByMonth[p.date.slice(0, 7)] =
        postsByMonth[p.date.slice(0, 7)] || []).push(p);
      yearSet[p.date.slice(0, 4)] = true;
    });
    // 转成数字再排序：字符串键与 displayYear（数字）用 === 比较会恒假，年视图高亮会失效
    var availableYears = Object.keys(yearSet)
      .map(Number)
      .sort(function (a, b) {
        return b - a;
      });

    var now = new Date();
    var displayYear = now.getFullYear();
    var displayMonth = now.getMonth();
    var currentView = "day";
    var heatmapYear = null;

    var pad = function (n) {
      return String(n).padStart(2, "0");
    };
    var monthKey = function (year, month) {
      return year + "-" + pad(month + 1);
    };

    // 拼 HTML 前必须转义（同 PopularPosts）；原因与后果见 AGENTS.md 6.3
    var escapeHtml = function (str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    };
    // 链接只放行 http(s) 与站内路径（单个 / 开头），其余置空——含 //host 这类协议相对外链
    var toHref = function (href) {
      var isSitePath = href.charAt(0) === "/" && href.charAt(1) !== "/";
      return /^https?:\/\//i.test(href) || isSitePath ? escapeHtml(href) : "";
    };
    // 可点格子统一补键盘等价：div 不能聚焦，role + tabindex + Enter/Space 才有键盘可达性
    var activateOn = function (el, fn) {
      el.setAttribute("role", "button");
      el.setAttribute("tabindex", "0");
      el.addEventListener("click", fn);
      el.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          fn();
        }
      });
    };

    // ---- 热力图提示框：本实例专属（挂 card 上 absolute 定位，勿用 body 级 fixed——
    //      侧栏 hover 时 card 带 transform，fixed 会随包含块漂移；勿用全局 id 多实例抢占）----
    var tip = document.createElement("div");
    tip.className = "cal-tip";
    tip.setAttribute("aria-hidden", "true");
    card.appendChild(tip);

    // 先写文本再量尺寸：否则拿到的是上一次（首次为 0）的宽高，提示框位置会偏
    function showTip(text, cell) {
      tip.textContent = text;
      tip.style.opacity = "1";
      var cellRect = cell.getBoundingClientRect();
      var cardRect = card.getBoundingClientRect();
      var left =
        cellRect.left -
        cardRect.left +
        cellRect.width / 2 -
        tip.offsetWidth / 2;
      // 提示框夹在卡内不越界
      var maxLeft = cardRect.width - tip.offsetWidth - 8;
      left = Math.max(8, Math.min(left, maxLeft));
      var top = cellRect.top - cardRect.top - tip.offsetHeight - 6;
      tip.style.left = left + "px";
      tip.style.top = Math.max(4, top) + "px";
    }
    function hideTip() {
      tip.style.opacity = "0";
    }

    function renderHeatmap() {
      var wrap = q(".cal-heatmap");
      if (!wrap) return; // 后台关闭热力图时整块未渲染
      wrap.style.display = currentView === "day" ? "block" : "none";
      if (currentView !== "day") return;
      // 热力图只取决于年份：同年不重建。按下期间替换格子会让浏览器把 :active 套到新格子上，
      // 表现为一次点击内凹两次
      if (heatmapYear === displayYear) return;
      heatmapYear = displayYear;

      var monthsEl = q(".cal-heatmap-months");
      var gridEl = q(".cal-heatmap-grid");

      if (!monthsEl.hasChildNodes()) {
        monthsEl.innerHTML = Array.from({ length: 12 }, function (_, i) {
          return (
            '<span class="text-[10px] text-neutral-400 text-center dark:text-neutral-500">' +
            (i + 1) +
            "</span>"
          );
        }).join("");
      }

      // 按「年-月」预分桶：monthCount[month][week] = count（4 周 × 12 月，row-major）
      var monthCount = {};
      posts.forEach(function (p) {
        if (p.date.slice(0, 4) !== String(displayYear)) return;
        var m = parseInt(p.date.slice(5, 7), 10) - 1;
        var day = parseInt(p.date.slice(8, 10), 10);
        var week = Math.min(Math.floor((day - 1) / 7), 3);
        monthCount[m] = monthCount[m] || [0, 0, 0, 0];
        monthCount[m][week]++;
      });

      // 离散浓度档：低计数也保持可见（0/1/2/3/4+ 五档）。
      // 用 color-mix 而不是元素 opacity——opacity 会把 hover 的描边一起调淡，浅格子几乎没反馈
      var tintLevels = [0, 45, 65, 85, 100];
      var cells = "";
      for (var week = 0; week < 4; week++) {
        for (var month = 0; month < 12; month++) {
          var count = monthCount[month] ? monthCount[month][week] : 0;
          var level = Math.min(count, 4);
          var bg =
            count === 0
              ? "background-color: var(--btn-plain-bg-hover)"
              : "background-color: color-mix(in oklch, var(--primary) " +
                tintLevels[level] +
                "%, transparent)";
          var tooltip = heatmapWeekTemplate
            .replace("{0}", String(month + 1))
            .replace("{1}", String(week + 1))
            .replace("{2}", String(count));
          var safeTooltip = escapeHtml(tooltip);
          cells +=
            '<div class="cal-heat rounded-sm" style="' +
            bg +
            '" data-heat-month="' +
            month +
            '" data-heat-tip="' +
            safeTooltip +
            '" aria-label="' +
            safeTooltip +
            '"></div>';
        }
      }
      // 重建会连悬停中的格子一起移除，先收掉提示框，避免它悬在半空
      hideTip();
      gridEl.innerHTML = cells;

      qq(".cal-heat[data-heat-month]").forEach(function (cell) {
        activateOn(cell, function () {
          displayMonth = parseInt(cell.getAttribute("data-heat-month"), 10);
          currentView = "day";
          renderCalendar();
        });
        cell.addEventListener("mouseenter", function () {
          showTip(cell.getAttribute("data-heat-tip"), cell);
        });
        cell.addEventListener("mouseleave", hideTip);
      });
    }

    function renderCalendar() {
      // 时间取在渲染期而非脚本启动期：跨天后「今天」高亮与重置按钮显隐才会跟着走
      now = new Date();
      var dayView = q(".cal-view-day");
      var monthView = q(".cal-view-month");
      var yearView = q(".cal-view-year");

      // 星期表头只填充一次（内容与视图无关）
      var weekdaysEl = q(".cal-weekdays");
      if (weekdaysEl && !weekdaysEl.hasChildNodes()) {
        weekdaysEl.innerHTML = weekDays
          .map(function (d) {
            return (
              '<div class="text-center font-medium text-xs text-neutral-500 dark:text-neutral-400">' +
              d +
              "</div>"
            );
          })
          .join("");
      }

      if (dayView)
        dayView.style.display = currentView === "day" ? "block" : "none";
      if (monthView)
        monthView.style.display = currentView === "month" ? "grid" : "none";
      if (yearView)
        yearView.style.display = currentView === "year" ? "grid" : "none";

      updateHeader();

      if (currentView === "day") renderDayView();
      else if (currentView === "month") renderMonthView();
      else if (currentView === "year") renderYearView();

      renderHeatmap();
    }

    function updateHeader() {
      var navDisplay = q(".cal-month-display");
      var resetBtn = q(".cal-reset");
      var prevBtn = q(".cal-prev");
      var nextBtn = q(".cal-next");
      // 年份文案按语序拼接：中文「2026年」、英文「Year 2026」，勿直接相加
      var yearLabel = function (year) {
        return isCJK ? year + yearText : yearText + " " + year;
      };

      if (navDisplay) {
        if (currentView === "day") {
          navDisplay.textContent = isCJK
            ? displayYear + yearText + monthNames[displayMonth]
            : monthNames[displayMonth] + " " + displayYear;
        } else {
          navDisplay.textContent = yearLabel(displayYear);
        }
      }
      if (resetBtn) {
        var isCurrent =
          displayYear === now.getFullYear() && displayMonth === now.getMonth();
        // 用 hidden 类切换而不是写死 display 值：按钮的 display 由 btn-regular 提供
        resetBtn.classList.toggle("hidden", currentView === "day" && isCurrent);
      }
      // 年视图一次列全部年份，翻页按钮无意义，用 visibility 占位避免标题左右跳动
      if (prevBtn)
        prevBtn.style.visibility =
          currentView === "year" ? "hidden" : "visible";
      if (nextBtn)
        nextBtn.style.visibility =
          currentView === "year" ? "hidden" : "visible";
    }

    function renderDayView() {
      var firstDay = new Date(displayYear, displayMonth, 1).getDay();
      var daysInMonth = new Date(displayYear, displayMonth + 1, 0).getDate();
      var isCurrentMonth =
        displayYear === now.getFullYear() && displayMonth === now.getMonth();

      var grid = q(".cal-grid");
      if (!grid) return;
      // 格子会被整体重建，旧的选中引用随之失效，先清掉避免选中态错位
      selectedDayEl = null;

      var dayArr = [];
      for (var i = 0; i < firstDay; i++)
        dayArr.push({ day: null, dateKey: "" });
      for (var day = 1; day <= daysInMonth; day++) {
        var dateKey = monthKey(displayYear, displayMonth) + "-" + pad(day);
        var has = !!(postsByDate[dateKey] && postsByDate[dateKey].length);
        dayArr.push({ day: day, dateKey: dateKey, has: has });
      }
      var cells = dayArr
        .map(function (it) {
          if (!it.day)
            return '<div class="cal-day aspect-square flex items-center justify-center rounded-lg text-sm relative text-neutral-400 dark:text-neutral-600"></div>';
          var isToday = isCurrentMonth && it.day === now.getDate();
          // 只有带文章的日期可点，无文章日不挂手型光标，避免假可点提示
          var cls =
            "cal-day aspect-square flex items-center justify-center rounded-lg text-sm relative" +
            (it.has ? " cursor-pointer" : "");
          if (!it.has) cls += " text-neutral-700 dark:text-neutral-300";
          else cls += " text-neutral-900 dark:text-neutral-100 font-bold";
          if (isToday) cls += " ring-2 ring-(--primary)";
          // 小圆点离底边留 4px：贴边会压在选中高亮的圆角上
          var dot = it.has
            ? '<span class="absolute bottom-1 left-1/2 h-1 w-1 -translate-x-1/2 rounded-full bg-(--primary)" aria-hidden="true"></span>'
            : "";
          return (
            '<div class="' +
            cls +
            '" data-date="' +
            it.dateKey +
            '" data-has-post="' +
            it.has +
            '"' +
            // 只有可点（有文章）的日期才是切换按钮；无文章日挂 aria-pressed 属于无意义 ARIA
            (it.has ? ' aria-pressed="false"' : "") +
            (isToday ? ' aria-current="date"' : "") +
            ">" +
            it.day +
            dot +
            "</div>"
          );
        })
        .join("");
      grid.innerHTML = cells;

      showMonthlyPosts();
      setupDayClicks();
    }

    // 统一按日期升序：服务端 listAll() 的默认排序不属于本组件的契约
    function byDate(a, b) {
      return a.date < b.date ? -1 : a.date > b.date ? 1 : 0;
    }

    function monthPosts() {
      var key = monthKey(displayYear, displayMonth);
      return (postsByMonth[key] || []).slice().sort(byDate);
    }

    function showMonthlyPosts(dayKey) {
      var postsWrap = q(".cal-posts");
      var postsList = q(".cal-posts-list");
      var list = dayKey
        ? (postsByDate[dayKey] || []).slice().sort(byDate)
        : monthPosts();

      // 分隔线是 .cal-posts 的子元素，父级隐藏时无需单独处理
      if (postsWrap)
        postsWrap.style.display = list.length > 0 ? "block" : "none";
      if (!postsList) return;
      postsList.innerHTML = list
        .map(function (p) {
          var ds = p.date.slice(5); // MM-DD
          return (
            '<a href="' +
            toHref(p.permalink) +
            '" class="flex justify-between items-center rounded-lg px-3 py-1.5 text-sm text-neutral-700 transition-all hover:bg-(--btn-plain-bg-hover) hover:pl-4 hover:text-(--primary) dark:text-neutral-300 dark:hover:text-(--primary)">' +
            '<span class="truncate">' +
            escapeHtml(p.title) +
            "</span>" +
            '<span class="ml-2 text-xs text-neutral-500 whitespace-nowrap dark:text-neutral-400">' +
            ds +
            "</span></a>"
          );
        })
        .join("");
    }

    var selectedDayEl = null;
    function setupDayClicks() {
      qq(".cal-day[data-date]").forEach(function (el) {
        if (el.getAttribute("data-has-post") !== "true") return;
        activateOn(el, function () {
          var dateKey = el.getAttribute("data-date");
          if (!dateKey) return;
          if (selectedDayEl === el) {
            // 再次点击取消选中，恢复当月全量
            el.classList.remove("cal-day-selected");
            el.setAttribute("aria-pressed", "false");
            selectedDayEl = null;
            showMonthlyPosts();
            return;
          }
          if (selectedDayEl) {
            selectedDayEl.classList.remove("cal-day-selected");
            selectedDayEl.setAttribute("aria-pressed", "false");
          }
          selectedDayEl = el;
          el.classList.add("cal-day-selected");
          el.setAttribute("aria-pressed", "true");
          showMonthlyPosts(dateKey);
        });
      });
    }

    function renderMonthView() {
      var container = q(".cal-view-month");
      if (!container) return;
      var monthsWithPosts = {};
      posts.forEach(function (p) {
        if (p.date.slice(0, 4) === String(displayYear))
          monthsWithPosts[parseInt(p.date.slice(5, 7), 10) - 1] = true;
      });
      container.innerHTML = monthNames
        .map(function (name, index) {
          var isCurrent = index === displayMonth;
          var has = !!monthsWithPosts[index];
          var cls =
            "p-2 text-center text-sm rounded-lg cursor-pointer transition relative hover:bg-(--btn-plain-bg-hover) active:scale-95";
          cls += isCurrent
            ? " font-bold text-(--primary) bg-(--btn-plain-bg-hover)"
            : " text-neutral-700 dark:text-neutral-300";
          var dot = has
            ? '<span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-(--primary)"></span>'
            : "";
          return (
            '<div class="' +
            cls +
            '" data-month="' +
            index +
            '">' +
            name +
            dot +
            "</div>"
          );
        })
        .join("");
      container.querySelectorAll("[data-month]").forEach(function (el) {
        activateOn(el, function () {
          displayMonth = parseInt(el.getAttribute("data-month"), 10);
          currentView = "day";
          renderCalendar();
        });
      });
    }

    function renderYearView() {
      var container = q(".cal-view-year");
      if (!container) return;
      if (availableYears.length === 0) {
        container.innerHTML =
          '<div class="col-span-3 text-center text-sm text-neutral-500 dark:text-neutral-400">' +
          emptyText +
          "</div>";
        return;
      }
      container.innerHTML = availableYears
        .map(function (year) {
          var isCurrent = year === displayYear;
          var cls =
            "p-2 text-center text-sm rounded-lg cursor-pointer transition relative hover:bg-(--btn-plain-bg-hover) active:scale-95";
          cls += isCurrent
            ? " font-bold text-(--primary) bg-(--btn-plain-bg-hover)"
            : " text-neutral-700 dark:text-neutral-300";
          return (
            '<div class="' +
            cls +
            '" data-year="' +
            year +
            '">' +
            year +
            "</div>"
          );
        })
        .join("");
      container.querySelectorAll("[data-year]").forEach(function (el) {
        activateOn(el, function () {
          displayYear = parseInt(el.getAttribute("data-year"), 10);
          currentView = "month";
          renderCalendar();
        });
      });
    }

    function changeMonth(delta) {
      // 年视图无翻页语义（按钮已隐藏），键盘或脚本触发时同样忽略
      if (currentView === "year") return;
      if (currentView === "day") {
        displayMonth += delta;
        if (displayMonth > 11) {
          displayMonth = 0;
          displayYear++;
        } else if (displayMonth < 0) {
          displayMonth = 11;
          displayYear--;
        }
      } else if (currentView === "month") {
        displayYear += delta;
      }
      renderCalendar();
    }

    function resetToToday() {
      displayYear = now.getFullYear();
      displayMonth = now.getMonth();
      currentView = "day";
      selectedDayEl = null;
      renderCalendar();
    }

    var prevBtn = q(".cal-prev");
    var nextBtn = q(".cal-next");
    var resetBtn = q(".cal-reset");
    var navDisplay = q(".cal-month-display");
    if (prevBtn)
      prevBtn.addEventListener("click", function () {
        changeMonth(-1);
      });
    if (nextBtn)
      nextBtn.addEventListener("click", function () {
        changeMonth(1);
      });
    if (resetBtn) resetBtn.addEventListener("click", resetToToday);
    if (navDisplay)
      navDisplay.addEventListener("click", function () {
        if (currentView === "day") currentView = "month";
        else if (currentView === "month") currentView = "year";
        renderCalendar();
      });

    renderCalendar();
    // 初始化成功后才落标记：中途抛异常时，换页重跑还能再试一次
    card.dataset.calReady = "true";
  })();
</script>

<style is:global>
  /* 类名统一 .cal- 前缀：本块 is:global，无前缀的通用名会污染全站选择器命名空间
     （插件自带前台页也可能使用同名类） */
  .cal-day {
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
    min-height: 32px;
  }
  /* 悬停上浮 + 底色，按下内凹；圆角由格子的 rounded-lg 提供 */
  .cal-day[data-has-post="true"]:hover {
    transform: translateY(-2px);
    background-color: var(--btn-plain-bg-hover);
  }
  .cal-day[data-has-post="true"]:active {
    transform: scale(0.92);
    background-color: var(--btn-plain-bg-active);
  }
  /* 选中态不随悬停上浮：已选中的格子再跳一下会显得脏 */
  .cal-day-selected,
  .cal-day-selected:hover {
    background-color: var(--btn-regular-bg);
    transform: none;
  }
  .cal-heat {
    cursor: pointer;
    min-width: 0;
    width: 85%;
    aspect-ratio: 1;
    margin: auto;
    transition:
      box-shadow 0.15s ease,
      transform 0.12s ease;
  }
  .cal-heat:hover {
    box-shadow: 0 0 1px 1.5px var(--primary, oklch(0.55 0.15 250));
  }
  /* 按下内凹与其它按钮一致；格子底色走内联 style，故这里只缩不换底色 */
  .cal-heat:active {
    transform: scale(0.9);
  }
  /* 键盘可达性的可见焦点（格子由脚本补 role/tabindex，见 activateOn） */
  .cal-day:focus-visible,
  .cal-heat:focus-visible,
  .cal-view-month > [role="button"]:focus-visible,
  .cal-view-year > [role="button"]:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }
  /* 热力图提示框：绝对定位于本实例卡片内（见脚本注释，勿改回 body 级 fixed） */
  .cal-tip {
    position: absolute;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    line-height: 1.2;
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 30;
    white-space: nowrap;
  }
</style>
