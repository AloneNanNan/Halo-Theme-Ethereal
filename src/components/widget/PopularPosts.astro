---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
  style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;
const MAX_POSTS = 5;
---

<div class="contents">
  <WidgetLayout
    name="热门文章"
    nameKey="widget.popularPosts.title"
    id="popular-posts"
    class={className}
    style={style}
  >
    <div id="popular-posts-list" class="flex flex-col gap-1">
      <div
        class="flex items-center justify-center py-4 text-sm text-neutral-400"
      >
        <span
          class="icon-[material-symbols--hourglass-top] mr-2 animate-spin text-base"
        ></span>
        <span th:text="#{widget.popularPosts.loading}">加载中...</span>
      </div>
    </div>
  </WidgetLayout>
</div>

<script is:inline define:vars={{ MAX_POSTS }}>
  (function () {
    var container = document.getElementById("popular-posts-list");
    if (!container) return;

    // 客户端 i18n：复用 Layout.astro 注入的全局助手（缺失时退化为回退文案）
    var t =
      window.__etherealI18n ||
      function (key, fb) {
        return fb;
      };

    // 读取主题配置获取 base path
    var themeConfig = document.getElementById("theme-config");
    var basePath = "";
    if (themeConfig) {
      try {
        var cfg = JSON.parse(themeConfig.textContent || "{}");
        basePath = cfg.base || "";
      } catch (e) {}
    }

    function formatCount(num) {
      if (num >= 10000) {
        return window.__etherealBigNum(
          num,
          "widget.popularPosts.tenThousand",
          "k",
        );
      }
      if (num >= 1000) return (num / 1000).toFixed(1) + "k";
      return String(num);
    }

    function renderList(posts) {
      if (!posts.length) {
        container.innerHTML =
          '<div class="py-4 text-center text-sm text-neutral-400">' +
          t("widget.popularPosts.empty", "暂无文章") +
          "</div>";
        return;
      }

      var html = "";
      function escapeHtml(str) {
        return str
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      for (var i = 0; i < posts.length; i++) {
        var post = posts[i];
        var title =
          post.spec.title || t("widget.popularPosts.noTitle", "无标题");
        var safeTitle = escapeHtml(title);
        var visits = (post.stats && post.stats.visit) || 0;
        var permalink = (post.status && post.status.permalink) || "";
        var href =
          permalink ||
          basePath + "/archives/" + (post.spec.slug || post.metadata.name);
        // V7：href 与标题同样转义（slug/permalink 含引号可属性逃逸）；
        // 非 http(s) 且非站内路径的链接置空兜底（与服务端协议白名单同面）
        var safeHref =
          /^https?:\/\//i.test(href) || href.charAt(0) === "/"
            ? escapeHtml(href)
            : "";

        html +=
          '<a href="' +
          safeHref +
          '" class="group block" aria-label="' +
          safeTitle +
          '">' +
          '<div class="flex items-center gap-2.5 rounded-lg px-3 py-2 transition-all group-hover:bg-(--btn-plain-bg-hover) group-hover:pl-4 group-active:bg-(--btn-plain-bg-active)">' +
          '<span class="ml-1 flex h-6 min-w-7 shrink-0 items-center justify-center rounded-lg px-1.5 text-xs font-bold ' +
          (i < 3
            ? "bg-(--primary) text-white"
            : "bg-(--btn-regular-bg) text-(--btn-content)") +
          '">' +
          (i + 1) +
          "</span>" +
          '<div class="min-w-0 flex-1">' +
          '<span class="block overflow-hidden overflow-ellipsis whitespace-nowrap text-sm text-neutral-700 transition group-hover:text-(--primary) dark:text-neutral-300 dark:group-hover:text-(--primary)">' +
          safeTitle +
          "</span>" +
          "</div>" +
          '<span class="shrink-0 text-xs text-neutral-400 dark:text-neutral-500">' +
          '<span class="icon-[material-symbols--visibility-outline] mr-0.5 align-[-2px] text-sm"></span>' +
          formatCount(visits) +
          "</span>" +
          "</div>" +
          "</a>";
      }
      container.innerHTML = html;
    }

    // 热门榜逻辑：改用 Halo content API 服务端排序（sort=stats.visit,desc），
    // 单请求取 Top N，消除原实现的「探 total → size=total 全量拉取」两步）。
    // sessionStorage 缓存最终 Top N：同会话内切换页面不再重复请求列表接口。
    var CACHE_KEY = "popular_posts_v1";

    function getCached() {
      try {
        var raw = sessionStorage.getItem(CACHE_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }

    function setCached(posts) {
      try {
        sessionStorage.setItem(CACHE_KEY, JSON.stringify(posts));
      } catch (e) {}
    }

    // 统一的列表请求：失败时渲染空列表并返回 null（由后续 .then 兜底跳过）
    function fetchPosts(url, signal) {
      return fetch(url, { signal: signal }).then(function (res) {
        if (!res.ok) {
          console.warn("[PopularPosts] API error:", res.status);
          renderList([]);
          return null;
        }
        return res.json();
      });
    }

    function loadPopularPosts() {
      var cached = getCached();
      if (cached) {
        renderList(cached);
        return;
      }

      // AbortController：Swup 导航会重新执行本脚本，先中止上一次未完成的请求，避免旧响应覆盖新页面
      if (window.__popularPostsAbort) {
        window.__popularPostsAbort.abort();
      }
      var controller = new AbortController();
      window.__popularPostsAbort = controller;
      var signal = controller.signal;

      // 服务端排序取 Top N（sort=stats.visit,desc；客户端不再排序——
      // 只取回 N 条样本，客户端兜底排序对缺失的样本无效）
      fetchPosts(
        "/apis/api.content.halo.run/v1alpha1/posts?page=0&size=" +
          MAX_POSTS +
          "&sort=stats.visit,desc",
        signal,
      )
        .then(function (data) {
          if (!data) return;
          var items = data.items || [];
          var published = items.filter(function (p) {
            return p.spec && p.spec.publish && p.spec.visible === "PUBLIC";
          });
          var top = published.slice(0, MAX_POSTS);
          setCached(top);
          renderList(top);
        })
        .catch(function (e) {
          // 主动 abort 不算错误，静默忽略（新一次的请求会接管渲染）
          if (e.name === "AbortError") return;
          console.warn("[PopularPosts] Fetch failed:", e);
          renderList([]);
        });
    }

    loadPopularPosts();
  })();
</script>
