---
/**
 * 小组件分派片段（Thymeleaf 片段库）：全套 th:switch 只定义这一份，侧栏用
 * <div th:replace="~{::widgetSwitch(${widget})}"></div> 引用——勿在引用处内联第二份
 * （会撑大每页模板体积，见 AGENTS.md 5.3）。
 * ⚠️ 两个硬约束：外层 th:if="false" 负责「定义处不渲染」，不能写进片段根元素（副本会连
 * 条件一起复制、渲染为空）；片段根元素自带 class="contents"（th:replace 是整体替换，
 * 不保留引用点属性）。
 */
import Announcement from "./Announcement.astro";
import Categories from "./Categories.astro";
import Hitokoto from "./Hitokoto.astro";
import MusicPlayer from "./MusicPlayer.astro";
import PopularPosts from "./PopularPosts.astro";
import Profile from "./Profile.astro";
import Schedule from "./Schedule.astro";
import SiteStats from "./SiteStats.astro";
import Tags from "./Tags.astro";
import Weather from "./Weather.astro";
---

<div th:if="false">
  <div
    class="contents"
    th:fragment="widgetSwitch(widget)"
    th:switch="${widget.value}"
  >
    <div class="contents" th:case="'profile'">
      <Profile />
    </div>
    <div class="contents" th:case="'announcement'">
      <Announcement class="onload-animation" />
    </div>
    <div class="contents" th:case="'categories'">
      <Categories class="onload-animation" />
    </div>
    <div class="contents" th:case="'tag'">
      <Tags class="onload-animation" />
    </div>
    <div class="contents" th:case="'music'">
      <MusicPlayer class="onload-animation" />
    </div>
    <div class="contents" th:case="'hitokoto'">
      <Hitokoto class="onload-animation" />
    </div>
    <div class="contents" th:case="'site-stats'">
      <SiteStats class="onload-animation" />
    </div>
    <div class="contents" th:case="'weather'">
      <Weather class="onload-animation" />
    </div>
    <div class="contents" th:case="'popular-posts'">
      <PopularPosts class="onload-animation" />
    </div>
    <div class="contents" th:case="'schedule'">
      <Schedule class="onload-animation" />
    </div>
    <div
      th:case="'html'"
      class="card-base onload-animation p-4"
      th:utext="${widget.html}"
    >
    </div>
  </div>
</div>
