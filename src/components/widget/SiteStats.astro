---
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
  class?: string;
  style?: string;
}

const className = Astro.props.class;
const style = Astro.props.style;
---

<div
  class="contents"
  th:with="posts = ${postFinder.list({page: 1, size: 1})}, categories = ${categoryFinder.listAll()}, tags = ${tagFinder.listAll()}, serverTotalWords = ${pluginFinder.available('extra-api', '3.*') ? extraApiStatsFinder.getPostWordCount() : null}"
>
  <WidgetLayout
    name="站点统计"
    nameKey="widget.siteStats.title"
    id="site-stats"
    class={className}
    style={style}
  >
    <div class="flex flex-col gap-1">
      <!-- 文章数 -->
      <a
        th:href="@{/archives}"
        class="group flex items-center justify-between rounded-lg px-3 py-2 transition-all hover:bg-(--btn-plain-bg-hover) hover:pl-4 active:bg-(--btn-plain-bg-active)"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="icon-[material-symbols--library-books-outline-rounded] text-xl text-(--primary)"
          ></span>
          <span
            class="text-sm font-medium text-neutral-700 dark:text-neutral-300"
            th:text="#{widget.siteStats.posts}">文章</span
          >
        </div>
        <span
          class="text-base font-bold text-neutral-900 dark:text-neutral-100"
          th:text="${posts.total}">0</span
        >
      </a>

      <!-- 分类数 -->
      <a
        th:href="@{/categories}"
        class="group flex items-center justify-between rounded-lg px-3 py-2 transition-all hover:bg-(--btn-plain-bg-hover) hover:pl-4 active:bg-(--btn-plain-bg-active)"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="icon-[material-symbols--book-2-outline-rounded] text-xl text-(--primary)"
          ></span>
          <span
            class="text-sm font-medium text-neutral-700 dark:text-neutral-300"
            th:text="#{widget.siteStats.categories}">分类</span
          >
        </div>
        <span
          class="text-base font-bold text-neutral-900 dark:text-neutral-100"
          th:text="${#lists.size(categories)}">0</span
        >
      </a>

      <!-- 标签数 -->
      <a
        th:href="@{/tags}"
        class="group flex items-center justify-between rounded-lg px-3 py-2 transition-all hover:bg-(--btn-plain-bg-hover) hover:pl-4 active:bg-(--btn-plain-bg-active)"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="icon-[material-symbols--tag-rounded] text-xl text-(--primary)"
          ></span>
          <span
            class="text-sm font-medium text-neutral-700 dark:text-neutral-300"
            th:text="#{widget.siteStats.tags}">标签</span
          >
        </div>
        <span
          class="text-base font-bold text-neutral-900 dark:text-neutral-100"
          th:text="${#lists.size(tags)}">0</span
        >
      </a>

      <!-- 总字数（客户端计算） -->
      <div
        class="group flex items-center justify-between rounded-lg px-3 py-2 transition-all hover:bg-(--btn-plain-bg-hover) hover:pl-4 active:bg-(--btn-plain-bg-active)"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="icon-[material-symbols--draw-outline-rounded] text-xl text-(--primary)"
          ></span>
          <span
            class="text-sm font-medium text-neutral-700 dark:text-neutral-300"
            th:text="#{widget.siteStats.totalWords}">总字数</span
          >
        </div>
        <!-- data-server-words：API 拓展包插件（app-di1jh8gd;extra-api ≥3.x）已安装时，
             服务端在此注入全站总字数，客户端直接展示、不再逐篇抓正文 -->
        <span
          id="site-stats-total-words"
          th:attr="data-server-words=${serverTotalWords != null ? serverTotalWords : ''}"
          class="text-base font-bold text-neutral-900 dark:text-neutral-100"
          >--</span
        >
      </div>

      <!-- 最后活动（客户端计算) -->
      <div
        class="group flex items-center justify-between rounded-lg px-3 py-2 transition-all hover:bg-(--btn-plain-bg-hover) hover:pl-4 active:bg-(--btn-plain-bg-active)"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="icon-[material-symbols--history-rounded] text-xl text-(--primary)"
          ></span>
          <span
            class="text-sm font-medium text-neutral-700 dark:text-neutral-300"
            th:text="#{widget.siteStats.lastActivity}">最后活动</span
          >
        </div>
        <span
          id="site-stats-last-activity"
          class="text-base font-bold text-neutral-900 dark:text-neutral-100"
          >--</span
        >
      </div>

      <!-- 运行天数 -->
      <div
        id="site-stats-running-days-row"
        class="group flex items-center justify-between rounded-lg px-3 py-2 transition-all hover:bg-(--btn-plain-bg-hover) hover:pl-4 active:bg-(--btn-plain-bg-active)"
        th:if="${widget.site_start_date != null and widget.site_start_date != ''}"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="icon-[material-symbols--calendar-clock-outline-rounded] text-xl text-(--primary)"
          ></span>
          <span
            class="text-sm font-medium text-neutral-700 dark:text-neutral-300"
            th:text="#{widget.siteStats.runningDays}">运行天数</span
          >
        </div>
        <div class="flex items-center">
          <span
            id="site-stats-running-days"
            class="text-base font-bold text-neutral-900 dark:text-neutral-100"
            th:attr="data-start-date=${widget.site_start_date}">--</span
          >
          <span
            class="ml-1 text-sm text-neutral-500 dark:text-neutral-400"
            th:text="#{widget.siteStats.days}">天</span
          >
        </div>
      </div>
    </div>
  </WidgetLayout>
</div>

<script is:inline th:inline="none">
  (function () {
    // 客户端 i18n：复用 Layout.astro 注入的全局助手（缺失时退化为回退文案）
    var t =
      window.__etherealI18n ||
      function (key, fb) {
        return fb;
      };

    // 站点统计工具函数
    function formatNumber(num) {
      if (num >= 10000) {
        return window.__etherealBigNum(
          num,
          "widget.siteStats.tenThousand",
          "k",
        );
      }
      return num.toLocaleString();
    }

    // 统计口径与 API 拓展包插件（extra-api 的 PostWordCountUtil）对齐
    function countWords(text) {
      if (!text) return 0;
      var cleaned = text
        .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
        .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
        .replace(/&[a-zA-Z0-9#]+;/g, "")
        .replace(/\s+/g, " ")
        .trim();
      var chinese = cleaned.match(/[\u4e00-\u9fa5]/g) || [];
      var english = cleaned.match(/[a-zA-Z0-9]+/g) || [];
      return chinese.length + english.length;
    }

    function formatRelativeDate(dateStr) {
      if (!dateStr) return "--";
      var date = new Date(dateStr);
      if (isNaN(date.getTime())) return "--";
      var now = new Date();
      var diffMs = now.getTime() - date.getTime();
      var diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      if (diffDays === 0) return t("widget.siteStats.today", "今天");
      if (diffDays === 1) return t("widget.siteStats.yesterday", "昨天");
      if (diffDays < 30)
        return format(t("widget.siteStats.daysAgo", "{0} 天前"), diffDays);
      if (diffDays < 365)
        return format(
          t("widget.siteStats.monthsAgo", "{0} 个月前"),
          Math.floor(diffDays / 30),
        );
      return format(
        t("widget.siteStats.yearsAgo", "{0} 年前"),
        Math.floor(diffDays / 365),
      );
    }

    // 简单占位符替换 {0}，与 i18n 参数格式一致
    function format(msg) {
      var args = Array.prototype.slice.call(arguments, 1);
      return String(msg).replace(/\{(\d+)\}/g, function (m, i) {
        return args[+i] != null ? args[+i] : m;
      });
    }

    // 缓存已计算的统计数据
    if (!window.__siteStatsCache) {
      window.__siteStatsCache = null;
    }

    // localStorage 持久化缓存（24小时有效期，避免每次刷新都发 N+1 请求）
    var STORAGE_KEY = "site_stats_v2";
    var STATS_CACHE_TTL = 24 * 60 * 60 * 1000;

    function getCachedStats() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        var d = JSON.parse(raw);
        if (Date.now() - d.t > STATS_CACHE_TTL) {
          localStorage.removeItem(STORAGE_KEY);
          return null;
        }
        return d.stats;
      } catch (e) {
        return null;
      }
    }

    function setCachedStats(stats) {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ stats: stats, t: Date.now() }),
        );
      } catch (e) {}
    }

    function applyStatsToDOM(stats) {
      var wordsEl = document.getElementById("site-stats-total-words");
      var activityEl = document.getElementById("site-stats-last-activity");
      // 插件已提供 data-server-words 时，服务端值优先（精确、零请求），仅做格式化
      if (wordsEl && wordsEl.getAttribute("data-server-words")) {
        wordsEl.textContent = formatNumber(
          parseInt(wordsEl.getAttribute("data-server-words"), 10) || 0,
        );
      } else if (wordsEl && stats.totalWords !== null) {
        wordsEl.textContent = formatNumber(stats.totalWords);
      }
      if (activityEl && stats.lastActivity) {
        activityEl.textContent = stats.lastActivity;
      }
    }

    function updateSiteStats() {
      // 插件（API 拓展包 extra-api ≥3.x）已安装时，服务端在 data-server-words
      // 注入全站总字数，客户端无需再逐篇抓正文，只需统计最后活动
      var wordsEl0 = document.getElementById("site-stats-total-words");
      var serverHasWords = !!(
        wordsEl0 && wordsEl0.getAttribute("data-server-words")
      );

      // 缓存可用性判断：totalWords 为 null 说明缓存生成时依赖插件服务端值；
      // 若当前已无插件（无 data-server-words），该缓存不可用，须重新客户端统计
      function cacheUsable(stats) {
        return !(!serverHasWords && stats.totalWords === null);
      }

      if (window.__siteStatsCache) {
        if (cacheUsable(window.__siteStatsCache)) {
          applyStatsToDOM(window.__siteStatsCache);
          return;
        }
        window.__siteStatsCache = null;
      }

      // 优先读取 localStorage 缓存，避免重复抓取
      var stored = getCachedStats();
      if (stored) {
        if (cacheUsable(stored)) {
          window.__siteStatsCache = stored;
          applyStatsToDOM(stored);
          return;
        }
        // 缓存依赖插件但插件已卸载：作废缓存，重新客户端统计
        try {
          localStorage.removeItem(STORAGE_KEY);
        } catch (e) {}
      }

      var allPosts = [];
      var page = 0;
      var size = 50;

      function fetchPage() {
        fetch(
          "/apis/api.content.halo.run/v1alpha1/posts?page=" +
            page +
            "&size=" +
            size +
            "&sort=metadata.creationTimestamp,desc",
        )
          .then(function (res) {
            if (!res.ok) {
              console.warn("[SiteStats] List API error:", res.status);
              processPosts(allPosts);
              return;
            }
            return res.json();
          })
          .then(function (data) {
            if (!data) return;
            var items = data.items || [];
            allPosts = allPosts.concat(items);
            if (!data.last && page < 10) {
              page++;
              fetchPage();
            } else {
              processPosts(allPosts);
            }
          })
          .catch(function (e) {
            console.warn("[SiteStats] Fetch failed:", e);
            processPosts(allPosts);
          });
      }

      function processPosts(posts) {
        if (posts.length === 0) return;

        var latestDate = null;
        var totalWords = 0;
        var pending = posts.length;
        var CONCURRENCY = 6;
        var queue = posts.slice();
        var running = 0;

        function finish() {
          var formattedActivity = latestDate
            ? formatRelativeDate(latestDate)
            : "--";

          window.__siteStatsCache = {
            // 服务端已提供字数时（serverHasWords），不缓存 0，卸载插件后可自然回退到客户端统计
            totalWords: serverHasWords ? null : totalWords,
            lastActivity: formattedActivity,
          };
          setCachedStats(window.__siteStatsCache);
          applyStatsToDOM(window.__siteStatsCache);
        }

        function next() {
          while (running < CONCURRENCY && queue.length > 0) {
            running++;
            var post = queue.shift();

            var pub =
              (post.spec && post.spec.publishTime) ||
              (post.metadata && post.metadata.creationTimestamp);
            if (pub && (!latestDate || pub > latestDate)) {
              latestDate = pub;
            }

            // 插件已提供服务端总字数：跳过逐篇抓取正文，仅需最后活动
            if (serverHasWords) {
              running--;
              pending--;
              if (pending === 0) finish();
              else next();
              continue;
            }

            var name = post.metadata && post.metadata.name;
            if (!name) {
              running--;
              pending--;
              if (pending === 0) finish();
              else next();
              continue;
            }

            (function (postName) {
              fetch("/apis/api.content.halo.run/v1alpha1/posts/" + postName)
                .then(function (res) {
                  if (!res.ok) throw new Error("HTTP " + res.status);
                  return res.json();
                })
                .then(function (data) {
                  // 优先取 Markdown 原文统计：countWords 已与插件口径对齐
                  // （含代码块与数字），且完全不受主题 DOM 结构（如 template 包裹）影响
                  var text = (data.content && data.content.raw) || "";
                  if (!text) {
                    // 兜底：取渲染后的 HTML，剥离标签后再统计
                    var html = (data.content && data.content.content) || "";
                    text = html.replace(/<[^>]*>/g, " ");
                  }
                  // 清理 Markdown 中残留的行内 HTML 标签
                  text = text.replace(/<[^>]*>/g, " ");
                  totalWords += countWords(text);
                  running--;
                  pending--;
                  if (pending === 0) finish();
                  else next();
                })
                .catch(function (e) {
                  console.warn(
                    "[SiteStats] 文章字数获取失败:",
                    postName,
                    e.message || e,
                  );
                  running--;
                  pending--;
                  if (pending === 0) finish();
                  else next();
                });
            })(name);
          }
        }

        next();
      }

      fetchPage();
    }

    function updateRunningDays() {
      var el = document.getElementById("site-stats-running-days");
      if (!el) return;
      var startDate = el.getAttribute("data-start-date");
      if (!startDate) return;
      var now = new Date();
      var start = new Date(startDate);
      if (isNaN(start.getTime())) return;
      var diffMs = Math.abs(now.getTime() - start.getTime());
      var days = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
      el.textContent = String(days);
    }

    function refreshSiteStats() {
      // 检查元素是否存在（可能在 swup 容器外或内）
      var wordsEl = document.getElementById("site-stats-total-words");
      var activityEl = document.getElementById("site-stats-last-activity");
      if (wordsEl || activityEl) {
        updateSiteStats();
        updateRunningDays();
      }
    }

    // 初始加载
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", refreshSiteStats);
    } else {
      refreshSiteStats();
    }

    // swup 页面切换后：SwupScriptsPlugin 在每次换页时重执行本脚本，
    // 直接调用 refreshSiteStats 完成数据刷新（原 swup:contentReplaced
    // 监听删除——v3 事件名，v4 分发 swup:{hook}，从未触发）。
    refreshSiteStats();
  })();
</script>
