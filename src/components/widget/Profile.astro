---
import ImageWrapper from "../misc/ImageWrapper.astro";
import { imageSuffixThWith } from "../../utils/image-suffix";
---

<div class="card-base p-3">
  <a
    aria-label="Profile"
    th:href="${theme.config?.sidebar?.profile?.url ?: '/about'}"
    th:with={imageSuffixThWith("p?.avatar_size ?: 512")}
    class="group relative mx-auto mb-3 mt-1 block max-w-[12rem] overflow-hidden rounded-xl active:scale-95 lg:mx-0 lg:mt-0 lg:max-w-none"
  >
    <div
      class="pointer-events-none absolute z-50 flex h-full w-full items-center justify-center transition group-hover:bg-black/30 group-active:bg-black/50"
    >
      <span
        class="icon-[fa6-regular--address-card] scale-90 text-5xl text-white opacity-0 transition group-hover:scale-100 group-hover:opacity-100"
      ></span>
    </div>
    <ImageWrapper
      src="${(theme.config?.sidebar?.profile?.avatar ?: '/themes/Ethereal/assets/images/demo-avatar.png') + suffix}"
      alt="${theme.config?.sidebar?.profile?.name ?: 'Profile'}"
      class="mx-auto aspect-square h-full lg:mt-0 lg:w-full"
    />
  </a>

  <div class="px-2">
    <div class="mb-1 text-center">
      <span style="position: relative; display: inline-block;">
        <span
          class="text-xl font-bold text-black/90 transition dark:text-neutral-50"
          th:text="${theme.config?.sidebar?.profile?.name ?: 'NanNan'}"
        >
          NanNan
        </span>
        <!-- 在线状态图标（昵称右侧，不参与居中布局）：点击切换由 profile-status.ts 处理。
             注意：th:text 会替换元素内部全部子元素，因此本徽标必须与昵称 span 平级，
             不能作为带 th:text 元素的子节点，否则会被运行时覆盖掉 -->
        <button
          th:if="${theme.config?.sidebar?.profile?.statusSettings?.enable != false}"
          id="profile-status-badge"
          type="button"
          class="flex size-5 cursor-pointer items-center justify-center text-lg transition hover:scale-110 active:scale-95"
          style="position: absolute; right: -28px; top: 50%; transform: translateY(-50%);"
          aria-label="切换当前状态"
          th:aria-label="#{profile.switchStatus}"
          th:attr="data-status=${theme.config?.sidebar?.profile?.statusSettings?.status ?: 'online'}"
          th:switch="${theme.config?.sidebar?.profile?.statusSettings?.status ?: 'online'}"
        >
          <span
            th:case="energetic"
            class="icon-[mingcute--sun-fill] text-amber-500 status-spin"></span>
          <span
            th:case="emo"
            class="icon-[mingcute--sad-fill] text-violet-400 status-float"
          ></span>
          <span
            th:case="study"
            class="icon-[mingcute--book-2-fill] text-sky-500 status-drift"
          ></span>
          <span
            th:case="busy"
            class="icon-[mingcute--fire-fill] text-orange-500 status-wiggle"
          ></span>
          <span
            th:case="dnd"
            class="icon-[mingcute--moon-fill] text-indigo-400 status-float"
          ></span>
          <span
            th:case="sleep"
            class="icon-[mingcute--moon-stars-fill] text-blue-500 status-pulse"
          ></span>
          <span
            th:case="away"
            class="icon-[mingcute--cloud-fill] text-neutral-400 status-drift"
          ></span>
          <!-- 在线：叶子图标（默认） -->
          <span
            th:case="*"
            class="icon-[mingcute--leaf-fill] text-green-500 status-pulse"
          ></span>
        </button>
      </span>
    </div>
    <div class="mx-auto mb-2 h-1 w-5 rounded-full bg-(--primary) transition">
    </div>
    <div
      class="mb-2.5 text-center text-neutral-400 transition"
      th:text="${theme.config?.sidebar?.profile?.bio ?: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.'}"
    >
      Lorem ipsum dolor sit amet, consectetur adipiscing elit.
    </div>

    <div class="mb-1 flex flex-wrap justify-center gap-2">
      <a
        th:each="social : ${theme.config?.sidebar?.profile?.social_media ?: {}}"
        th:href="${social.url}"
        th:title="${social.name ?: social.text}"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-regular size-10 rounded-lg active:scale-90"
        th:utext="${social.social_icon.value}"
      >
      </a>
    </div>
  </div>
</div>
