---
import TOC from "./TOC.astro";

/**
 * 侧边栏目录卡片：左右两栏共用（勿复制第二份）。
 *
 * 高度契约：卡片高度跟内容走，撑到吸顶块限高后由内层 #toc-inner-wrapper-sidebar
 * 滚动；吸顶块被限高时卡片是唯一参与伸缩的项（吸顶组件有 flex-shrink: 0）。
 * ⚠️ 卡片与内层滚动区都必须 flex-auto，不能改成 flex-1（basis 为 0 的项既不缩也
 * 不长：前者会让限高变化全砸到吸顶组件，后者会让卡片只剩标题高、被 min-h 钉死）。
 * min-h 6rem（≈标题 + 1 个条目）只为极端情况兜底；无目录时 Layout.astro 用
 * :has([data-toc-empty]:not(.hidden)) 撤掉保底、收回内容高度。
 *
 * 显示门控（文章页 / 主题开启目录 / 目录在本栏）由调用方 th:if 负责
 * （SideBar.astro / RightSideBar.astro 的槽位；详见 Layout.astro 侧栏段落）。
 */
---

<div class="card-base hidden md:flex min-h-[6rem] flex-auto flex-col overflow-hidden pb-0">
  <div
    class="relative mb-2 ml-8 mt-4 shrink-0 text-lg font-bold text-neutral-900 transition before:absolute before:left-[-16px] before:top-1/2 before:h-4 before:w-1 before:-translate-y-1/2 before:rounded-md before:bg-(--primary) dark:text-neutral-100"
    th:text="#{widget.toc.title}"
  >
    目录
  </div>
  {/* data-toc-scroll：TOC 组件靠 closest("[data-toc-scroll]") 找滚动容器（不认 id），
      故卡片换到任意一栏都成立；Layout.astro 的侧栏限高规则也用它做 :has() 判定，
      改名会同时打断两处 */}
  <div
    id="toc-inner-wrapper-sidebar"
    data-toc-scroll
    class="hide-scrollbar min-h-0 flex-auto overflow-x-hidden overflow-y-auto pb-4"
  >
    <TOC />
  </div>
</div>
