---
interface Props {
  class?: string;
  /** 无目录时是否显示"此文章无目录"占位（三栏目录小组件默认显示；二栏悬浮目录关闭） */
  showEmptyMessage?: boolean;
}

const { showEmptyMessage = true } = Astro.props;
const className = Astro.props.class ?? "";
---

<!-- z-0：使 table-of-contents 成为堆叠上下文，把高亮条（[data-toc-indicator]）
     的 -z-10 约束在本组件内（画在卡片之上、条目之下）；否则 -z-10 会透到根上下文，
     被不透明白卡片背景盖住，非透明模式下高亮/虚线完全看不见 --><!-- 内部两个钩子（高亮条 / 空目录占位）刻意用 data-* 而非 id：本组件在页面里有
     多个实例（侧栏卡片、两栏悬浮目录、移动端弹窗），id 会重复——JS 的
     getElementById / querySelector("#…") 只命中第一个实例，CSS 的 #… 却全部命中，
     这种"界面看着正常、某一份的脚本改错元素"的隐性坑极难排查 -->
<table-of-contents
  class:list={[className, "group relative z-0 block"]}
  th:attr="data-max-depth=${theme.config?.post != null and theme.config?.post?.toc?.toc_depth != null ? theme.config?.post?.toc?.toc_depth : 2}"
  th:data-empty-text="#{common.notoc}"
>
  <div
    data-toc-indicator
    class="-z-10 absolute left-0 right-0 rounded-xl border-2 border-dashed border-transparent bg-(--primary)/10 transition-all duration-(--toc-transition-duration) group-hover:border-(--primary) group-hover:bg-transparent"
    style="opacity: 0"
  >
  </div>
  {
    showEmptyMessage && (
      <div
        data-toc-empty
        class="hidden px-2 py-4 text-center text-sm text-50"
      />
    )
  }
</table-of-contents>

<!-- 自定义元素注册与实现在 src/scripts/app.ts（见那里的说明）：不能留在组件里——
     Astro 对组件脚本全页只输出一次且落在第一个实例处，侧栏实例被 th:if 按 position
     配置移除时注册脚本会一并丢失，另一栏的目录会整体空白 -->
