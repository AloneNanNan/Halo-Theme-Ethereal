---
// 移动端菜单栏：按后台配置（布局设置 → 菜单栏设置 → 菜单样式）渲染两种模式。
//  - accordion（默认）：从导航栏下方展开的下拉面板，子菜单手风琴折叠（原版样式）
//  - drawer：从右侧滑出的圆角卡片抽屉，子菜单平铺展示（新样式）
// 数据源一致：均读取 Halo 菜单（theme.config?.layout?.mobileMenu?.menu 或主菜单）。
// 两种模式的开关逻辑见 public/assets/navbar.js（以 #nav-menu-root 是否
// 存在判定模式）。
import SiteLogo from "../SiteLogo.astro";
---

<!-- 抽屉模式（layout.mobileMenu.style = drawer） -->
<div
  th:if="${theme.config?.layout?.mobileMenu?.style == 'drawer'}"
  id="nav-menu-root"
  th:aria-label="#{nav.navMenu}"
>
  <div id="nav-menu-overlay" aria-hidden="true"></div>
  <div
    id="nav-menu-panel"
    th:with="menu = ${not #strings.isEmpty(theme.config?.layout?.mobileMenu?.menu) ? menuFinder.getByName(theme.config?.layout?.mobileMenu?.menu) : menuFinder.getPrimary()}"
    class="nav-drawer"
    role="dialog"
    aria-modal="true"
    th:aria-label="#{nav.navMenu}"
  >
    <!-- 头部：站点标题 + 关闭按钮 -->
    <div class="nav-drawer-header flex items-center justify-between px-3 py-2">
      <a
        th:href="@{/}"
        class="btn-plain scale-animation h-10 rounded-lg px-3 font-bold active:scale-95"
      >
        <div class="flex flex-row items-center text-md text-(--primary)">
          <SiteLogo iconClass="text-[1.5rem]" />
        </div>
      </a>
      <button
        type="button"
        th:aria-label="#{nav.closeMenu}"
        aria-label="Close Menu"
        id="nav-menu-close"
        class="btn-plain scale-animation group h-10 w-10 rounded-lg active:scale-90"
      >
        <span
          class="icon-[material-symbols--close-rounded] text-[1.25rem] transition-all duration-300 group-hover:rotate-90 group-hover:text-(--primary)"
        ></span>
      </button>
    </div>

    <!-- 菜单内容：一级菜单为一组，组间分割线分隔；组内平铺（一级自身 + 子项）。
         一级链接恒渲染；子项用 th:each（无子项时为空集合不渲染，天然平铺） -->
    <div class="nav-drawer-body px-2 pb-4">
      <div class="contents" th:if="${menu != null}">
        <div
          th:each="menuItem, itemStat : ${menu.menuItems}"
          th:with="menuIcon = ${#annotations.get(menuItem, 'icon')}"
        >
          <!-- 组间分割线（除第一组外） -->
          <div
            th:unless="${itemStat.index == 0}"
            class="nav-drawer-divider my-2 border-t border-black/10 dark:border-white/10"
          >
          </div>
          <a
            th:href="@{${menuItem.status.href}}"
            th:target="${menuItem.spec.target?.value}"
            class="nav-drawer-link"
            data-nav-link
          >
            <span class="flex min-w-0 items-center gap-2">
              <span
                th:if="${not #strings.isEmpty(menuIcon)}"
                class="nav-menu-icon shrink-0"
              >
                <img
                  th:if="${#strings.startsWith(menuIcon, 'data:') or #strings.startsWith(menuIcon, 'http')}"
                  th:src="${menuIcon}"
                  alt=""
                />
                <span
                  th:if="${#strings.startsWith(menuIcon, '<svg')}"
                  th:utext="${menuIcon}"></span>
              </span>
              <span class="truncate" th:text="${menuItem.status.displayName}"
                >Menu</span
              >
            </span>
            <span
              th:if="${menuItem.spec.target?.value == '_blank'}"
              class="icon-[fa6-solid--arrow-up-right-from-square] flex-shrink-0 text-[0.9rem] text-black/50 dark:text-white/50"
            ></span>
          </a>
          <a
            th:each="childItem : ${menuItem.children}"
            th:with="childIcon = ${#annotations.get(childItem, 'icon')}"
            th:href="@{${childItem.status.href}}"
            th:target="${childItem.spec.target?.value}"
            class="nav-drawer-link"
            data-nav-link
          >
            <span class="flex min-w-0 items-center gap-2">
              <span
                th:if="${not #strings.isEmpty(childIcon)}"
                class="nav-menu-icon shrink-0"
              >
                <img
                  th:if="${#strings.startsWith(childIcon, 'data:') or #strings.startsWith(childIcon, 'http')}"
                  th:src="${childIcon}"
                  alt=""
                />
                <span
                  th:if="${#strings.startsWith(childIcon, '<svg')}"
                  th:utext="${childIcon}"></span>
              </span>
              <span class="truncate" th:text="${childItem.status.displayName}"
                >子菜单</span
              >
            </span>
            <span
              th:if="${childItem.spec.target?.value == '_blank'}"
              class="icon-[fa6-solid--arrow-up-right-from-square] flex-shrink-0 text-[0.9rem] text-black/50 dark:text-white/50"
            ></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 手风琴模式（默认，layout.mobileMenu.style = accordion 或未配置） -->
<div
  th:unless="${theme.config?.layout?.mobileMenu?.style == 'drawer'}"
  id="nav-menu-panel"
  th:with="menu = ${not #strings.isEmpty(theme.config?.layout?.mobileMenu?.menu) ? menuFinder.getByName(theme.config?.layout?.mobileMenu?.menu) : menuFinder.getPrimary()}"
  class="float-panel float-panel-closed fixed right-4 px-2 py-2 w-40"
>
  <div class="contents" th:if="${menu != null}">
    <div
      th:each="menuItem, itemStat : ${menu.menuItems}"
      th:with="menuIcon = ${#annotations.get(menuItem, 'icon')}"
    >
      <div class="flex items-center">
        <a
          th:href="@{${menuItem.status.href}}"
          th:target="${menuItem.spec.target?.value}"
          class="group flex-1 flex items-center justify-between gap-3 rounded-lg py-2 pl-3 pr-1 transition hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active)"
        >
          <span class="flex min-w-0 items-center gap-2">
            <span
              th:if="${not #strings.isEmpty(menuIcon)}"
              class="nav-menu-icon shrink-0"
            >
              <img
                th:if="${#strings.startsWith(menuIcon, 'data:') or #strings.startsWith(menuIcon, 'http')}"
                th:src="${menuIcon}"
                alt=""
              />
              <span
                th:if="${#strings.startsWith(menuIcon, '<svg')}"
                th:utext="${menuIcon}"></span>
            </span>
            <span
              class="font-bold text-black/75 transition group-hover:text-(--primary) group-active:text-(--primary) dark:text-white/75 truncate"
              th:text="${menuItem.status.displayName}">Menu</span
            >
          </span>
          <span
            th:if="${menuItem.spec.target?.value == '_blank'}"
            class="icon-[fa6-solid--arrow-up-right-from-square] text-[0.9rem] text-black/50 dark:text-white/50 flex-shrink-0"
          ></span>
        </a>
        <!-- 子菜单展开按钮：由本文件脚本的面板级事件委托处理，data-submenu-id 供委托定位 -->
        <button
          th:if="${menuItem.children != null && !menuItem.children.isEmpty()}"
          type="button"
          th:data-submenu-id="|submenu-${itemStat.index}|"
          th:aria-label="${menuItem.status.displayName}"
          aria-expanded="false"
          class="px-2 py-2 submenu-toggle flex-shrink-0"
        >
          <span
            class="icon-[material-symbols--chevron-right-rounded] text-[1.3rem] text-black/20 transition-transform duration-200 dark:text-white/20 inline-block"
          ></span>
        </button>
      </div>
      <!-- 子菜单内容 -->
      <div
        th:if="${menuItem.children != null && !menuItem.children.isEmpty()}"
        th:id="'submenu-' + ${itemStat.index}"
        class="hidden pl-4"
      >
        <a
          th:each="childItem : ${menuItem.children}"
          th:with="childIcon = ${#annotations.get(childItem, 'icon')}"
          th:href="@{${childItem.status.href}}"
          th:target="${childItem.spec.target?.value}"
          class="group flex items-center justify-between gap-3 rounded-lg py-2 pl-3 pr-1 transition hover:bg-(--btn-plain-bg-hover) active:bg-(--btn-plain-bg-active)"
        >
          <span class="flex min-w-0 items-center gap-2">
            <span
              th:if="${not #strings.isEmpty(childIcon)}"
              class="nav-menu-icon shrink-0"
            >
              <img
                th:if="${#strings.startsWith(childIcon, 'data:') or #strings.startsWith(childIcon, 'http')}"
                th:src="${childIcon}"
                alt=""
              />
              <span
                th:if="${#strings.startsWith(childIcon, '<svg')}"
                th:utext="${childIcon}"></span>
            </span>
            <span
              class="font-bold text-black/75 transition group-hover:text-(--primary) group-active:text-(--primary) dark:text-white/75 truncate"
              th:text="${childItem.status.displayName}">子菜单</span
            >
          </span>
          <span
            th:if="${childItem.spec.target?.value == '_blank'}"
            class="icon-[fa6-solid--arrow-up-right-from-square] text-[0.9rem] text-black/50 dark:text-white/50 flex-shrink-0"
          ></span>
        </a>
      </div>
    </div>
  </div>
</div>
